# Every check runs under production rules, so a suite proves each limit
# whatever ENVIRONMENT .env.local sets. Loaded after .env.local, so it wins.
ENVIRONMENT=production

# A check never pays a vendor. check:reel's films reached Google Veo for real
# through the scene fix (11 October 2026; stopped only by Veo's empty balance),
# and the Agent on camera trial in .env.local changes what its checks expect.
GEMINI_API_KEY=
AGENT_LIKE_STORY=off
