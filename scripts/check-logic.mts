check("and Friday", week[1]?.toISOString(), "2026-03-06T04:30:00.000Z");

// Half open on the left, because the caller's `from` is the last slot it
// already handled. A closed interval would hand that slot back forever, the
// unique index would refuse the row, and the runner would silently do nothing.
check("a slot exactly at `from` is not handed back",
  slotsBetween(twiceAWeek, {
    from: new Date("2026-03-03T04:30:00.000Z"),
    to: new Date("2026-03-06T00:00:00.000Z"),
  }).length, 0);
check("but the one at `to` is",
  slotsBetween(twiceAWeek, {
    from: new Date("2026-03-01T00:00:00.000Z"),
    to: new Date("2026-03-03T04:30:00.000Z"),
  }).length, 1);

check("a backwards window is no window",
  slotsBetween(twiceAWeek, {
    from: new Date("2026-03-08T00:00:00.000Z"),
    to: new Date("2026-03-01T00:00:00.000Z"),
  }), []);
check("no days is no slots",
  slotsBetween({ ...twiceAWeek, daysOfWeek: [] }, {
    from: new Date("2026-03-01T00:00:00.000Z"),
    to: new Date("2026-04-01T00:00:00.000Z"),
  }), []);

check("a start date holds it back",
  slotsBetween({ ...twiceAWeek, startsOn: "2026-03-05" }, {
    from: new Date("2026-03-01T00:00:00.000Z"),
    to: new Date("2026-03-08T00:00:00.000Z"),
  }).length, 1);
check("and an end date stops it",
  slotsBetween({ ...twiceAWeek, endsOn: "2026-03-04" }, {
    from: new Date("2026-03-01T00:00:00.000Z"),
    to: new Date("2026-03-08T00:00:00.000Z"),
  }).length, 1);

// A late slot sits in the previous UTC day, so walking UTC dates alone loses
// it at the window's edges.
check("a slot near midnight IST is not lost at the edge",
  slotsBetween({ daysOfWeek: [0, 1, 2, 3, 4, 5, 6], atMinute: 1425, startsOn: null, endsOn: null }, {
    from: new Date("2026-03-03T00:00:00.000Z"),
    to: new Date("2026-03-04T00:00:00.000Z"),
  }).map((d) => d.toISOString()), ["2026-03-03T18:15:00.000Z"]);

// The bound is a bound rather than a preference: without it, a caller passing
