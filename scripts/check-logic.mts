  const site = c.backgroundsFrom(lib, ["CONSTRUCTION"]);
  check("a construction template may use site photos",
    site.map((p: { category: string }) => p.category).includes("CONSTRUCTION"), true);
  check("and its cover opens on a construction photo",
    c.picturesFor(site, 1, 0, ["CONSTRUCTION"])[0].category, "CONSTRUCTION");
  check("templatePhotos names no construction while the construction templates are off",
    [t.templatePhotos("10-construction-update", "IMAGE"), t.templatePhotos("07-construction-timeline", "CAROUSEL"), t.templatePhotos("01-launch-announcement", "IMAGE")],
    [null, null, null]);
  check("sceneOf tells site photos apart from finished exteriors",
