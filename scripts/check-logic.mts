  check("and is an end state inside the site's own hours, never a script", [/inside the site's visiting hours/.test(R.goalText({ key: "site_visit", day: null })), R.isScript(R.goalText({ key: "site_visit", day: "2026-10-02" }))], [true, false]);
  const ok = [
