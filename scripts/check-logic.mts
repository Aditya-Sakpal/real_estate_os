    lang: "Marathi", temp: "WARM" as const, party: 2, decider: true, visitNo: 1, source: "Meta ad", cp: null,
    bookedVia: "WhatsApp", bookedOn: "2026-09-21", host: "Asha Menon" as string | null,
    status: "confirmed" as import("../src/lib/visit-rules.ts").VisitStatus, toShow: [] as string[],
  };
  const nowMin = V.toMin("12:40");

  check("a weekend gallery staffs up", [V.hostsOnDuty("2026-09-26", true), V.hostsOnDuty("2026-09-24", true)], [5, 3]);
  check("a day's capacity is hosts times the hours", V.dayCapacity([{ big: true }, { big: false }], "2026-09-24"), 45);
  check("an arrival reads as minutes ahead", V.arrivalLabel("13:05", nowMin), "in 25 min");
  check("and as minutes late", V.arrivalLabel("12:28", nowMin), "12 min late");
  check("a blocked visit names why",
    V.needsYou({ ...base, status: "blocked", blocked: "cp_tag" }, "2026-09-24", nowMin), "Two partners claim this buyer");
  check("an upcoming visit with no host needs one",
    V.needsYou({ ...base, host: null, time: "13:30" }, "2026-09-24", nowMin), "No host assigned");
  check("but not one next week",
