  const booked = [{ id: "Q", kind: "QUALIFIED" as const, bookingId: null }, { id: "V", kind: "VISIT_DONE" as const, bookingId: null }, { id: "B", kind: "BOOKED" as const, bookingId: null }];
  const cancel = A.outcomesForMove({ from: "booked", to: "negotiation", toPath: "negotiation", cancelsBooking: true }, booked);
