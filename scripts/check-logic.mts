// A story reel: a montage cut from short shots under one narrator and one
// track. What it may say, how long each shot runs, which part of a clip is
// usable, and whether a reviewed reel may go out.
console.log("\nStory reels");
{
  const r = await import("../src/lib/reel-rules.ts");
  const shot = (o: Record<string, unknown>) => ({ kind: "people", narration: "", caption: "", scene: "A couple at a cafe", action: "she smiles", picture: null, card: null, seconds: 3, ...o });
  const good = {
    title: "Pehla ghar", mood: "warm", voice: "female", cast: "A couple in their thirties", cta: "Book a site visit",
    shots: [
      shot({ narration: "हर शाम एक सपना", caption: "Har shaam ek sapna" }),
      shot({ kind: "property", picture: 0, scene: "slow push-in" }),
      shot({ kind: "property", picture: 1, scene: "slow pan" }),
      shot({ kind: "people", scene: "The couple in a car", action: "he laughs" }),
      shot({ kind: "property", picture: 2, scene: "slight rise", narration: "18th floor से समुद्र", caption: "18th floor se samundar" }),
      shot({ kind: "card", card: "2 BHK from Rs 2,18,24,000" }),
      shot({ scene: "The couple on a walk", action: "they hold hands" }),
    ],
  };
  const parsed = r.parseScript(good, 3);
  check("a sound script parses, with shot ids in order", [parsed.problems, parsed.script?.shots.map((s: { id: string }) => s.id)],
    [[], ["s1", "s2", "s3", "s4", "s5", "s6", "s7"]]);
  check("a property shot must name an approved picture",
    r.parseScript({ ...good, shots: good.shots.map((s, i) => (i === 1 ? { ...s, picture: 7 } : s)) }, 3).problems.some((p: string) => p.includes("no approved picture")), true);
  check("too few shots is sent back", r.parseScript({ ...good, shots: good.shots.slice(0, 3) }, 3).problems.length > 0, true);
  const facts = ["Sea facing from the 18th floor up", "2 BHK from Rs 2,18,24,000"];
  check("numbers from the facts are allowed, however the commas fall", r.scriptProblems(parsed.script!, facts, []), []);
  const withPrice = { ...parsed.script!, shots: parsed.script!.shots.map((s: { id: string }, i: number) => (i === 0 ? { ...s, caption: "Sirf Rs 45 lakh" } : s)) };
  check("a number nobody signed is refused", r.scriptProblems(withPrice, facts, []).some((p: string) => p.includes("number")), true);
  check("so is one written in Devanagari digits", r.scriptProblems({ ...parsed.script!, shots: [{ ...parsed.script!.shots[0], narration: "सिर्फ़ ४५ लाख" }] }, facts, []).length > 0, true);
  const towerPeople = { ...parsed.script!, shots: [{ ...parsed.script!.shots[0], scene: "The couple stands in front of the new tower" }] };
  check("a people shot may not draw the building", r.scriptProblems(towerPeople, facts, []).some((p: string) => p.includes("shows the property")), true);
  check("a never-say phrase is refused", r.scriptProblems({ ...parsed.script!, cta: "Guaranteed returns" }, facts, ["guaranteed returns"]).length > 0, true);

  check("a shot runs as long as its narration and a breath", r.shotSeconds([shot({})], [2.1]), [2.55]);
  check("no shot runs under two seconds, a card under two and a half, or any over seven",
    r.shotSeconds([shot({ seconds: 1 }), shot({ kind: "card", seconds: 1 }), shot({})], [null, null, 9]), [2.2, 2.5, 7]);
  check("clips are asked for with room to cut, from three to fifteen seconds",
    [r.clipSeconds(3.2), r.clipSeconds(0.5), r.clipSeconds(14)], [6, 3, 15]);

  // A pulse every half second is 120 beats a minute.
  const env = Array.from({ length: 1000 }, (_, i) => (i % 50 === 7 ? 1 : 0.05));
  const grid = r.beatGrid(env, 100);
  check("the tempo of a steady pulse is found", Math.abs(grid.bpm - 120) <= 2, true);
  check("and its beats land on the pulses", grid.beats.slice(0, 3), [0.07, 0.57, 1.07]);
  check("a cut near a beat moves onto it", r.snapCuts([3.05, 3], [0.5, 1, 1.5, 2, 2.5, 3.2, 3.5]), [3.2, 2.85]);
  check("one too far from any beat stays where the voice put it", r.snapCuts([2.6], [1, 3.5]), [2.6]);

  // Near-still for a second, then steady action: the model's slow start.
  const curve = Array.from({ length: 70 }, (_, i) => (i < 10 ? 0.2 : 4 + (i > 40 && i < 55 ? 3 : 0)));
  const w = r.chooseWindow(curve, 10, 3, "property");
  check("the window starts after the slow start", !!w && w.start >= 0.8 && w.start <= 1.1, true);
  check("a people shot takes the busiest stretch", (r.chooseWindow(curve, 10, 2, "people")?.start ?? 0) >= 3.5, true);
  check("a clip a little short is slowed, no more than fifteen per cent",
    (() => { const x = r.chooseWindow(curve, 10, 6.4, "property"); return !!x && x.rate < 1 && x.rate >= 0.85; })(), true);
  check("one much too short is made again", r.chooseWindow(curve, 10, 9, "property"), null);

  const tracks = [
    { file: "warm/a.mp3", mood: "warm", seconds: 120, title: "a", artist: "" },
    { file: "warm/b.mp3", mood: "warm", seconds: 20, title: "b", artist: "" },
    { file: "uplifting/c.mp3", mood: "uplifting", seconds: 200, title: "c", artist: "" },
  ];
  check("the track fits the mood and the length", r.pickTrack(tracks, "warm", 33, [], 1)?.file, "warm/a.mp3");
  check("a track used recently is not used again", r.pickTrack(tracks, "warm", 33, ["warm/a.mp3"], 1)?.file, "uplifting/c.mp3");
  check("with every track used, the least recently used one", r.pickTrack(tracks, "warm", 33, ["uplifting/c.mp3", "warm/a.mp3"], 1)?.file, "uplifting/c.mp3");

  const clean = { qrScans: true, spokenMatch: 0.9, seconds: 30, buildingDrift: [] };
  check("a clean reel with no blockers passes", r.judgeReel(clean, { issues: [{ shot: "s2", kind: "pacing", fix: "none", blocker: false, note: "could be tighter" }] }, ["s1", "s2"]).passed, true);
  const bad = r.judgeReel(clean, { issues: [{ shot: "s2", kind: "artefact", fix: "regenerate", blocker: true, note: "her hand melts" }] }, ["s1", "s2"]);
  check("a blocker in a shot fails the reel and names the shot to redo", [bad.passed, bad.redo], [false, [{ shot: "s2", fix: "regenerate", note: "her hand melts" }]]);
  check("a QR that does not scan fails it", r.judgeReel({ ...clean, qrScans: false }, { issues: [] }, []).passed, false);
  check("so does narration that is not the script", r.judgeReel({ ...clean, spokenMatch: 0.3 }, { issues: [] }, []).passed, false);
  check("and a reel outside 22 to 30 seconds", r.judgeReel({ ...clean, seconds: 55 }, { issues: [] }, []).passed, false);
  check("a reel nobody could review is not passed", r.judgeReel(clean, null, []).passed, false);
  check("a shot sent back twice is not sent back a third time",
    r.repairsLeft([{ shot: "s2" }, { shot: "s3" }], new Map([["s2", r.MAX_SHOT_REDOS], ["s3", 1]])).map((x) => x.shot), ["s3"]);
  check("what was heard is matched to the script word by word", r.spokenMatch(["हर शाम एक सपना"], "हर शाम एक सपना होता है"), 1);
  {
    // The first live reel: a word-perfect narration the transcriber wrote all in Devanagari.
    const script = ["rent के कमरे में भी, अपना घर ख्वाब लगता है।", "एक सुबह, मीरा ने कहा, अब अपना address चाहिए।", "Tower C के entrance पर, सपना थोड़ा पास लगता है।", "पापा ने मुस्कुराकर पूछा, sea facing भी है?", "जवाब था, Sea facing from the 18th floor up.", "फिर budget में बात आई, 2 BHK from Rs 2,18,24,000.", "और हर wing में Two lifts और dedicated service lift है।", "इस weekend पे site visit book करें।"];
    const heard = "रेंट के कमरे में भी अपना घर ख्वाब लगता है। एक सुबह मीरा ने कहा, अब अपना एड्रेस चाहिए। टावरसी के एंट्रन्स पर सपना थोड़ा पास लगता है। पापा ने मुस्कुरा कर पूछा, सी फेसिंग भी है? जवाब था, सी फेसिंग फ्राम दा एटीन फ्लोर अप। फिर बज़ट में बात आई दो बीएचके फ्राम दो करोड अठारह लाक चौबिस हजार रुपे। और हर विंग में टू लिफ्स और डेडिकेटेट सर्विस लिफ्ट है। इस वीकेंड पर साइट विजिट बुक करें।";
    check("English words heard in Devanagari still count: रेंट is rent", r.spokenMatch(script, heard) >= r.SPOKEN_FLOOR, true);
    check("and so do Hindi words heard in Roman", r.spokenMatch(script, "rent ke kamre mein bhi apna ghar khwab lagta hai. ek subah meera ne kaha ab apna address chahiye. tower c ke entrance par sapna thoda paas lagta hai. papa ne muskurakar poocha sea facing bhi hai? jawab tha sea facing from the eighteenth floor up. phir budget mein baat aayi. aur har wing mein two lifts aur dedicated service lift hai. is weekend pe site visit book karein.") >= r.SPOKEN_FLOOR, true);
    check("half the narration is not enough", r.spokenMatch(script, heard.slice(0, Math.floor(heard.length / 2))) < r.SPOKEN_FLOOR, true);
    check("and another advertisement's narration is nowhere near", r.spokenMatch(script, "नमस्ते, आज हम बात करेंगे अपने नए ऑफिस के बारे में, जो पुणे में है। हमारी टीम बहुत मेहनत करती है और हर ग्राहक को अच्छी सेवा देती है।") < 0.4, true);
  }
  check("every video size makes a story video, wide ones too", r.reelPlacements(["Meta reel 9:16", "YouTube 16:9", "Meta story 9:16", "Meta feed 1:1"]), ["Meta reel 9:16", "Meta story 9:16", "YouTube 16:9"]);
  check("a 3:2 render is cropped for a wide film", r.frameFit({ w: 1500, h: 1000 }, { w: 1920, h: 1080 }), "crop");
  check("and extended for a tall reel", r.frameFit({ w: 1500, h: 1000 }, { w: 1080, h: 1920 }), "extend");
  check("the narrated story's key is no video template's, so choosing it can never mean another design",
    (await import("../src/lib/template-rules.ts")).isTemplateKey(r.STORY_TEMPLATE.key, "VIDEO"), false);
  check("a tall render is cropped for a reel and extended for a wide film",
    [r.frameFit({ w: 1080, h: 1500 }, { w: 1080, h: 1920 }), r.frameFit({ w: 1080, h: 1500 }, { w: 1920, h: 1080 })], ["crop", "extend"]);
