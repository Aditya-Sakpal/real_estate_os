  const problems = (codes: string[]) => c.judgeDesign({
    review: { ...good, buildingMatches: !codes.includes("B"), looksLikeAd: true },
    expected: [], allowed: good.texts, registrationNo: "P51700055555", phone: null,
    qr: { lockup: true, expected: codes.includes("Q") ? null : "q", read: "q" },
  });
  check("the model's mistakes are worth another attempt", c.worthRedesigning(problems(["B"])), true);
  check("ours are not, because drawing again changes nothing", c.worthRedesigning(problems(["Q"])), false);
  check("the retry is told what to fix, in words with no number",
    c.fixesFrom(problems(["B"])).every((f: string) => !/\d/.test(f)), true);
