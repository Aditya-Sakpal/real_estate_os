  inviterScopes: ["billbay.gp_pune_spv.pune"],
  inviterHeld: permSet("lead:read", "lead:update", "lead:call", "inventory:read", "visit:read", "visit:schedule", "member:read", "member:invite"),
};
const perms = (key: string) => roleByKey(key)!.permissions;

console.log("\nInvite gate 1: may you grant this");
check("an org admin may grant an org-level role",
  checkGrant({ ...ADMIN_AT_ROOT, role: { key: "SALES_HEAD", minKind: "ORG", permissions: perms("SALES_HEAD") }, target: ROOT }).ok,
  true);
// The ordering constraint: nine of the fourteen roles have nothing to attach
// to until the scope tree is deeper than its root.
check("a project-level role cannot be granted at the root",
  (checkGrant({ ...ADMIN_AT_ROOT, role: { key: "SITE_TEAM", minKind: "PHASE", permissions: perms("SITE_TEAM") }, target: ROOT }) as { code: string }).code,
  "ROLE_TOO_DEEP");
check("you cannot invite outside your own subtree",
  (checkGrant({
    ...HEAD_AT_PUNE,
    role: { key: "PRESALES_AGENT", minKind: "PROJECT", permissions: perms("PRESALES_AGENT") },
    target: { path: "billbay.gp_blr_spv.bengaluru.aria", kind: "PROJECT" },
  }) as { code: string }).code,
  "OUTSIDE_YOUR_SCOPE");
check("you can invite below your own node",
  checkGrant({
    ...HEAD_AT_PUNE,
    role: { key: "PRESALES_AGENT", minKind: "PROJECT", permissions: perms("PRESALES_AGENT") },
    target: { path: "billbay.gp_pune_spv.pune.trees", kind: "PROJECT" },
  }).ok,
  true);
// The trap the dot exists for, applied to invites this time.
check("a sibling sharing a prefix is not below you",
  (checkGrant({
    ...HEAD_AT_PUNE,
    role: { key: "PRESALES_AGENT", minKind: "PROJECT", permissions: perms("PRESALES_AGENT") },
    target: { path: "billbay.gp_pune_spv.punekar.x", kind: "PROJECT" },
  }) as { code: string }).code,
  "OUTSIDE_YOUR_SCOPE");
// The subset rule contains the old rank rule: only the wildcard satisfies
// the wildcard, so nothing else may mint an administrator.
check("only an admin grants the admin role",
  (checkGrant({
    inviterScopes: ["billbay"],
    inviterHeld: permSet(...perms("SALES_HEAD"), "member:invite"),
    role: { key: "ORG_ADMIN", minKind: "ORG", permissions: ["*"] },
    target: ROOT,
  }) as { code: string }).code,
  "ONLY_ADMIN_GRANTS_ADMIN");
check("an admin may grant the admin role",
  checkGrant({ ...ADMIN_AT_ROOT, role: { key: "ORG_ADMIN", minKind: "ORG", permissions: ["*"] }, target: ROOT }).ok,
  true);

console.log("\nInvite gate 1: only what you hold, where you hold it");
// What rank never caught: a regional head handing out phone numbers they
// cannot see themselves.
const PSM = { key: "PROJECT_SALES_MANAGER", label: "Project Sales Manager", minKind: "PROJECT" as const,
  permissions: perms("PROJECT_SALES_MANAGER") };
const TREES = { path: "billbay.gp_pune_spv.pune.trees", kind: "PROJECT" as const, name: "Trees" };
check("a head without phone numbers cannot give a role that shows them",
