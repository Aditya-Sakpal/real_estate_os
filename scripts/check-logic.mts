console.log("\nRERA outside Maharashtra: each adapter, on captured pages");
{
  const { readFileSync, existsSync } = await import("node:fs");
  const S = await import("../src/lib/rera-states.ts");
  const R = await import("../src/lib/rera-rules.ts");
  const FIX = new URL("../db/fixtures/rera", import.meta.url).pathname.replace(/^\/([A-Za-z]:)/, "$1");
  for (const st of ["KA", "DL", "GJ", "HR", "TN", "WB", "AP", "RJ"]) {
    const dir = `${FIX}/${st.toLowerCase()}`;
    if (!existsSync(`${dir}/cases.json`)) {
      check(`${st}: captured pages exist`, false, true);
      continue;
    }
    const c = JSON.parse(readFileSync(`${dir}/cases.json`, "utf8"));
    const env = `RERA_${st}_FIXTURES`;
    process.env[env] = dir;
    S.resetPortalCache();
    const adapter = S.adapterFor(st)!;
    const ours = await S.lookupAtForm(st, c.ours);
    check(`${st}: our number is found, registered, to our promoter`,
      ours.known && ours.found ? [ours.project.status, R.promoterMatches(ours.project.promoterName ?? "", c.ourPromoter)] : ours,
      ["REGISTERED", true]);
    const others = await S.lookupAtForm(st, c.others);
    check(`${st}: another promoter's is found under their name`,
      others.known && others.found ? R.promoterMatches(others.project.promoterName ?? "", c.otherPromoter) : others, true);
    if (c.revoked) {
      const rev = await S.lookupAtForm(st, c.revoked);
      check(`${st}: a revoked number reads as the authority says`,
        rev.known && rev.found ? rev.project.status !== "REGISTERED" : rev, true);
    }
    const never = await S.lookupAtForm(st, c.never);
    check(`${st}: a number never issued is a definite no`, never, { known: true, found: false });
    const night = await S.nightlyRead(st);
    check(`${st}: the nightly read passes on its captured lists`, night.ok, true);
    if (night.ok) {
      const reg = night.read.register;
      if (reg) {
        check(`${st}: ours is in the register and the never-issued number is not`,
          [reg.has(adapter.keyOf(c.ours)), reg.has(adapter.keyOf(c.never))], [true, false]);
      }
      const tied = c.revoked ?? c.tiedRevoked ?? null;
      if (tied) check(`${st}: the revoked number is on the blocked list`, night.read.blocked.has(adapter.keyOf(tied)), true);
      check(`${st}: in the requests it says`, night.read.requests, c.nightlyRequests);
    }
    // A page that parses to nothing is refused, not believed.
    const empty = await adapter.nightly!({ fetchImpl: async () => new Response("<html></html>", { status: 200 }) });
    check(`${st}: an empty page at night is refused`, empty.ok, false);
    const thrown = await adapter.atForm(c.ours, { fetchImpl: async () => { throw new Error("ECONNREFUSED"); } });
    check(`${st}: a portal that will not answer is "could not tell"`, thrown.known, false);
    delete process.env[env];
    S.resetPortalCache();
  }
}

console.log("\nMahaRERA revocation list");
const ROW = `<tr><td>1</td><td>DB Turf View</td><td>TURF ESTATE JV</td><td>P51700031957</td><td>MCGM</td><td><a href="/x.pdf">Order</a></td></tr>`;
const rows = parseList(`<table>${ROW}</table>`, "SUSPENDED");
check("a row is parsed", rows.length, 1);
check("the registration number is read", rows[0]?.registrationNo, "P51700031957");
check("the project name is read", rows[0]?.projectName, "DB Turf View");
check("the promoter is read", rows[0]?.promoterName, "TURF ESTATE JV");
check("the status is carried", rows[0]?.status, "SUSPENDED");

// Columns are found by the SHAPE of a registration number, not by index, so
// a column inserted upstream shifts nothing.
const SHIFTED = ROW.replace("<td>1</td>", "<td>1</td><td>extra</td>");
check("an inserted column does not break it",
  parseList(`<table>${SHIFTED}</table>`, "SUSPENDED")[0]?.registrationNo,
  "P51700031957");

check("a header row is ignored",
  parseList("<table><tr><th>Sr</th><th>Name</th></tr></table>", "SUSPENDED").length, 0);
check("a row without a registration number is ignored",
  parseList("<table><tr><td>1</td><td>x</td><td>y</td><td>z</td></tr></table>", "SUSPENDED").length,
  0);

// THE safety property. If the page shape changes and the parser returns
// nothing, treating that as an empty register would silently clear every
// project the authority has actually revoked.
const emptyFetch = await fetchBlocklist(async () =>
  new Response("<html><table></table></html>", { status: 200 }),
);
check("an empty parse is refused, not treated as no revocations",
  emptyFetch.ok, false);
check("and says the page shape probably changed",
  /page shape/i.test((emptyFetch as { reason: string }).reason ?? ""),
  true);

// A portal that will not load is an unknown, not a finding.
const downFetch = await fetchBlocklist(async () => new Response("", { status: 503 }));
check("a 503 is refused rather than read as empty", downFetch.ok, false);
const throwFetch = await fetchBlocklist(async () => {
  throw new Error("ECONNREFUSED");
});
check("a network failure is refused too", throwFetch.ok, false);
check("and names the cause",
  /unreachable/i.test((throwFetch as { reason: string }).reason ?? ""), true);

// A plausible page passes.
const manyRows = Array.from({ length: 25 }, (_, i) =>
  ROW.replace("P51700031957", `P517000319${String(i).padStart(2, "0")}`),
).join("");
const goodFetch = await fetchBlocklist(async () =>
  new Response(`<table>${manyRows}</table>`, { status: 200 }),
);
check("a plausible page is accepted", goodFetch.ok, true);
check("and every row lands in the set",
  goodFetch.ok ? goodFetch.entries.size : 0, 25);


