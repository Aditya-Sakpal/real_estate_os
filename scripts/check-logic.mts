    P.readSns({ Type: "Notification", TopicArn: "a", Message: JSON.stringify({ receipt: { virusVerdict: { status: "FAIL" } }, content: "x" }) }).kind, "ignore");
}

console.log("\nMessages: templates, what they cost, and when one may go");
{
  const M = await import("../src/lib/message-rules.ts");
  const noon = "2026-09-25T06:30:00Z";
  const late = "2026-09-25T17:30:00Z"; // 11 pm IST
  const base = {
    template: M.TEMPLATES.ACK, nowIso: late, optedOut: false, consentRequired: true, consents: [],
    enquiredAt: "2026-09-25T17:00:00Z", lastInboundAt: null, liveVisit: false, booked: false, advertisable: true,
  };
  check("every version of every template names its blanks as often as its body numbers them, in order",
    M.CATALOG.every((t) => (t.body.match(/\{\{\d+\}\}/g) ?? []).join() === t.blanks.map((_, i) => `{{${i + 1}}}`).join()), true);
  check("every template name is one WhatsApp accepts, and no two versions share one",
    [M.CATALOG.every((t) => /^[a-z0-9_]{1,512}$/.test(t.name)), new Set(M.CATALOG.map((t) => t.name)).size === M.CATALOG.length, M.CATALOG.length === 3 * M.PURPOSES.length],
    [true, true, true]);
  check("the version follows the lead's language, English when it is not known",
    [M.voiceFor("hi"), M.voiceFor("mr"), M.voiceFor("en"), M.voiceFor(null), M.voiceFor("ta")], ["HINGLISH", "MARATHI", "ENGLISH", "ENGLISH", "ENGLISH"]);
  check("each version is filed under its own name, in English letters, never Devanagari",
    [M.versionOf(M.TEMPLATES.VISIT_CONFIRMED, "HINGLISH").name, M.versionOf(M.TEMPLATES.VISIT_CONFIRMED, "ENGLISH").name, M.versionOf(M.TEMPLATES.VISIT_CONFIRMED, "MARATHI").name,
     M.CATALOG.some((t) => /[\u0900-\u097F]/.test(t.body))],
    ["salesdesk_visit_confirmed", "salesdesk_visit_confirmed_en", "salesdesk_visit_confirmed_mr", false]);
  check("the lender's question asks in the buyer's own words, with buttons to match",
    [M.versionOf(M.TEMPLATES.LENDER_ASK, "ENGLISH").buttons, M.versionOf(M.TEMPLATES.LENDER_ASK, "MARATHI").buttons, M.versionOf(M.TEMPLATES.SLOT_OFFER, "MARATHI").buttons],
    [["Yes, share", "No"], ["Ho, share kara", "Nako"], ["Book 1", "Book 2", "Book 3"]]);
  check("the after-call line and the fall-backs are said in each version",
    [M.nextStepIn("Hamare sales manager aapko thodi der mein call karenge.", "ENGLISH"), M.nextStepIn("Something new.", "MARATHI"),
     M.render(M.versionOf(M.TEMPLATES.ACK, "ENGLISH"), M.fill(M.versionOf(M.TEMPLATES.ACK, "ENGLISH"), { developer: "Sath Group" }))],
    ["Our sales manager will call you shortly.", "Something new.", "Hi there, thank you for your enquiry with Sath Group! Our team will call you after 10 am. If another time suits you better, just reply here."]);
  check("a utility acknowledgement goes out at eleven at night", M.gateMessage(base), { ok: true, basis: "ENQUIRY" });
  check("an opt-out refuses it", M.gateMessage({ ...base, optedOut: true }).ok, false);
  check("a marketing nudge waits for calling hours", M.gateMessage({ ...base, template: M.TEMPLATES.NURTURE }).ok, false);
  check("and needs consent even inside them",
    M.gateMessage({ ...base, nowIso: noon, template: M.TEMPLATES.NURTURE }).ok, false);
  check("with consent on file it goes",
    M.gateMessage({ ...base, nowIso: noon, template: M.TEMPLATES.NURTURE, consents: [{ channels: ["whatsapp"], capturedAt: "2026-09-01T00:00:00Z", expiresAt: null }] }).ok, true);
  check("with consent switched off a promotion may go inside the enquiry's 7 days, and past them needs consent whatever the setting",
    [M.gateMessage({ ...base, nowIso: "2026-09-26T06:30:00Z", consentRequired: false, template: M.TEMPLATES.NURTURE }),
     M.gateMessage({ ...base, nowIso: "2026-09-26T06:30:00Z", consentRequired: false, enquiredAt: "2026-09-10T00:00:00Z", template: M.TEMPLATES.NURTURE }).ok,
     M.gateMessage({ ...base, nowIso: "2026-09-26T06:30:00Z", consentRequired: false, enquiredAt: "2026-09-10T00:00:00Z", template: M.TEMPLATES.VISIT_REMINDER_DAY }).ok],
    [{ ok: true, basis: "NOT_REQUIRED" }, false, true]);
  check("a tower that may not be advertised gets nothing naming it",
    M.gateMessage({ ...base, template: M.TEMPLATES.VISIT_CONFIRMED, advertisable: false }).ok, false);
  check("but the content-free acknowledgement still goes", M.gateMessage({ ...base, advertisable: false }).ok, true);
  check("a visit reminder rests on the visit the buyer booked, weeks after the enquiry",
    M.gateMessage({ ...base, template: M.TEMPLATES.VISIT_REMINDER_DAY, enquiredAt: "2026-08-01T00:00:00Z", liveVisit: true }), { ok: true, basis: "VISIT" });
  check("a buyer who wrote to us opened a window",
    M.gateMessage({ ...base, template: M.TEMPLATES.MISSED_CALL, enquiredAt: "2026-08-01T00:00:00Z", lastInboundAt: "2026-09-25T12:00:00Z" }), { ok: true, basis: "SESSION" });
  const values = M.fill(M.TEMPLATES.VISIT_CONFIRMED, { first_name: "Priya", project: "Sath Heights Tower C", when: "Sat 26 Sep, 11:00 am", directions: "https://maps.example/x" });
  check("the body reads as the buyer will read it", M.render(M.TEMPLATES.VISIT_CONFIRMED, values).includes("Sath Heights Tower C ka aapka site visit Sat 26 Sep, 11:00 am ke liye confirm hai"), true);
  check("no template starts or ends with a blank, which Meta refuses",
    M.CATALOG.every((t) => !/^\{\{\d+\}\}|\{\{\d+\}\}[.!?:]?$/.test(t.body.trim())), true);
