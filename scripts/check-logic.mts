  check("a Karnataka number of the register's shape is accepted",
    R.validateRegistrationNumber("KA", "PRM/KA/RERA/1251/308/PR/250926/008969").ok, true);
  check("and one carried to a new promoter",
    R.validateRegistrationNumber("KA", "TOR/PRM/KA/RERA/1251/308/PR/250926/008969").ok, true);
  check("a Delhi number of the wrong shape names Delhi's",
    (R.validateRegistrationNumber("DL", "DLRERA26P4") as { message: string }).message, "Delhi numbers look like DLRERA2026P0004.");
  check("a Rajasthan exemption certificate is not a registration",
    R.validateRegistrationNumber("RJ", "RAJ/RERAExempted Project/2025/058").ok, false);
  check("a firm's M/s. is not part of its legal name",
    R.promoterMatches("M/s. Rera Check Holdings LLP", "Rera Check Holdings LLP"), true);

  // Extensions an authority gave everybody at once.
  const ext = (o: Parameters<typeof R.blanketExtension>[0]) => R.blanketExtension(o);
  check("MahaRERA's order adds four months to a registration it reaches",
    ext({ stateCode: "MH", validTo: "2026-09-30", recordedAt: "2025-01-10" })?.until, "2027-01-30");
  check("and names the order",
    /Order 66\/2026/.test(ext({ stateCode: "MH", validTo: "2026-09-30", recordedAt: "2025-01-10" })?.ref ?? ""), true);
  check("a completion date before 28 February is not reached",
    ext({ stateCode: "MH", validTo: "2026-02-27", recordedAt: "2025-01-10" }), null);
  check("a registration made on or after 1 August is not reached",
    ext({ stateCode: "MH", validTo: "2027-09-30", registeredOn: "2026-08-01" }), null);
  // Recorded after the cut-off with no date from the authority proves
  // nothing, and nothing is extended: the direction that never advertises a
  // lapsed number.
  check("recorded after the cut-off with no registration date is not reached",
    ext({ stateCode: "MH", validTo: "2026-10-31", recordedAt: "2026-09-01" }), null);
  check("but the authority's registration date settles it",
    ext({ stateCode: "MH", validTo: "2026-10-31", registeredOn: "2024-03-01", recordedAt: "2026-09-01" })?.until, "2027-02-28");
  check("month ends are kept: 31 October plus four is the end of February",
    ext({ stateCode: "KA", validTo: "2026-10-31", recordedAt: "2025-01-01" })?.until, "2027-02-28");
  check("Telangana's order moves a date in its window to 30 November",
    ext({ stateCode: "TG", validTo: "2026-05-15", recordedAt: "2025-01-01" })?.until, "2026-11-30");
  check("and says nothing about a date after its window",
    ext({ stateCode: "TG", validTo: "2026-08-15", recordedAt: "2025-01-01" }), null);
  check("a state with no order gets nothing",
    ext({ stateCode: "GJ", validTo: "2026-09-30", recordedAt: "2025-01-01" }), null);
  check("an extension keeps a registration advertisable past its own date",
    R.canAdvertise({ status: "VERIFIED", validTo: "2026-09-01", extendedUntil: "2027-01-01" }, new Date("2026-10-01")).ok, true);
  check("and the later of the two dates is the one that counts",
    [R.effectiveValidTo("2027-05-01", "2027-01-01"), R.effectiveValidTo("2026-09-01", null)], ["2027-05-01", "2026-09-01"]);
}

