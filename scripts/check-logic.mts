  check("with nothing learnt, the rotation as before", L.pickLearned(["A", "B"], scoreOf, { learnt: false, explore: 0.2, rand, recent: ["A"] }), { pick: "B", by: "ROTATION" });
  check("the approved points are reordered, never added to",
