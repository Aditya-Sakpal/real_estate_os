{
  console.log("\nThe worker's watchdog: reading a job's log, and what is an alert");
  const W = await import("../src/lib/watchdog-rules.ts");
  const log = [
    "2026-09-30T10:00:00+05:30 start lead:run  (abc1234)",
    "2026-09-30T10:00:05+05:30   orgs scanned 3",
    "2026-09-30T10:00:09+05:30 end lead:run exit 0",
    "2026-09-30T10:03:00+05:30 start lead:run  (abc1234)",
    "2026-09-30T10:03:09+05:30 end lead:run exit 1",
  ].join("\n");
  const rule = W.JOB_RULES.find((r) => r.job === "lead-run")!;
  check("the newest run is read, with its exit code", W.lastRun(log), { startedAt: "2026-09-30T10:03:00+05:30", endedAt: "2026-09-30T10:03:09+05:30", exit: 1 });
  check("a failed run is an alert", W.jobAlert(rule, W.lastRun(log), "2026-09-30T04:35:00Z")?.key, "lead-run:failed");
  const ok = W.lastRun(log.replace(/exit 1$/, "exit 0"))!;
  check("a clean run inside its window is not", W.jobAlert(rule, ok, "2026-09-30T04:40:00Z"), null);
  check("a clean run whose timer stopped is an alert once it is late", W.jobAlert(rule, ok, "2026-09-30T05:00:00Z")?.key, "lead-run:stale");
  const running = W.lastRun(log + "\n2026-09-30T10:06:00+05:30 start lead:run  (abc1234)")!;
  check("a run in progress is not an alert", W.jobAlert(rule, running, "2026-09-30T04:40:00Z"), null);
  check("a run past its limit is stuck", W.jobAlert(rule, running, "2026-09-30T06:00:00Z")?.key, "lead-run:stuck");
  check("a job with no runs is switched off, never an alert", W.jobAlert(rule, W.lastRun(""), "2026-09-30T06:00:00Z"), null);
  const dep = "deploying 1111111\nlive: 1111111\ndeploying 2222222\nmigration failed for 2222222; the old release stays live";
  check("a failed deploy is an alert keyed on its commit", W.deployAlert(W.lastDeploy(dep))?.key, "deploy:2222222");
  check("a deploy that went live is not", W.deployAlert(W.lastDeploy(dep + "\ndeploying 3333333\nlive: 3333333")), null);
  const a = W.jobAlert(rule, W.lastRun(log), "2026-09-30T04:35:00Z")!;
  check("an alert sent in the last hour is not sent again", W.dueAlerts([a], { [a.key]: "2026-09-30T04:00:00Z" }, "2026-09-30T04:35:00Z"), []);
  check("after the hour it is", W.dueAlerts([a], { [a.key]: "2026-09-30T03:00:00Z" }, "2026-09-30T04:35:00Z").length, 1);
  const d = W.deployAlert(W.lastDeploy(dep))!;
  check("a failed deploy is told once, however long it stays failed", W.dueAlerts([d], { [d.key]: "2026-09-20T00:00:00Z" }, "2026-09-30T04:35:00Z"), []);
  check("keys older than a week are pruned", Object.keys(W.pruneSent({ a: "2026-09-01T00:00:00Z", b: "2026-09-29T00:00:00Z" }, "2026-09-30T00:00:00Z")), ["b"]);
}

// ---------------------------------------------------------------------------
// The vault's formats: format 1 under CONNECTOR_KEY, format 2 under a tenant's
// own data key, and the list of every sealed column.
// ---------------------------------------------------------------------------
console.log("\nThe vault: per-tenant data keys");
{
  const VR = await import("../src/lib/vault-rules.ts");
  const dk = Buffer.alloc(32, 7);
  const sealed = VR.sealV2(dk, 3, "org-a", "connection:1", "the-token");
  check("format 2 starts with 2 and the key version", [sealed[0], sealed[1]], [2, 3]);
  check("and is 2 + 12 + 16 bytes longer than the text", sealed.length, 2 + 12 + 16 + "the-token".length);
  check("it opens under its own data key, org and row", VR.openV2(dk, "org-a", "connection:1", sealed), "the-token");
  check("not for another org, another row or another key",
    [VR.openV2(dk, "org-b", "connection:1", sealed), VR.openV2(dk, "org-a", "connection:2", sealed), VR.openV2(Buffer.alloc(32, 8), "org-a", "connection:1", sealed)],
    [null, null, null]);
  const flipped = Buffer.from(sealed); flipped[flipped.length - 1] ^= 1;
  check("a changed byte opens to nothing", VR.openV2(dk, "org-a", "connection:1", flipped), null);
  const reversioned = Buffer.from(sealed); reversioned[1] = 4;
  check("the second byte is read as the key version", VR.sealedFormat(reversioned), { format: 2, keyVersion: 4 });
  check("format 1 is not opened as format 2, nor 2 as 1",
    [VR.openV2(dk, "org-a", "connection:1", VR.sealWith(dk, "org-a", "connection:1", "x")), VR.openWith(dk, "org-a", "connection:1", sealed)], [null, null]);
  const v1 = VR.sealWith(Buffer.alloc(32, 1), "org-a", "p", "t");
  check("the format is read off the first byte", [VR.sealedFormat(v1), VR.sealedFormat(sealed), VR.sealedFormat(Buffer.from([9, 1, 2])), VR.sealedFormat(null)],
    [{ format: 1 }, { format: 2, keyVersion: 3 }, null, null]);
  check("a version of 0 is not a key", VR.sealedFormat(Buffer.concat([Buffer.from([2, 0]), Buffer.alloc(40)])), null);
  check("sealing refuses a short key and a version outside 1 to 255",
    [(() => { try { VR.sealV2(Buffer.alloc(16), 1, "o", "p", "t"); return "sealed"; } catch { return "refused"; } })(),
     (() => { try { VR.sealV2(dk, 256, "o", "p", "t"); return "sealed"; } catch { return "refused"; } })(),
     (() => { try { VR.sealV2(dk, 0, "o", "p", "t"); return "sealed"; } catch { return "refused"; } })()],
    ["refused", "refused", "refused"]);
  check("re-sealing moves format 1 and a retired key, and leaves the key sealing now",
