  }).find((p: { code: string }) => p.code === "EXTRA_TEXT");
  check("extra words on a construction photo are soft", !!(siteExtra && siteExtra.soft && !siteExtra.fixable), true);
  check("cut-off text fails", judge({ textCutOff: true }), ["TEXT_CUT"]);
  check("a changed building fails", judge({ buildingMatches: false }), ["BUILDING_CHANGED"]);
  check("a weak design fails", judge({ looksLikeAd: false }), ["DESIGN_WEAK"]);
  check("an unreadable RERA number fails", judge({ registration: "P5170005" }), ["REG_UNREADABLE"]);
  check("so does the wrong phone number", judge({ phone: "+91 98765 11111" }), ["PHONE_UNREADABLE"]);
  check("a QR that does not scan fails", judge({}, { read: null }), ["QR_UNREADABLE"]);
  check("so does one that scans to something else", judge({}, { read: "https://elsewhere" }), ["QR_UNREADABLE"]);
  check("a lockup with no QR in it is named as the cause", judge({}, { expected: null, read: null }), ["LOCKUP_NO_QR"]);
