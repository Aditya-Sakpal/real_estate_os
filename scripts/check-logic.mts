    ["70 to 80 lakhs", "2 BHK", null, "Within 3 months", null]);
  check("a booked visit shows its time",
    R.factsFromVariables({ site_visit_status: "booked", site_visit_time: "Sunday at 11 AM" }).at(-1)?.value, "Sunday at 11 AM");
}

// ---------------------------------------------------------------------------
// The DND register. A call inside the enquiry's seven days answers it; any
// other call to a number on the register needs consent registered with the
// operator. Only a definite answer refuses, and only a lookup's runs out.
// ---------------------------------------------------------------------------
console.log("\nThe DND register: the verdict, what stands, reading a refusal");
{
  const D = await import("../src/lib/dnd-rules.ts");
  const noon = "2026-09-25T06:30:00Z";
  const fresh = "2026-09-24T06:30:00Z";
  const old = "2026-09-10T06:30:00Z";
  const row = (status: "DND" | "CLEAR" | "CONSENT_REGISTERED", source: "LOOKUP" | "OPERATOR" | "PERSON", checkedAt: string) =>
    ({ status, source, checkedAt, expiresAt: D.expiresFor(source, checkedAt) });
  const dnd = row("DND", "OPERATOR", "2026-09-20T06:30:00Z");

  check("a call inside the enquiry's seven days is not scrubbed, even on the register",
    D.dndVerdict({ standing: dnd, enquiredAt: fresh, nowIso: noon }), { ok: true, basis: "ENQUIRY" });
  check("past them, a number on the register is refused",
    D.dndVerdict({ standing: dnd, enquiredAt: old, nowIso: noon }), { ok: false, code: "DND", message: D.DND_MESSAGE });
  check("and consent registered with the operator lets it through",
    D.dndVerdict({ standing: row("CONSENT_REGISTERED", "PERSON", "2026-09-21T00:00:00Z"), enquiredAt: old, nowIso: noon }),
    { ok: true, basis: "CONSENT_REGISTERED" });
  check("a number nobody checked is not a number on the register",
    D.dndVerdict({ standing: null, enquiredAt: old, nowIso: noon }), { ok: true, basis: "UNKNOWN" });
  check("the window is the calling gate's own seven days",
    [D.inEnquiryWindow("2026-09-18T06:31:00Z", noon), D.inEnquiryWindow("2026-09-18T06:29:00Z", noon),
      D.inEnquiryWindow("2026-09-25T06:33:00Z", noon)], [true, false, true]);

  check("a lookup's answer lasts a day; the operator's and a person's stand",
    [D.expiresFor("LOOKUP", noon), D.expiresFor("OPERATOR", noon), D.expiresFor("PERSON", noon)],
    ["2026-09-26T06:30:00.000Z", null, null]);
  check("the newest answer stands",
    D.standingDnd([dnd, row("CONSENT_REGISTERED", "PERSON", "2026-09-22T00:00:00Z")], noon)?.status, "CONSENT_REGISTERED");
  check("a lookup a day old is no answer, never a fall back to the one it replaced",
    D.standingDnd([dnd, row("CLEAR", "LOOKUP", "2026-09-23T00:00:00Z")], noon), null);
  check("and a fresh one stands", D.standingDnd([row("DND", "LOOKUP", "2026-09-25T00:00:00Z")], noon)?.status, "DND");

  check("a refusal naming the register is read as DND",
    ["CALL_REJECTED_DND", "Number is on DND", "NCPR preference", "Blocked: do-not-disturb"].map(D.dndCause), [true, true, true, true]);
  check("a generic rejection is what a busy phone returns too, and is not",
    ["CALL_REJECTED", "USER_BUSY", "480 Temporarily Unavailable", "486 Busy Here", "no_answer", null, "sandndune"].map(D.dndCause),
    [false, false, false, false, false, false, false]);
  check("a lookup's answer is read defensively", ["dnd\n", " CLEAR ", "maybe", ""].map(D.readLookup), ["DND", "CLEAR", null, null]);
  check("the history says what a person recorded, and what the operator refused",
    [D.dndActivity("DND", "PERSON"), D.dndActivity("DND", "OPERATOR"), D.dndActivity("CLEAR", "LOOKUP")],
    ["Marked as on the DND register", "The operator refused the call: the number is on the DND register", null]);
}

console.log("\nLead capture: proving the sender, reading the form, the lineage");
{
  const C = await import("../src/lib/capture-rules.ts");
  const { createHmac } = await import("node:crypto");
  const body = JSON.stringify({ object: "page", entry: [] });
  const sig = `sha256=${createHmac("sha256", "s3cret").update(body).digest("hex")}`;
  check("Meta's signature over the body verifies", C.metaSignatureValid(body, sig, "s3cret"), true);
  check("a body changed by one byte does not", C.metaSignatureValid(body + " ", sig, "s3cret"), false);
  check("nor does a missing header", C.metaSignatureValid(body, null, "s3cret"), false);
  const k = C.captureKey("x", "11111111-1111-1111-1111-111111111111");
  check("a capture key proves one org", C.captureKeyValid("x", "11111111-1111-1111-1111-111111111111", null, k), true);
  check("and not another", C.captureKeyValid("x", "22222222-2222-2222-2222-222222222222", null, k), false);
  check("an enquiry-page key is bound to its tower too",
    C.captureKeyValid("x", "11111111-1111-1111-1111-111111111111", "33333333-3333-3333-3333-333333333333", k), false);

  const pings = C.leadgenPings({
    object: "page",
    entry: [{ id: "123", changes: [{ field: "leadgen", value: { leadgen_id: "987", page_id: "123", form_id: "55", ad_id: "77" } }, { field: "feed", value: {} }] }],
  });
  check("a Page webhook yields its leadgen ids and nothing else", pings.map((p) => [p.leadgenId, p.pageId, p.adId]), [["987", "123", "77"]]);
  check("a WhatsApp webhook yields no leadgen pings", C.leadgenPings({ object: "whatsapp_business_account", entry: [] }).length, 0);
  const meta = C.readMetaLead(pings[0], {
    field_data: [
      { name: "full_name", values: ["Priya Sharma"] },
      { name: "phone_number", values: ["+91 98765 43210"] },
      { name: "email", values: ["Priya@Example.com"] },
    ],
    campaign_id: "c1",
    custom_disclaimer_responses: [{ checkbox_key: "a", is_checked: true }],
  });
  check("a Meta lead reads its name, number and email", [meta.name, meta.phone, meta.email], ["Priya Sharma", "+919876543210", "priya@example.com"]);
  check("a ticked disclaimer is consent", meta.consent !== null, true);
  check("and the campaign and ad travel with it", [meta.lineage.campaignId, meta.lineage.adId], ["c1", "77"]);
  const g = C.readGoogleLead({
    lead_id: "g-1", google_key: "k", campaign_id: 9, gcl_id: "gc",
    user_column_data: [{ column_id: "FULL_NAME", string_value: "Rohan Patil" }, { column_id: "PHONE_NUMBER", string_value: "09876543210" }],
    is_test: true,
  });
  check("a Google lead form reads the same way", [g?.name, g?.phone, g?.lineage.gclid, g?.isTest], ["Rohan Patil", "+919876543210", "gc", true]);
  const web = C.readWebLead({ Name: "Asha", "Phone Number": "98765 43210", consent: "on", utm_source: "facebook", utm_content: "est-0123456789ab" }, "2026-09-25T06:30:00Z");
  check("a website form reads any field naming", [web?.name, web?.phone], ["Asha", "+919876543210"]);
  check("its consent box counts", web?.consent !== null, true);
  check("our tag names the publication", web?.lineage.ref, "0123456789ab");
  check("and the source reads as a Meta ad", C.sourceLabel("WEBSITE", web!.lineage), "Meta ad");
  check("a form with neither a phone nor an email is nothing", C.readWebLead({ name: "x" }, "2026-09-25T06:30:00Z"), null);
  check("an email alone is refused at the door, since a lead is somebody to call",
    [C.readWebLead({ email: "a@b.in" }, "2026-09-25T06:30:00Z"), C.webFormProblem({ email: "a@b.in" })], [null, "A mobile number is needed."]);
  check("a bad number is named as a bad number", C.webFormProblem({ phone: "12345" })?.includes("does not look right"), true);
  check("a tower id that is not an id is refused", C.webFormProblem({ phone: "9876543210", phase: "abc" }), "The form names a tower that does not exist.");
  const at = "2026-09-25T06:30:00Z";
