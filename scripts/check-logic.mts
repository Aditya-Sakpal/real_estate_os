  check("a ULID sorts by time", A.ulid(1, new Uint8Array(10)) < A.ulid(2, new Uint8Array(10)), true);
  check("a ULID's time half is the documented encoding", A.ulid(1469918176385, new Uint8Array(10)).slice(0, 10), "01ARYZ6S41");

