    ["site", "exterior", "interior"]);

  const copy = { headline: "Sea facing", body: "From the 18th floor.", cta: "Book a visit" };
  check("an image is one frame, the copy as written", c.slidesFor(copy, ["A", "B"], "IMAGE").length, 1);
  const slides = c.slidesFor(copy, ["Sea facing from the 18th floor up", "Two lifts per wing"], "CAROUSEL");
  check("a carousel is a cover, a slide per point, and a close",
