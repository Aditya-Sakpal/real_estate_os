// ---------------------------------------------------------------------------
// The Project Brain.
//
// One object that the first reply, the voice qualifier, the CP bot, the quote
// generator and the egress validator all read from. What is decided here is
// everything that needs no tenant: parsing a typed value, hashing a group so
// a signature can go stale, and whether a draft may go live.
// ---------------------------------------------------------------------------

console.log("\nProject Brain: the field catalog");
check("every field belongs to a declared group",
  BRAIN_FIELDS.every((f) => FIELD_GROUPS.some((g) => g.key === f.group)), true);
check("no duplicate field keys",
  BRAIN_FIELDS.length, new Set(BRAIN_FIELDS.map((f) => f.key)).size);
// Three signatures, three permissions. One key for all three would let
// whoever holds it sign the price AND what may be claimed about the building,
// which is the arrangement the split exists to prevent.
check("each group is signed by a different permission",
  new Set(FIELD_GROUPS.map((g) => g.approves)).size, 3);
check("and the permission is looked up from the group",
  approverPermission("PRICE"), "brain.price:approve");
check("the possession date is a CLAIM, not a RERA fact",
  fieldByKey("claims.possession_date")?.group, "CLAIMS");
check("and the completion date is a RERA fact",
  fieldByKey("rera.declared_completion")?.group, "RERA");

console.log("\nProject Brain: reading a typed value");
check("an amount with Indian separators is a number",
  (parseValue("price.base_psf", "14,500") as { value: string }).value, "14500");
check("and so is one with a rupee prefix",
  (parseValue("price.base_psf", "Rs 14500") as { value: string }).value, "14500");
// The same number typed two ways must store the same, or a signature would
// expire every time somebody retyped it.
check("two spellings of one number store identically",
  (parseValue("price.base_psf", "1,25,00,000") as { value: string }).value,
  (parseValue("price.base_psf", "12500000") as { value: string }).value);
check("words are not an amount", parseValue("price.base_psf", "about 14k").ok, false);
check("an empty field is empty, not zero",
  (parseValue("price.base_psf", "") as { value: null }).value, null);
check("a date must be a real one", parseValue("rera.declared_completion", "2028-02-31").ok, false);
check("a day-first date is read, as India writes it",
  (parseValue("claims.possession_date", "31-12-2029") as { value: string }).value, "2029-12-31");
check("with a slash too",
  (parseValue("rera.declared_completion", "31/12/2028") as { value: string }).value, "2028-12-31");
check("a day-first date must be real too", parseValue("rera.declared_completion", "31-02-2028").ok, false);
check("anything else is refused", parseValue("rera.declared_completion", "Dec 2028").ok, false);
check("a good date passes",
  (parseValue("rera.declared_completion", "2028-12-31") as { value: string }).value, "2028-12-31");
check("a list drops blank lines",
  (parseValue("claims.never_say", "guaranteed returns\n\n  assured rental  ") as { value: string }).value,
  "guaranteed returns\nassured rental");
check("a field outside the catalog is refused", parseValue("price.invented", "1").ok, false);
check("a list reads back as items", asList("a\nb"), ["a", "b"]);
check("an empty list is empty, not one blank item", asList(null), []);
// Indian grouping, never the western one.
check("money is formatted in lakhs and crores", formatMoney("12500000"), "Rs 1,25,00,000");
check("a small amount still groups correctly", formatMoney("35000"), "Rs 35,000");
check("and three digits are left alone", formatMoney("500"), "Rs 500");

console.log("\nProject Brain: hashing a group");
const PRICED = { "price.base_psf": "14500", "price.booking_amount": "200000" };
check("the same values hash the same",
  groupHash("PRICE", PRICED), groupHash("PRICE", { ...PRICED }));
check("a changed value changes the hash",
  groupHash("PRICE", PRICED) === groupHash("PRICE", { ...PRICED, "price.base_psf": "14600" }),
  false);
check("an absent field and an empty one are the same thing",
  groupHash("PRICE", { "price.base_psf": "1" }),
  groupHash("PRICE", { "price.base_psf": "1", "price.booking_amount": null }));
// Lengths are in the canonical form so two fields cannot be run together to
// impersonate one: "ab" + "" must not hash as "a" + "b".
check("field boundaries cannot be forged",
  canonicalGroup("PRICE", { "price.base_psf": "ab", "price.booking_amount": "" }) ===
    canonicalGroup("PRICE", { "price.base_psf": "a", "price.booking_amount": "b" }),
  false);
check("a field from another group does not move this hash",
  groupHash("PRICE", PRICED),
  groupHash("PRICE", { ...PRICED, "claims.never_say": "anything" }));

console.log("\nProject Brain: whose signature still stands");
const SIGNED_PRICE = {
  group: "PRICE" as const,
  groupHash: groupHash("PRICE", PRICED),
  signedBy: "u1",
  signedByName: "Finance",
  signedAt: "2026-09-01T00:00:00.000Z",
};
const stateOf = (states: ReturnType<typeof groupStates>, g: string) =>
  states.find((s) => s.group === g)!;

const fresh = groupStates({ draft: PRICED, published: null, signatures: [SIGNED_PRICE] });
check("a group signed against these values reads as signed",
  stateOf(fresh, "PRICE").signed, true);
check("an untouched group reads as needing a signature",
  stateOf(fresh, "CLAIMS").required, true);

const afterEdit = groupStates({
  draft: { ...PRICED, "price.base_psf": "14600" },
  published: null,
  signatures: [SIGNED_PRICE],
});
check("editing after signing makes it stale", stateOf(afterEdit, "PRICE").stale, true);
check("and stale is not signed", stateOf(afterEdit, "PRICE").signed, false);
check("so it blocks publishing again", stateOf(afterEdit, "PRICE").required, true);
// The honest consequence of pinning a signature to a hash: put the values
// back and the original signature applies again, because that person really
// did sign exactly these values.
const reverted = groupStates({ draft: PRICED, published: null, signatures: [SIGNED_PRICE] });
check("putting the values back restores the signature",
  stateOf(reverted, "PRICE").signed, true);

// "Signatures follow the diff": a group identical to the live version is not
// re-signed, because nobody is being asked to attest to anything new.
const unchanged = groupStates({
  draft: PRICED,
  published: PRICED,
  signatures: [],
});
check("a group identical to the live version needs no new signature",
  stateOf(unchanged, "PRICE").required, false);
check("and says why", stateOf(unchanged, "PRICE").unchanged, true);

console.log("\nProject Brain: what may be signed at all");
// A signature over an empty required field is worse than no signature,
// because it looks exactly like a real one. The console once let somebody
// type a price, click sign, and have the signature taken against the last
// SAVED values, which on a fresh draft were none. The form was fixed; this
// is the rule that holds whatever the markup does next.
check("a group with its required field filled may be signed",
  canSignGroup("PRICE", { "price.base_psf": "14500" }).ok, true);
check("an empty required field cannot be signed",
  canSignGroup("PRICE", {}).ok, false);
check("and the refusal names the field",
  (canSignGroup("PRICE", {}) as { message: string }).message,
  "Base price per sq ft is still empty, so there is nothing to sign.");
// A tower that takes the project's price has a price. Asking it to type the
// same number again is how two copies of one price come to disagree.
check("a required field the project already answers is answered",
  canSignGroup("PRICE", {}, { "price.base_psf": "9500" }).ok, true);
check("a blank string counts as empty, not as a value",
  canSignGroup("PRICE", { "price.base_psf": "" }).ok, false);
check("RERA needs both of its required fields",
  canSignGroup("RERA", { "rera.registration_no": "P52100012345" }).ok, false);
check("and passes with both",
  canSignGroup("RERA", {
    "rera.registration_no": "P52100012345",
    "rera.declared_completion": "2030-03-31",
  }).ok, true);
// Deliberate: signing off "there are no special claims" is a real statement,
// and CLAIMS carries no required field.
check("a group with no required fields may be signed empty",
  canSignGroup("CLAIMS", {}).ok, true);

console.log("\nProject Brain: may this draft go live");
const FULL = {
  "price.base_psf": "14500",
  "rera.registration_no": "P52100012345",
  "rera.declared_completion": "2028-12-31",
  "claims.possession_date": "2029-06-30",
};
const signAll = (values: Record<string, string | null>) =>
  FIELD_GROUPS.map((g) => ({
    group: g.key,
    groupHash: groupHash(g.key, values),
    signedBy: "u1",
    signedByName: "Someone",
    signedAt: "2026-09-01T00:00:00.000Z",
  }));

check("a fully signed first version publishes",
  canPublishDraft({ draft: FULL, published: null, signatures: signAll(FULL) }).ok, true);
check("an unsigned one does not",
  (canPublishDraft({ draft: FULL, published: null, signatures: [] }) as { code: string }).code,
  "UNSIGNED");
check("a required field left blank refuses",
  (canPublishDraft({
    draft: { ...FULL, "rera.registration_no": null },
    published: null,
    signatures: signAll(FULL),
  }) as { code: string }).code,
  "FIELD_REQUIRED");
check("a draft identical to the live version has nothing to publish",
  (canPublishDraft({ draft: FULL, published: FULL, signatures: [] }) as { code: string }).code,
  "NOTHING_TO_PUBLISH");

// THE cross-group rule, and the reason marketing possession is a claim rather
// than a RERA fact: it is the brand approver's promise measured against the
// compliance officer's filing.
const EARLY = { ...FULL, "claims.possession_date": "2028-06-30" };
check("promising possession before the declared completion date is refused",
  (canPublishDraft({ draft: EARLY, published: null, signatures: signAll(EARLY) }) as { code: string }).code,
  "POSSESSION_BEFORE_COMPLETION");
check("and the refusal names both dates, as a person writes them",
  (canPublishDraft({ draft: EARLY, published: null, signatures: signAll(EARLY) }) as { message: string }).message,
  "Possession as marketed (30 June 2028) is before the completion date on the registration (31 December 2028).");
// The date a tower's advertisements print is the project's when the tower
// sets none, so that is the one measured against the tower's filing.
const NO_OWN_DATE = { ...FULL, "claims.possession_date": null };
check("a possession date the tower inherits is measured against its filing too",
  (canPublishDraft({
    draft: NO_OWN_DATE, published: null, signatures: signAll(NO_OWN_DATE),
    nodeKind: "PHASE", inherited: { "claims.possession_date": "2028-06-30" },
  }) as { code: string }).code,
  "POSSESSION_BEFORE_COMPLETION");
check("and the tower's own date wins over the project's",
  canPublishDraft({
    draft: FULL, published: null, signatures: signAll(FULL),
    nodeKind: "PHASE", inherited: { "claims.possession_date": "2028-06-30" },
  }).ok,
  true);
check("the possession rule stands alone, for signing as well as publishing",
  [possessionBeforeCompletion(EARLY, { nodeKind: "PHASE" }).ok,
    possessionBeforeCompletion(FULL, { nodeKind: "PHASE" }).ok,
    possessionBeforeCompletion(EARLY, { nodeKind: "PROJECT" }).ok],
  [false, true, true]);
check("an inherited price satisfies the required rule at publish",
  canPublishDraft({
    draft: { ...FULL, "price.base_psf": null }, published: null,
    signatures: signAll({ ...FULL, "price.base_psf": null }),
    nodeKind: "PHASE", inherited: { "price.base_psf": "9500" },
  }).ok,
  true);
check("dates are shown the way the console writes them",
  [brainDate("2029-06-30"), brainDate("2028-12-01"), brainDate("not a date"), brainDate(null)],
  ["30 June 2029", "1 December 2028", "not a date", ""]);
check("possession on the completion date itself is fine",
  canPublishDraft({
    draft: { ...FULL, "claims.possession_date": "2028-12-31" },
    published: null,
    signatures: signAll({ ...FULL, "claims.possession_date": "2028-12-31" }),
  }).ok,
  true);

// Changing one group re-opens that group and leaves the others alone. This is
// what stops a price correction from needing three signatures.
const REPRICED = { ...FULL, "price.base_psf": "15000" };
const partial = canPublishDraft({
  draft: REPRICED,
  published: FULL,
  signatures: [
    { group: "PRICE", groupHash: groupHash("PRICE", REPRICED), signedBy: "u1",
      signedByName: "Finance", signedAt: "2026-09-02T00:00:00.000Z" },
  ],
});
check("changing one group needs only that group signed", partial.ok, true);
check("and reports what changed", (partial as { changed: string[] }).changed, ["PRICE"]);

console.log("\nProject Brain: which groups a node actually has");
// RERA attaches to a PHASE, because each phase is a standalone registration
// under the explanation to Section 3. A project holding a registration
// number would be claiming something it cannot hold, and a required field
// forcing somebody to type one is asking them to invent it.
check("a phase has all three groups", groupsFor("PHASE").map((g) => g.key),
  ["PRICE", "RERA", "CLAIMS"]);
check("a project has no RERA group", groupsFor("PROJECT").map((g) => g.key),
  ["PRICE", "CLAIMS"]);
check("and neither does the org root", groupsFor("ORG").map((g) => g.key),
  ["PRICE", "CLAIMS"]);
check("so a project is never asked for a registration number",
  fieldsFor("PROJECT").some((f) => f.key === "rera.registration_no"), false);
// An exempt phase registers nothing. Its two required RERA fields could only
// be filled by inventing a registration, which is refused at publish, so an
// exempt tower could never publish at all.
check("an exempt phase has no RERA group", groupsFor("PHASE", true).map((g) => g.key),
  ["PRICE", "CLAIMS"]);
check("and is never asked for a registration number",
  fieldsFor("PHASE", true).some((f) => f.key.startsWith("rera.")), false);
const EXEMPT_DRAFT = { "price.base_psf": "9500", "claims.possession_date": "2027-03-31" };
const exemptSigs = groupsFor("PHASE", true).map((g) => ({
  group: g.key,
  groupHash: groupHash(g.key, EXEMPT_DRAFT),
  signedBy: "u1",
  signedByName: "Someone",
  signedAt: "2026-09-01T00:00:00.000Z",
}));
check("an exempt phase publishes on price and claims alone",
  canPublishDraft({ draft: EXEMPT_DRAFT, published: null, signatures: exemptSigs,
    nodeKind: "PHASE", exempt: true }).ok, true);
check("its RERA section is not waiting on anybody",
  groupStates({ draft: EXEMPT_DRAFT, published: null, signatures: exemptSigs, nodeKind: "PHASE", exempt: true })
    .some((s) => s.group === "RERA"), false);
check("and it is never measured against a filing it does not hold",
  matchesFiling({ draft: { ...EXEMPT_DRAFT, "rera.registration_no": "P52100012345" }, filed: null,
    nodeKind: "PHASE", exempt: true }).ok, true);

// The consequence that matters: a project publishes with price and claims
// alone, where before it demanded a registration it had no business holding.
const PROJECT_DRAFT = { "price.base_psf": "12500" };
const projectSigs = groupsFor("PROJECT").map((g) => ({
  group: g.key,
  groupHash: groupHash(g.key, PROJECT_DRAFT),
