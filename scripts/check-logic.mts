// ---------------------------------------------------------------------------
// The orphan sweep
// ---------------------------------------------------------------------------
{
  console.log("\norphan sweep");
  const S = await import("../src/lib/sweep-rules.ts");
  const org = "11111111-2222-4333-8444-555555555555";
  const now = new Date("2026-09-28T12:00:00Z");
  const old = new Date("2026-09-20T12:00:00Z");
  const key = (kind: string, id: string) => `org/${org}/${kind}/${id}`;

  check("a key's kind is its third segment", S.kindOf(key("asset", "a1"), org), "asset");
  check("another tenant's key has no kind here", S.kindOf(`org/99999999-2222-4333-8444-555555555555/asset/a1`, org), null);
  check("a key with nothing after the kind is not shaped like one", S.kindOf(`org/${org}/asset/`, org), null);

  const sorted = S.sortObjects({
    orgId: org,
    now,
    referenced: new Set([key("asset", "kept")]),
    objects: [
      { key: key("asset", "kept"), bytes: 10, modified: old },
      { key: key("asset", "gone"), bytes: 20, modified: old },
      { key: key("post", "p-0"), bytes: 30, modified: old },
      { key: key("asset", "fresh"), bytes: 40, modified: new Date("2026-09-28T02:00:00Z") },
      { key: key("brochure", "b1"), bytes: 50, modified: old },
      { key: key("asset", "undated"), bytes: 60, modified: new Date(Number.NaN) },
    ],
  });
  check("a referenced object is kept", sorted.referencedObjects, 1);
  check("an old unreferenced object of a known kind is an orphan", sorted.orphans.map((o) => o.key), [key("asset", "gone"), key("post", "p-0")]);
  check("one inside the grace period is not, and neither is one with no date", sorted.young, 2);
  check("a kind no column reads is never an orphan", sorted.unknown, { brochure: 1 });
  check("every byte is counted", sorted.bytes, 210);
  check("exactly at the grace edge is still young",
    S.sortObjects({ orgId: org, now, referenced: new Set(), objects: [{ key: key("asset", "edge"), bytes: 1, modified: new Date(now.getTime() - S.SWEEP_GRACE_HOURS * 3_600_000 + 1) }] }).young, 1);

  check("every kind the app writes is read by some column", ["asset", "backdrop", "post", "invoice"].every((k) => S.SWEPT_KINDS.has(k)), true);
  check("no rows at all against files is a broken read", S.refusalFor({ objects: 3, referencedKeys: 0, orphans: 3 }), "NOTHING_REFERENCED");
  check("a large share orphaned is refused", S.refusalFor({ objects: 40, referencedKeys: 28, orphans: 12 }), "TOO_MANY");
  check("a small share is not", S.refusalFor({ objects: 100, referencedKeys: 90, orphans: 12 }), null);
  check("a large share of very few is not a signal", S.refusalFor({ objects: 12, referencedKeys: 3, orphans: 9 }), null);
  check("nothing orphaned is never refused", S.refusalFor({ objects: 5, referencedKeys: 0, orphans: 0 }), null);

  const me = S.databaseId("7520611096454789296", "salesdesk");
  const them = S.databaseId("7610171897653500696", "salesdesk");
  check("a store nobody claimed is refused", S.ownerProblem(null, me), "UNCLAIMED");
  check("a store claimed by this database is not", S.ownerProblem(S.ownerMarker(me, now), me), null);
  check("a restored copy is a different database", S.ownerProblem(S.ownerMarker(them, now), me), "OTHER_DATABASE");
  check("a marker that does not parse is refused", S.ownerProblem("{not json", me), "UNREADABLE");
  check("and so is one naming no database", S.ownerProblem(JSON.stringify({ database: 42 }), me), "UNREADABLE");
  check("the marker sits outside every tenant's prefix", S.OWNER_KEY.startsWith("org/"), false);
}

// Reports: cost per outcome by campaign, creative and place, and the
// quarterly check on whether qualified leads book.
console.log("\nReports: roll-ups and the quarterly check");
{
  const P = await import("../src/lib/report-rules.ts");
  const c = (x: Partial<import("../src/lib/report-rules.ts").Counts>) => ({ ...P.ZERO, ...x });
  const row = (source: string, campaign: string, tower: string, counts: import("../src/lib/report-rules.ts").Counts, week = "2026-05-04") =>
    ({ week, source, project: "Sath Heights", campaign, creative: `${campaign}, image`, market: "Mumbai", tower, counts });
  const rows = [
    row("meta", "Launch", "Tower C", c({ spend: 60_000, leads: 100, qualified: 40, visited: 10, booked: 4 })),
    row("google", "Search", "Tower D", c({ spend: 30_000, leads: 30, qualified: 20, visited: 8, booked: 3 })),
    row("meta", "Festive", "Tower C", c({ spend: 20_000, leads: 40, qualified: 10, visited: 2, booked: 1 })),
    row("cp", "Partner network", "Tower C", c({ commission: 2_00_000, leads: 50, qualified: 30, visited: 20, booked: 6 })),
  ];
  const byCampaign = P.rollup(rows, "campaign");
  check("a partner booking never enters a media roll-up", byCampaign.map((r) => r.label), ["Search", "Launch", "Festive"]);
  check("ranked by cost per booking where there are enough bookings", [byCampaign[0].label, P.costPerBooking(byCampaign[0].c, "media")], ["Search", 10_000]);
  check("under the floor is never ranked above one that clears it", P.rankable(byCampaign[2].c), false);
  check("cost per lead, qualified lead and visit", [P.costPer(byCampaign[1].c, "leads"), P.costPer(byCampaign[1].c, "qualified"), P.costPer(byCampaign[1].c, "visited")], [600, 1_500, 6_000]);
  const byTower = P.rollup(rows, "tower");
  check("a tower adds up every campaign that bought it", byTower.find((r) => r.label === "Tower C")?.c.spend, 80_000);
  check("a city is the sum of its towers", P.rollup(rows, "market")[0].c.booked, 8);

  check("the last full quarter, from the end of September, is April to June",
    P.lastFullQuarter("2026-09-28"), { from: "2026-04-01", to: "2026-06-30", label: "Apr to Jun 2026" });
  check("in February it is October to December of the year before", P.lastFullQuarter("2026-02-10").label, "Oct to Dec 2025");
  const q = P.quarterCheck([
    row("meta", "Launch", "Tower C", c({ leads: 200, qualified: 60, booked: 6 })),
    row("google", "Search", "Tower D", c({ leads: 100, qualified: 40, booked: 5 })),
    row("meta", "Festive", "Tower C", c({ leads: 120, qualified: 50, booked: 1 })),
    row("meta", "Small", "Tower C", c({ leads: 10, qualified: 5, booked: 0 })),
    row("meta", "Launch", "Tower C", c({ leads: 999, qualified: 999, booked: 0 }), "2026-08-03"),
  ], "2026-09-28");
  check("only the quarter's lead weeks count", q.lines.find((l) => l.campaign === "Launch")?.leads, 200);
  check("a campaign whose qualified leads book under half as often is named first",
    [q.lines[0].campaign, q.lines[0].verdict], ["Festive", "RARELY_BOOKS"]);
  check("one with too few qualified leads is not judged", q.lines.find((l) => l.campaign === "Small")?.verdict, "TOO_FEW");
  check("the rest book as expected", q.lines.filter((l) => l.verdict === "BOOKS").map((l) => l.campaign).sort(), ["Launch", "Search"]);
}

// Budget: tired creatives and ads worth a person's look.
console.log("\nBudget: tired creatives and pause proposals");
{
  const B = await import("../src/lib/budget-rules.ts");
  const perf = (id: string, spendRs: number, qualified: number, extra: Partial<import("../src/lib/budget-rules.ts").AdPerf> = {}) => ({
    targetId: id, dailyBudget: 1000, cap: 5000, spendPaise: spendRs * 100, clicks: 100, leads: qualified * 3, qualified,
    liveDays: 7, lastShiftAt: null, ...extra,
  });
  const week = (from: number, clicks: number) =>
    Array.from({ length: 7 }, (_, i) => ({ day: `2026-09-${String(from + i).padStart(2, "0")}`, impressions: 1000, clicks }));
  check("click rate halving from the first week is a 50% fall", B.ctrFall([...week(1, 20), ...week(8, 10)]), 0.5);
  check("under two weeks live there is no baseline yet", B.ctrFall(week(1, 20)), null);
  check("too few impressions are not a click rate", B.ctrFall([...week(1, 20), ...week(8, 10)].map((d) => ({ ...d, impressions: 100 }))), null);
  const group = [perf("A", 7000, 0), perf("B", 7000, 5), perf("C", 7000, 5)];
  const h = (ad: ReturnType<typeof perf>, frequency: number | null, days = week(1, 20)) => B.adHealth({ ad, group, days, frequency });
  check("frequency at 3.5 or more: a new creative is due", h(group[1], 3.6).refresh, "DUE");
  check("at 3.0: it is watched", h(group[1], 3.1).refresh, "WATCH");
  check("a 20% fall in clicks alone is watched", h(group[1], 1.2, [...week(1, 20), ...week(8, 15)]).refresh, "WATCH");
  check("fresh and clicking: nothing", h(group[1], 1.2).refresh, null);
  check("an ad with no result at twice what a result costs the group is proposed for a pause", h(group[0], null).pause, true);
  check("one bringing buyers is not", h(group[1], null).pause, false);
  check("never on too little spend", B.adHealth({ ad: perf("A", 700, 0), group: [perf("A", 700, 0), perf("B", 7000, 5), perf("C", 7000, 5)], days: [], frequency: null }).pause, false);
  check("never without two others ready to compare with", B.adHealth({ ad: group[0], group: group.slice(0, 2).map((g, i) => (i === 1 ? { ...g, liveDays: 1 } : g)), days: [], frequency: null }).pause, false);
}

