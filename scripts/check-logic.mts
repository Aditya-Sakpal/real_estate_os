      interaction_transcript: said(["agent", "Am I speaking with Nannhe?"], ["user", "Hello."], ["agent", "Hello?"], ["user", "Hello."]) }).outcome,
    R.readWebhook({ status: "connected", final_agent_variables: { lead_disposition: "cold_lead" },
