check("two @ signs are refused", looksLikeEmail("a@b@billbay.com"), false);
check("whitespace is refused", looksLikeEmail("ravi @billbay.com"), false);
check("a real one passes", looksLikeEmail("ravi@billbay.com"), true);
// Stored, and one day exported: a leading formula character is a spreadsheet
