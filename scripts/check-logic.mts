  "NOT_YOURS_TO_GIVE");
check("and the refusal names what is missing, in words",
  (checkGrant({ ...HEAD_AT_PUNE, role: PSM, target: TREES }) as { message: string }).message.includes(
    "See real phone numbers"),
  true);
check("the same head holding everything it does may give it",
  checkGrant({ ...HEAD_AT_PUNE, inviterHeld: permSet(...PSM.permissions, "member:invite"), role: PSM, target: TREES }).ok,
  true);
check("a role with nothing extra is always theirs to give",
