  check("no account chosen yet: it waits", [plan({ connected: false }).state, plan({ connected: false }).reason], ["WAITING", "NOT_CONNECTED"]);
  check("Meta is never sent anything past six days (the batch would fail)", plan({ occurredAt: "2026-09-21T00:00:00Z", leadCreatedAt: "2026-09-01T00:00:00Z" }).reason, "TOO_OLD");
  check("a held booking goes to Meta dated when the hold ended",
