  check("and so does a line that is not there", typo(["Book a site visit this weekened"]).map((p: { soft?: boolean }) => !!p.soft), [false]);
  check("a slip is a letter or two, never a word", [c.nearLine("book a site visit this weekend", "book a site visit this weekened"),
    c.nearLine("book a site visit next month", "book a site visit this weekened")], [true, false]);
  check("an invented price fails", judge({ texts: [...good.texts, "Only Rs 45 lakh"] }), ["EXTRA_TEXT"]);
  check("nor is an invented price hidden in a familiar line",
    judge({ texts: [...good.texts, "Sea facing homes from Rs 45 lakh"] }), ["EXTRA_TEXT"]);
  check("a signed talking point is not an invention", judge({ texts: [...good.texts, "Sea facing from the 18th floor up"] }), []);
  // Site photos carry crane marks and safety boards; those must not burn a carousel.
