  const p2 = J.planAggregate(spec({ measures: ["spend", "visits"], by: ["call_agent"] }) as never, all, now);
  check("a grouping one side lacks is refused with what to do", !p2.ok && p2.message.includes("cannot group"), true);
  const p3 = J.planAggregate(spec({ measures: ["leads"], filters: [{ field: "stage", op: "is", values: ["Visit scheduled"] }] }) as never, all, now);
  check("a filter value is read by its label as well as its key", p3.ok && p3.plan.filters[0].values, ["visit_scheduled"]);
  const p4 = J.planAggregate(spec({ measures: ["leads"], filters: [{ field: "stage", op: "is", values: ["hot"] }] }) as never, all, now);
  check("a value the list does not hold is refused, naming the list", !p4.ok && p4.message.includes("new, contacted"), true);
  const p5 = J.planAggregate(spec({ measures: ["leads"], filters: [{ field: "tower", op: "is", values: ["Tower C"] }] }) as never, all, now);
  check("a tower goes in places, not in a filter", !p5.ok && p5.message.includes("places"), true);
  const p6 = J.planAggregate(spec({ measures: ["spend"] }) as never, J.visibleFor(["ads"], exec), now);
  check("a measure somebody may not see is refused as no access", !p6.ok && p6.message.includes("no_access"), true);
  const p7 = J.planAggregate(spec({ measures: ["post_slots"] }) as never, all, now);
  check("scheduled posts default to the next seven days", p7.ok && p7.plan.parts[0].range?.label, "the next 7 days (Sat 26 Sep to Fri 2 Oct)");

  // The SQL: text from the map, values as parameters, the scope always there.
  const sPlan = J.planAggregate(
    spec({ measures: ["leads"], filters: [{ field: "source", op: "is", values: ["x'; DROP TABLE leads; --"] }] }) as never,
    J.visibleFor(["leads"], sales),
    now,
  );
  const q = sPlan.ok ? J.aggregateSql(sPlan.plan.parts[0], sPlan.plan, "org-1", null) : null;
  check("a value never enters the statement's text",
    !!q && !q.text.includes("DROP TABLE") && JSON.stringify(q.params).includes("drop table leads"), true);
  check("the person's scope is always a condition", !!q && q.text.includes("n.path <@ ANY(") && JSON.stringify(q.params).includes("o.e.r.p.c"), true);

  // Merging: a group one side lacks is a zero, not a missing row.
  if (p1.ok) {
    const merged = J.mergeParts(p1.plan, [
      [{ d0: "Diwali", m0: "4500" }],
      [{ d0: "Diwali", m0: "2" }, { d0: null, m0: "5" }],
    ]);
    check("spend beside visits keeps each side's own total per group",
      merged.rows.map((r) => [r.dims[0], r.values.spend, r.values.visits]), [["Diwali", 4500, 2], [null, 0, 5]]);
    check("and the total is each side's own sum", [merged.total?.spend, merged.total?.visits], [4500, 7]);
  }

  // Periods, in IST, weeks from Monday.
  const per = (preset: string, from: string | null = null, to: string | null = null) => {
    const r = J.resolvePeriod({ preset, from, to }, now);
    return r.ok && r.range ? [r.range.fromIso, r.range.toIso] : r.ok ? null : "refused";
  };
  check("today is the IST day", per("today"), ["2026-09-26", "2026-09-27"]);
  check("this week starts on Monday", per("this_week"), ["2026-09-21", "2026-09-28"]);
  check("last month is the whole of August", per("last_month"), ["2026-08-01", "2026-09-01"]);
  check("the last 7 days include today", per("last_7_days"), ["2026-09-20", "2026-09-27"]);
  check("a custom range includes its last day", per("custom", "2026-09-01", "2026-09-10"), ["2026-09-01", "2026-09-11"]);
  check("a custom range backwards is refused", per("custom", "2026-09-10", "2026-09-01"), "refused");
  const late = J.resolvePeriod({ preset: "today", from: null, to: null }, new Date("2026-09-26T18:00:00Z"));
  check("half past eleven at night IST is still that day", late.ok && late.range?.fromIso, "2026-09-26");

  // Places.
  const nodes = [
    { id: "p", kind: "PROJECT" as const, name: "Sath Heights", slug: "sath", path: "o.e.r.sath", projectId: "p", projectName: "Sath Heights" },
    { id: "c", kind: "PHASE" as const, name: "Tower C", slug: "tower_c", path: "o.e.r.sath.tower_c", projectId: "p", projectName: "Sath Heights" },
    { id: "d", kind: "PHASE" as const, name: "Phase 1", slug: "phase_1", path: "o.e.r.sath.phase_1", projectId: "p", projectName: "Sath Heights" },
    { id: "t", kind: "PROJECT" as const, name: "Trees", slug: "trees", path: "o.e.r.trees", projectId: "t", projectName: "Trees" },
    { id: "e", kind: "PHASE" as const, name: "Phase 1", slug: "phase_1", path: "o.e.r.trees.phase_1", projectId: "t", projectName: "Trees" },
  ];
  const place = (names: string[], scopes: string[]) => {
    const r = J.resolvePlaces(names, nodes, scopes);
    return r.ok ? r.labels : r.message.includes("more than one") ? "ambiguous" : "not found";
  };
  check("a tower is found by its name", place(["tower c"], ["o"]), ["Sath Heights · Tower C"]);
  check("two towers sharing a name are asked back", place(["Phase 1"], ["o"]), "ambiguous");
  check("the project's name settles which", place(["Trees Phase 1"], ["o"]), ["Trees · Phase 1"]);
  check("a tower outside a person's reach is not found", place(["Phase 1"], ["o.e.r.sath.tower_c"]), "not found");
  check("the project their tower sits in is", place(["Sath Heights"], ["o.e.r.sath.tower_c"]), ["Sath Heights"]);
  check("a name a letter off is the place it means", place(["seth heights tower c"], ["o"]), ["Sath Heights · Tower C"]);
  check("but a tower that is not there is never guessed", place(["Tower Z"], ["o"]), "not found");
  check("a part of a project's name that its towers carry too is the project", place(["Sath"], ["o"]), ["Sath Heights"]);
  {
    const cities = [{ name: "Mumbai", path: "o.e.r" }, { name: "Pune", path: "o.e2.pune" }, { name: "Pune", path: "o.e3.pune" }];
    const city = J.resolvePlaces(["pune"], nodes, ["o"], cities);
    check("a city is every place in it, across entities", city.ok ? [city.paths, city.labels] : city.message, [["o.e2.pune", "o.e3.pune"], ["Pune"]]);
    const away = J.resolvePlaces(["Pune"], nodes, ["o.e.r.sath.tower_c"], cities);
    check("a city nobody gave this person is not found", away.ok, false);
  }
  // Told only "ask which one they mean", the analyst offered a tower that
  // does not exist, and asked three times.
  const missing = J.resolvePlaces(["Tower Z"], nodes, ["o.e.r.sath"]);
  check("a place that is not there lists the real ones",
    !missing.ok && missing.message.includes("Sath Heights · Tower C") && missing.message.includes("offer only these"), true);
  check("and only the ones this person can see",
    !missing.ok && !missing.message.includes("Trees"), true);
  check("an option naming a tower that is not there is refused",
    J.strayPlaceOptions(["Sath Heights · Tower Z", "Sath Heights · Tower C", "Tower C", "Leads this week"], nodes, ["o.e.r.sath"]),
    ["Sath Heights · Tower Z"]);
  check("and so is one naming a project out of reach",
    J.strayPlaceOptions(["Trees", "I meant a different tower, I will type it"], nodes, ["o.e.r.sath"]), ["Trees"]);
  {
    const ds = (k: string) => J.DATASETS.find((d) => d.key === k)!;
    // "Most qualified right now" answered 100 where the board said 13: the
