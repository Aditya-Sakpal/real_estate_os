// ---------------------------------------------------------------------------
// Leads. A stage is a set of facts, so every one of the 81 moves is answered
// by the same four rules rather than by a table of pairs. Walking all of them
// is cheap and is the only way to know none was forgotten.
// ---------------------------------------------------------------------------
console.log("\nLeads: every move between two stages");
{
  const L = await import("../src/lib/lead-rules.ts");
  type Lead = import("../src/lib/lead-rules.ts").LeadState;
  type Plan = import("../src/lib/lead-rules.ts").MovePlan;
  type Key = import("../src/lib/lead-rules.ts").FieldKey;
  type StageKey = import("../src/lib/lead-rules.ts").StageKey;

  const TODAY = "2026-09-23";
  const TEAM = ["Nikhil Rao", "Asha Menon"];
  const ALL: StageKey[] = [...L.PATH, ...L.SIDE];

  // A value the rules accept, given where the lead is headed.
  const valid = (k: Key, to: StageKey): string =>
    ({
      contactChannel: "WhatsApp",
      contactedOn: L.addDays(TODAY, -9),
      config: "2 BHK",
      budget: "Rs 60 to 90 lakh",
      timeline: "1 to 3 months",
      owner: TEAM[0],
      visitDate: to === "visit_scheduled" ? L.addDays(TODAY, 3) : L.addDays(TODAY, -3),
      visitTime: "11:00",
      visitHost: TEAM[1],
      interest: "Hot",
      objection: "Price",
      unit: "C-1203",
      quote: "7630000",
      bookedOn: L.addDays(TODAY, -1),
      agreement: "7500000",
      token: "500000",
    })[k];

  const fill = (plan: Plan) => ({
    facts: Object.fromEntries(
      plan.sections.flatMap((s) => s.fields).map((k) => [k, valid(k, plan.to)]),
    ),
    reason: plan.reason?.options[0],
    followUp: plan.followUp ? L.addDays(TODAY, 7) : undefined,
  });

  const move = (lead: Lead, to: StageKey) => {
    const plan = L.planMove(lead, to, TODAY, TEAM);
    return L.applyMove(lead, plan, fill(plan));
  };

  // A lead standing in `s`, built by the same moves a person would make.
  // Side lanes are entered from Visit done, so they carry real history.
  const at = (s: StageKey): Lead => {
    const fresh: Lead = { stage: "new", pathStage: "new", facts: {} };
    if (s === "new") return fresh;
    const onPath = move(fresh, L.isPath(s) ? s : "visit_done");
    return L.isPath(s) ? onPath : move(onPath, s);
  };

  const problems: string[] = [];
  let moves = 0;
  for (const from of ALL) {
    for (const to of ALL) {
      const lead = at(from);
      const plan = L.planMove(lead, to, TODAY, TEAM);
      const tag = `${from} -> ${to}`;
      if (from === to) {
        if (plan.kind !== "none" || plan.needsDialog) problems.push(`${tag}: not a no-op`);
        continue;
      }
      moves++;

      const asked = plan.sections.flatMap((s) => s.fields);
      const empty = L.validateMove(plan, lead, { facts: {} }, TODAY, TEAM);
      const expected = asked.length + (plan.reason ? 1 : 0) + (plan.followUp ? 1 : 0);
      if (Object.keys(empty).length !== expected) problems.push(`${tag}: an empty dialog passed something`);

      const input = fill(plan);
      const errs = L.validateMove(plan, lead, input, TODAY, TEAM);
      if (Object.keys(errs).length) problems.push(`${tag}: valid answers refused ${JSON.stringify(errs)}`);

      const after = L.applyMove(lead, plan, input);
      if (after.stage !== to) problems.push(`${tag}: landed in ${after.stage}`);
      const fit = L.factsFit(after);
      if (fit.missing.length) problems.push(`${tag}: missing ${fit.missing}`);
      if (fit.extra.length) problems.push(`${tag}: kept ${fit.extra}`);

      if (plan.kind === "back" && !plan.reason) problems.push(`${tag}: back without a reason`);
      if (plan.kind === "forward" && plan.reason) problems.push(`${tag}: forward asked why`);
      if ((plan.kind === "exit" || plan.kind === "switch") && !plan.reason) {
        problems.push(`${tag}: left without a reason`);
      }
      if (from === "booked" && !plan.cancelsBooking) problems.push(`${tag}: booking not cancelled`);
      if (from === "booked" && (after.facts.agreement || after.facts.token)) {
        problems.push(`${tag}: booking survived`);
      }
      if (to === "nurture" && !after.exit?.followUp) problems.push(`${tag}: nurture with no date`);
      if (L.isPath(to) && after.exit) problems.push(`${tag}: still marked as left`);

      // Nothing is asked twice once it is answered: the same move again is free.
      if (L.isPath(to)) {
        const again = L.planMove({ ...after, stage: from }, to, TODAY, TEAM);
        if (again.sections.length) problems.push(`${tag}: asks again after answering`);
      }
    }
  }
  check("all 72 moves between different stages were walked", moves, 72);
  check("and every one of them keeps the rules", problems, []);

  const booked = at("booked");
  check("New to Booked asks for every stage in between",
    L.planMove(at("new"), "booked", TODAY, TEAM).sections.map((s) => s.stage),
    ["contacted", "qualified", "visit_scheduled", "visit_done", "negotiation", "booked"]);
  check("and says how many it skipped",
    L.planMove(at("new"), "booked", TODAY, TEAM).skipped, 5);
  check("one stage ahead skips none",
    L.planMove(at("qualified"), "visit_scheduled", TODAY, TEAM).skipped, 0);

  const upcoming = at("visit_scheduled");
  check("an upcoming visit is asked again once it is marked done",
    L.planMove(upcoming, "visit_done", TODAY, TEAM).sections.map((s) => s.fields),
    [["visitDate"], ["interest", "objection"]]);
  check("moving back to Visit scheduled asks for a new date, and only that",
    L.planMove(at("visit_done"), "visit_scheduled", TODAY, TEAM).sections.map((s) => s.fields),
    [["visitDate"]]);
  {
    const back = L.planMove(at("visit_done"), "visit_scheduled", TODAY, TEAM, "23:00");
    check("a visit moved to today at a time already gone is refused on the date asked for",
      L.validateMove(back, at("visit_done"), { facts: { visitDate: TODAY }, reason: back.reason?.options[0] }, TODAY, TEAM, "23:00").visitDate,
      "That time has passed today. Pick a later day");
    const fresh = L.planMove(at("qualified"), "visit_scheduled", TODAY, TEAM, "12:45");
    const at1000 = L.validateMove(fresh, at("qualified"), { facts: { visitDate: TODAY, visitTime: "10:00", visitHost: TEAM[0] } }, TODAY, TEAM, "12:45");
    check("a visit booked for earlier today is refused", at1000.visitTime, "Pick a later time today");
    check("and a later slot today is fine",
      L.validateMove(fresh, at("qualified"), { facts: { visitDate: TODAY, visitTime: "13:00", visitHost: TEAM[0] } }, TODAY, TEAM, "12:45").visitTime, undefined);
    check("with no clock (a pinned day), today's slots are not judged",
      L.validateMove(fresh, at("qualified"), { facts: { visitDate: TODAY, visitTime: "10:00", visitHost: TEAM[0] } }, TODAY, TEAM).visitTime, undefined);
  }
  check("and removes the visit feedback",
    L.planMove(at("visit_done"), "visit_scheduled", TODAY, TEAM).clears, ["visit_done"]);
  check("Negotiation back to Qualified removes the visit and the quote",
    L.planMove(at("negotiation"), "qualified", TODAY, TEAM).clears,
    ["visit_scheduled", "visit_done", "negotiation"]);
  check("back from Visit scheduled asks why, with visit reasons",
    L.planMove(upcoming, "qualified", TODAY, TEAM).reason?.options.includes("Buyer cancelled the visit"),
    true);
  check("leaving Booked asks for a cancellation reason",
    L.planMove(booked, "lost", TODAY, TEAM).reason?.label, "Why was the booking cancelled?");
  check("a lost lead reopened where it left needs nothing",
    L.planMove(at("lost"), "visit_done", TODAY, TEAM).needsDialog, false);
  check("and reopened further on asks only for what is new",
    L.planMove(at("lost"), "booked", TODAY, TEAM).sections.map((s) => s.stage),
    ["negotiation", "booked"]);

  const facts = { ...booked.facts, agreement: "7500000" };
  check("a token over ten per cent is refused",
    L.fieldError("token", { ...facts, token: "800000" }, "booked", TODAY, TEAM)?.includes("10%"), true);
  check("exactly ten per cent is allowed",
    L.fieldError("token", { ...facts, token: "750000" }, "booked", TODAY, TEAM), null);
  check("a booking before the visit is refused",
    L.fieldError("bookedOn", { ...facts, bookedOn: L.addDays(facts.visitDate!, -1) }, "booked", TODAY, TEAM),
    "Can't be before the site visit");
  check("a quote typed in lakh is refused",
    L.fieldError("quote", { quote: "76" }, "negotiation", TODAY, TEAM), "Enter the full amount in rupees");
  check("an upcoming visit cannot be yesterday",
    L.fieldError("visitDate", { visitDate: L.addDays(TODAY, -1) }, "visit_scheduled", TODAY, TEAM),
    "Pick today or a later date");
  check("today counts as upcoming",
    L.fieldError("visitDate", { visitDate: TODAY }, "visit_scheduled", TODAY, TEAM), null);
  check("somebody not on the team cannot host",
    L.fieldError("visitHost", { visitHost: "Stranger" }, "visit_scheduled", TODAY, TEAM), "Choose one");
  check("nurture needs a date after today",
    L.validateMove(L.planMove(upcoming, "nurture", TODAY, TEAM), upcoming,
      { facts: {}, reason: "No-show", followUp: TODAY }, TODAY, TEAM).followUp,
    "Pick a date after today");
  check("a stale tab's reason is refused",
    L.validateMove(L.planMove(upcoming, "lost", TODAY, TEAM), upcoming,
      { facts: {}, reason: "Because" }, TODAY, TEAM).reason,
    "Choose a reason");

  // The sample board is built by hand, so it is held to the same rules: a
  // sample lead that broke them would open a dialog asking for its own facts.
  const S = await import("../src/lib/lead-sample.ts");
  const samples = S.sampleLeads(TODAY);
  check("every sample lead holds exactly its stage's facts",
    samples.filter((l) => {
      const fit = L.factsFit(l);
      return fit.missing.length || fit.extra.length;
    }).map((l) => l.id), []);
  check("and every one on the path holds them validly",
