// The client was asked to press "write it again" until the model got it
// right. The model's mistakes are now corrected before anybody sees a card,
// and only what a person can fix is shown to a person.
console.log("\nCampaign Studio: the model's mistakes are ours to correct");
{
  const m = await import("../src/lib/creative-rules.ts");
  const r = (code: string, detail = "") => ({ code, detail }) as never;

  check("a card too long is rewritten", m.needsRewrite([r("OVER_LENGTH")]), true);
  check("so is one off the approved points", m.needsRewrite([r("NO_TALKING_POINT")]), true);
  check("so is an invented amount", m.needsRewrite([r("UNGROUNDED_MONEY")]), true);
  // A typeface that cannot set Tamil still cannot on the third attempt, and
  // an attempt that changes nothing still costs money.
  check("a card held by the retired typeface rule is written again", m.needsRewrite([r("NO_FACE_FOR_LANGUAGE")]), true);
  check("nor a registration about to lapse", m.needsRewrite([r("REGISTRATION_EXPIRING")]), false);
  check("a person is shown only what a rewrite cannot clear",
    m.forAPerson([r("OVER_LENGTH"), r("REGISTRATION_EXPIRING")]).map((x: { code: string }) => x.code),
    ["REGISTRATION_EXPIRING"]);
  check("three attempts, no more", m.MAX_WRITE_ATTEMPTS, 3);

  const fail2 = { verdict: "FAIL" as const, reasons: [r("A"), r("B")] };
  const fail1 = { verdict: "FAIL" as const, reasons: [r("A")] };
  const hold = { verdict: "HOLD" as const, reasons: [r("C")] };
  // A third attempt worse than the second is a thing models do, so the best
  // is kept rather than the last.
  check("a cleaner verdict wins", m.betterAttempt(fail1, hold), hold);
  check("and is not given up for a worse later one", m.betterAttempt(hold, fail1), hold);
  check("between two refusals, the one with fewer reasons", m.betterAttempt(fail2, fail1), fail1);

  const fb = m.feedbackFor(
    { headline: "Metro & Connectivity", body: "x".repeat(92), cta: "Book" },
    [r("OVER_LENGTH", "Body is 92 characters against the 90 that Google display allows."),
     r("NO_TALKING_POINT", "The headline leads on nothing in the approved talking points."),
     r("REGISTRATION_EXPIRING", "The registration runs out in 20 days.")],
  );
  check("the rewrite is told the exact number and limit",
    fb.includes("Body is 92 characters against the 90 that Google display allows."), true);
  check("and told how to fix a headline, not just that it was wrong",
    fb.includes("Start the headline with one of the approved facts"), true);
  check("and is not told about what it cannot change", fb.includes("registration"), false);
  check("and sees what it wrote last time", fb.includes("Metro & Connectivity"), true);

  // Telling the writer to lead with a hook nobody approved, then refusing
  // every headline that did, was the system contradicting itself.
  const points = ["Sea facing from the 18th floor up"];
  check("an approved hook is what the writer leads with",
    m.leadLine("sea facing from the 18th floor up", points), "Lead with: sea facing from the 18th floor up");
  check("an unapproved one is never passed on",
    m.leadLine("Metro and connectivity", points), "Lead the headline with one of the approved facts below.");
  check("and no hook leads on the approved facts too",
    m.leadLine(null, points), "Lead the headline with one of the approved facts below.");
  // With nothing approved the hook was passed on as the lead, and every card
  // came back "Family Homes Near Schools".
  check("with no approved points the writer is never told to lead with the hook",
    [m.leadLine("Near schools", []), m.leadLine(null, [])], [null, null]);
  check("and nothing is written at all: there is no selling point",
    [hasSellingPoint({ talkingPoints: [] }), hasSellingPoint({ talkingPoints: ["Two lifts per wing"] }),
     hasSellingPoint({ talkingPoints: ["Sea facing from the 18th floor up"] })], [false, false, true]);
  check("which says what to do about it", NO_POINTS_MESSAGE,
    "Add at least one approved selling point to this project's facts first.");
  check("the body says how it connects only from an approved fact that says so",
    [connectivityPoint(["Sea facing from the 18th floor up"]),
     connectivityPoint(["Sea facing from the 18th floor up", "Eight minutes from Goregaon station"]),
     connectivityPoint(["Two minutes from Worli metro station", "Five minutes to the Coastal Road"], { luxury: true })],
    [null, "Eight minutes from Goregaon station", "Five minutes to the Coastal Road"]);
  check("advice with no approved points sends a person to the facts, not to the hook",
    m.adviceFor("NO_TALKING_POINT", { node: "Tower C", hook: "Near schools", talkingPoints: [], details: [] }).change,
    "Add at least one selling point to Tower C's facts and get it approved.");
}

// ---------------------------------------------------------------------------
// Posts. The building is never drawn, the lockup sits top right at least as
// large as the phone number, and a render says so.
// ---------------------------------------------------------------------------
console.log("\nPosts: kinds, sizes and where things go");
{
  const c = await import("../src/lib/compose-rules.ts");
  const t = await import("../src/lib/template-rules.ts");
  const BRIEF = ["Meta feed 1:1", "Meta reel 9:16", "Google display", "Portal listing"];
  check("an image goes to every still format the brief asked for",
    c.placementsFor("IMAGE", BRIEF), ["Meta feed 1:1", "Google display", "Portal listing"]);
  check("a carousel only to the square feed", c.placementsFor("CAROUSEL", BRIEF), ["Meta feed 1:1"]);
  check("a video only to the moving formats", c.placementsFor("VIDEO", BRIEF), ["Meta reel 9:16"]);
  check("a kind the brief has no format for is refused, and says why",
    c.kindUnavailable("VIDEO", ["Meta feed 1:1"])?.startsWith("The brief has none of the formats"), true);
  check("and one it has is not", c.kindUnavailable("IMAGE", BRIEF), null);

  // MahaRERA's order, by construction, in every size this product makes.
  const sizes = Object.entries(c.PLACEMENT_SIZE);
  check("the lockup is top right in every size",
    sizes.filter(([, s]) => !c.keepsReraRules(c.layoutFor(s.w, s.h))).map(([p]) => p), []);
  check("and the number is never smaller than the phone number",
    sizes.every(([, s]) => { const l = c.layoutFor(s.w, s.h); return l.regSize >= l.contactSize; }), true);
  check("the copy never starts inside the lockup",
    sizes.every(([, s]) => { const l = c.layoutFor(s.w, s.h); return l.text.y >= l.lockup.y + l.lockup.h; }), true);

  const P = (id: string, category: string, isRender = true) =>
    ({ assetId: id, sha256: id.repeat(8), category, isRender, title: null });
  const lib = [P("a", "AMENITY"), P("b", "EXTERIOR_RENDER"), P("c", "FLOOR_PLAN"),
    P("d", "RERA_LOCKUP"), P("e", "SAMPLE_FLAT", false), P("f", "EXTERIOR_RENDER"),
