// An agent's voice: what a plan opens, what a pick may be, and which copy calls.
{
  const AC = await import("../src/lib/agent-catalog.ts");
  const VA = await import("../src/lib/voice-apps-rules.ts");
  check("Launch opens three voices, Growth seven, Scale all thirteen, and the recommended one is on Launch",
    [(["LAUNCH", "GROWTH", "SCALE"] as const).map((p) => AC.VOICE_KEYS.filter((v) => AC.voiceOpen(v, p, true)).length),
     AC.VOICE_KEYS.filter((v) => AC.voiceOpen(v, "LAUNCH", true)),
     AC.VOICE_CARDS.filter((v) => v.recommended).map((v) => [v.key, AC.VOICE_PLAN[v.key]])],
    [[3, 7, 13], ["zarina", "advait", "priya"], [["zarina", "LAUNCH"]]]);
  check("every voice has a card, a plan and a sample", AC.VOICE_KEYS.every((k) => AC.voiceCard(k)?.sample === `/voices/voice-${k}.mp3` && !!AC.VOICE_PLAN[k]), true);
  check("an organisation with no plan sold has every voice; a billed project with none has none",
    [AC.VOICE_KEYS.every((v) => AC.voiceOpen(v, null, false)), AC.VOICE_KEYS.some((v) => AC.voiceOpen(v, null, true))], [true, false]);
  check("a voice the plan does not open is refused with the plan that opens it",
    AC.voicePickProblem({ job: "QUALIFIER", voice: "ritu", plan: "GROWTH", billed: true, ready: true }), "Ritu unlocks on Scale.");
  check("a voice with no copy set up is refused, the agent's own voice never",
    [AC.voicePickProblem({ job: "QUALIFIER", voice: "priya", plan: "SCALE", billed: true, ready: false }),
     AC.voicePickProblem({ job: "QUALIFIER", voice: "advait", plan: "SCALE", billed: true, ready: false })],
    ["Priya is not ready for the Lead Qualifier yet.", null]);
  check("an agent the plan does not carry cannot be given a voice",
    AC.voicePickProblem({ job: "POST_VISIT", voice: "priya", plan: "LAUNCH", billed: true, ready: true }) !== null, true);
  check("the receptionist's voice is fixed",
    AC.voicePickProblem({ job: "RECEPTIONIST", voice: "advait", plan: "SCALE", billed: true, ready: true }), "This agent's voice cannot be changed.");
  check("an agent speaks its picked voice, else its own",
    [AC.voiceIn(AC.agentCard("QUALIFIER")!, { QUALIFIER: "priya" }), AC.voiceIn(AC.agentCard("REENGAGER")!, {}), AC.voiceIn(AC.agentCard("RECEPTIONIST")!, { RECEPTIONIST: "priya" } as never)],
    ["priya", "shubh", "advait"]);
  check("every choosable agent has a sample in every voice",
    AC.AGENT_CARDS.filter((a) => a.choosable).every((a) => AC.VOICE_KEYS.every((v) => /^\/voices\/agent-[a-z]+-[a-z]+\.mp3$/.test(AC.sampleFor(a, v) ?? ""))), true);

  const map = VA.readVoiceApps('{"base-1234":{"priya":"copy-5678@2","ritu":"bad id!@1","nobody":"x-1234@1"},"other-1234":"nope"}');
  check("the voice map keeps only readable copies of known voices",
    [map.size, [...(map.get("base-1234")?.keys() ?? [])]], [1, ["priya"]]);
  check("an unreadable voice map is empty, never guessed", [VA.readVoiceApps("{not json").size, VA.readVoiceApps("").size], [0, 0]);
  const own = { id: "base-1234", version: 9 };
  check("a call in a voice goes to its copy, a voice with no copy to the agent's own",
    [VA.voiceApp(map, own, "priya"), VA.voiceApp(map, own, "ritu"), VA.voiceApp(map, own, null)],
    [{ id: "copy-5678", version: 2 }, own, own]);
  check("the voices ready are the agent's own and its copies", [...VA.voicesReady(map, "base-1234", "advait")].sort(), ["advait", "priya"]);
}

