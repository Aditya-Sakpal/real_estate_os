  check("somebody on site for over an hour is owed a record",
    V.needsYou({ ...base, status: "on_site", arrivedAt: "11:20" }, "2026-09-24", nowMin), "Record how it went");
  check("and not at twenty minutes",
    V.needsYou({ ...base, status: "on_site", arrivedAt: "12:20" }, "2026-09-24", nowMin), null);
  const missed = { ...base, status: "no_show" as const, temp: "HOT" as const, time: "10:00" };
  check("the no-show ladder has run its first two steps by early afternoon",
    V.recoveryStep(missed, "2026-09-24", nowMin), 2);
  check("so a hot buyer who has not replied is a person's job",
    V.needsYou(missed, "2026-09-24", nowMin), "Hot buyer, call them yourself");
  check("a no-show lapses after three days",
    V.recovery({ ...missed, date: "2026-09-20" }, "2026-09-24", nowMin).at(-1)?.state, "missed");
  check("a confirmed visit runs the pin, then live location, then check-in",
    V.journey(base, "2026-09-24", V.toMin("09:30")).map((s) => s.state), ["done", "done", "done", "done", "due"]);
  check("a show rate counts only visits whose time has come",
    V.showRate([{ ...base, status: "visited" }, { ...base, status: "no_show" }, { ...base, status: "confirmed" }]), 0.5);
  check("an hour and a half late reads with its minutes", V.arrivalLabel("11:05", nowMin), "1 h 35 min late");
  check("a confirmed visit half an hour past its slot with nobody in needs a person",
    V.needsYou({ ...base, time: "12:10" }, "2026-09-24", nowMin), "Not checked in");
  check("and not at twenty minutes past", V.needsYou({ ...base, time: "12:20" }, "2026-09-24", nowMin), null);
  check("so a day with buyers still missing cannot read as everybody turning up",
    V.showRate([{ ...base, status: "visited" }, { ...base, time: "11:00" }], "2026-09-24", nowMin), 0.5);

  const places = ["Sath Heights · Tower C", "Sath Heights · Tower A", "Riverside Greens"];
  const week = S.sampleVisits({ today: "2026-09-24", nowIso: "2026-09-24T07:10:00Z", places });
  const over: string[] = [];
  for (const site of S.sitesFrom(places)) {
    for (const o of S.WEEK) {
      const date = addDays("2026-09-24", o);
      for (const h of V.HOURS) {
        const n = week.filter(
          (v) => v.project === site.name && v.date === date && V.hourOf(v.time) === h && V.holdsSlot(v) && v.status !== "blocked",
        ).length;
        if (n > V.hostsOnDuty(date, site.big)) over.push(`${site.name} ${date} ${h}`);
      }
