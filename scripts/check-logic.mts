  check("facts changed after the block make it stale too",
    stale(written, { briefUpdatedAt: "2026-09-23T12:00:00.000Z", ground: g1 }), "facts");
  check("nothing changed, nothing stale",
    stale(written, { briefUpdatedAt: "2026-09-23T12:00:00.000Z", ground: g0 }), null);
  // The days left on a registration change every morning with nothing else
  // changing, so they must not make every block stale overnight.
  check("a registration a day closer to lapsing is not a change",
    stale(written, { briefUpdatedAt: "2026-09-23T12:00:00.000Z",
      ground: { ...g0, registrationDaysLeft: 399 } }), null);

  // jsonb hands keys back in its own order. Compared naively, every block
  // quoting a flat type looked "written before the facts changed" straight
  // after it was written.
  const withFlat = gf({ values: { "claims.talking_points": "Sea facing" }, advertisable: true,
    registrationNo: "P1", registrationDaysLeft: 400, facelessLanguages: [],
    configurations: [{ config: "2BHK", label: "2 BHK", startingPrice: 21824000 }] });
  const roundTripped = { ...withFlat,
    configurations: [{ startingPrice: 21824000, label: "2 BHK", config: "2BHK" }] };
  check("the same facts with their keys reordered are the same facts",
    stale({ generatedAt: "2026-09-23T13:13:00.000Z", ground: roundTripped as typeof withFlat },
      { briefUpdatedAt: "2026-09-23T12:50:22.720Z", ground: withFlat }), null);

  check("\"nothing\" in the offer box is no offer", offer("nothing"), null);
  check("nor is \"n/a\"", offer("n/a"), null);
  check("a real offer passes through", offer("No floor rise till Diwali"), "No floor rise till Diwali");
}

// "Any word over three letters, as a substring" was wrong both ways on a real
// Tower C run: it refused "Tower C: Sea Views" and cleared a headline that
// shared only the word "from" with a talking point.
console.log("\nCampaign Studio: what counts as leading on a signed point");
{
  const { leadsOnSigned: leads, groundFrom: gf } = await import("../src/lib/creative-rules.ts");
  const g = gf({
    values: { "claims.talking_points":
      "Sea facing from the 18th floor up\nTwo lifts per wing with a dedicated service lift" },
    advertisable: true, registrationNo: "P1", registrationDaysLeft: 400, facelessLanguages: [],
    configurations: [{ config: "2BHK", label: "2 BHK", startingPrice: 21824000 }],
  });
  check("a short word from the point counts", leads("Tower C: Sea Views", g), true);
  check("hyphenated, it still counts", leads("Sea-facing homes", g), true);
  check("a plural counts", leads("Lifts that never wait", g), true);
  check("a word shared only as filler does not",
    leads("The address from the year", g), false);
  check("nor does a longer word that merely contains it", leads("Seasonal offers", g), false);
  check("a claim nobody signed does not", leads("Metro & Connectivity", g), false);
  check("a place from the audience does not", leads("Chembur ka pehla ghar", g), false);
  check("a headline on an approved flat and price does",
    leads("2 BHK from Rs 2,18,24,000", g), true);
}

