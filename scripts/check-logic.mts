console.log("\nBudget: moving money to the ads that bring buyers");
{
  const B = await import("../src/lib/budget-rules.ts");
  const now = "2026-09-25T06:30:00Z";
  const ad = (id: string, budget: number, spendRs: number, qualified: number, extra: Partial<import("../src/lib/budget-rules.ts").AdPerf> = {}) => ({
    targetId: id, dailyBudget: budget, cap: 5000, spendPaise: spendRs * 100, clicks: 100, leads: qualified * 3, qualified,
    liveDays: 7, lastShiftAt: null, ...extra,
  });
  const shifts = B.planShifts([ad("A", 1000, 7000, 10), ad("B", 1000, 7000, 1), ad("C", 1000, 7000, 0)], now);
  const total = (xs: { from: number; to: number }[]) => xs.reduce((n, s) => n + (s.to - s.from), 0);
  check("the two losers give and the winner takes", shifts.map((s) => [s.targetId, s.rule]).sort(), [["A", "SCALE_UP"], ["B", "SCALE_DOWN"], ["C", "SCALE_DOWN"]]);
  check("the total the developer approved does not change", total(shifts), 0);
  check("no ad moves more than a fifth in one pass", shifts.every((s) => Math.abs(s.to - s.from) <= s.from * 0.2), true);
  check("a winner at its cap takes nothing", B.planShifts([ad("A", 5000, 7000, 10), ad("B", 1000, 7000, 0)], now).length, 0);
  check("too little spend is not a verdict", B.planShifts([ad("A", 1000, 700, 10), ad("B", 1000, 700, 0)], now).length, 0);
  check("too few days is not a verdict", B.planShifts([ad("A", 1000, 7000, 10, { liveDays: 2 }), ad("B", 1000, 7000, 0, { liveDays: 2 })], now).length, 0);
  check("an ad moved yesterday is left alone",
    B.planShifts([ad("A", 1000, 7000, 10, { lastShiftAt: "2026-09-24T06:30:00Z" }), ad("B", 1000, 7000, 0)], now).length, 0);
  check("ads that perform alike hold", B.planShifts([ad("A", 1000, 7000, 5), ad("B", 1000, 7000, 5)], now).length, 0);
  check("never under the platforms' floor", B.planShifts([ad("A", 1000, 7000, 10), ad("B", 110, 7000, 0)], now).find((s) => s.targetId === "B")?.to ?? 110, 100);
  check("with too few qualified leads to rank on, cost per lead decides",
    B.metricFor([ad("A", 1000, 7000, 0, { leads: 5 }), ad("B", 1000, 7000, 0, { leads: 0 })]), "LEADS");
  check("apportion sums exactly", B.apportion(101, [1, 1, 1]).reduce((a, b) => a + b, 0), 101);
}

