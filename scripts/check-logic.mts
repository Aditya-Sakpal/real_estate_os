// ---------------------------------------------------------------------------
// Where an invite lands.
//
// A membership is always held AT a node. These are the parts of choosing one
// that need no database: which nodes an inviter can reach, which roles are
// worth offering across them, and what a spreadsheet cell meant.
// ---------------------------------------------------------------------------

console.log("\nChoosing a scope node");

const TREE = [
  { id: "n0", kind: "ORG" as const, name: "BillBay", path: "billbay" },
  { id: "n1", kind: "ENTITY" as const, name: "BillBay Co-operation Private Limited",
    path: "billbay.billbay_co" },
  { id: "n2", kind: "REGION" as const, name: "Mumbai", path: "billbay.billbay_co.mumbai" },
  { id: "n3", kind: "PROJECT" as const, name: "Sath Heights",
    path: "billbay.billbay_co.mumbai.sath_heights" },
  { id: "n4", kind: "PHASE" as const, name: "Tower C",
    path: "billbay.billbay_co.mumbai.sath_heights.tower_c" },
  { id: "n5", kind: "REGION" as const, name: "Pune", path: "billbay.billbay_co.pune" },
  { id: "n6", kind: "PROJECT" as const, name: "Trees", path: "billbay.billbay_co.pune.trees" },
  { id: "n7", kind: "PHASE" as const, name: "Phase 1",
    path: "billbay.billbay_co.pune.trees.phase_1" },
  { id: "n8", kind: "PHASE" as const, name: "Phase 1",
    path: "billbay.billbay_co.mumbai.sath_heights.phase_1" },
];

check("depth is counted in labels, not characters", depthOf("billbay.a.b"), 2);
check("the root is depth zero", depthOf("billbay"), 0);
check("a node's own label is the last one", labelOf("billbay.a.tower_c"), "tower_c");

// --- what a form may not decide -------------------------------------------
// A node id goes straight into a uuid comparison, and Postgres raises on a
// malformed one rather than returning no rows. The shape is checked first so
// a crafted id is a refusal rather than a stack trace.
check("a real uuid is a possible node id",
  isNodeId("3f1c2b4a-5d6e-4f70-8a9b-0c1d2e3f4a5b"), true);
check("a word is not", isNodeId("' OR 1=1 --"), false);
check("nor is an almost-uuid", isNodeId("3f1c2b4a-5d6e-4f70-8a9b-0c1d2e3f4a5"), false);
check("padding is tolerated", isNodeId("  3f1c2b4a-5d6e-4f70-8a9b-0c1d2e3f4a5b "), true);

// --- containment ----------------------------------------------------------
const AT_MUMBAI = ["billbay.billbay_co.mumbai"];
check("an admin at the root reaches the whole tree",
  nodesWithin(TREE, ["billbay"]).length, TREE.length);
check("a head in Mumbai reaches Mumbai and below",
  nodesWithin(TREE, AT_MUMBAI).map((n) => n.name),
  ["Mumbai", "Sath Heights", "Tower C", "Phase 1"]);
check("and nothing in Pune",
  nodesWithin(TREE, AT_MUMBAI).some((n) => n.path.includes("pune")), false);
check("somebody holding nothing reaches nothing", nodesWithin(TREE, []).length, 0);
// The dot again, this time deciding whose staff somebody may hire.
check("a sibling sharing a prefix is not inside",
  nodesWithin(
    [{ id: "x", kind: "REGION" as const, name: "Punekar", path: "billbay.billbay_co.punekar" }],
    ["billbay.billbay_co.pune"],
  ).length,
  0);

// --- which roles are worth offering ---------------------------------------
// The eight roles below the org are not offered because they exist; they are
// offered because something in reach is deep enough to carry them.
const SOME_ROLES = [
  { key: "SALES_HEAD", minKind: "ORG" as const },
  { key: "PRESALES_MANAGER", minKind: "REGION" as const },
  { key: "SITE_TEAM", minKind: "PHASE" as const },
];
check("at the root every role is grantable somewhere",
  rolesGrantableIn(SOME_ROLES, TREE).map((r) => r.key),
  ["SALES_HEAD", "PRESALES_MANAGER", "SITE_TEAM"]);
check("with only the root, only org-level roles are",
  rolesGrantableIn(SOME_ROLES, [TREE[0]]).map((r) => r.key), ["SALES_HEAD"]);
check("a region and its project cannot carry Site Team",
  rolesGrantableIn(SOME_ROLES, [TREE[2], TREE[3]]).map((r) => r.key),
  ["SALES_HEAD", "PRESALES_MANAGER"]);

// --- which places suit one role -------------------------------------------
check("Site Team narrows the places to phases",
  nodesForRole(TREE, { minKind: "PHASE" }).map((n) => n.name),
  ["Tower C", "Phase 1", "Phase 1"]);
check("a Sales Head may sit anywhere in it",
  nodesForRole(TREE, { minKind: "ORG" }).length, TREE.length);

// --- the subset rule: only what you hold, where you hold it ---------------
console.log("\nWhat a person holds at a node");
const SUBSET_GRANTS = [
  { role: "SALES_HEAD", roleLabel: "Sales Head", scopeNodeId: "n2", scopePath: TREE[2].path,
    scopeKind: "REGION" as const, scopeName: "Mumbai",
    permissions: permSet("lead:read", "member:invite", "visit:read") },
  { role: "CLOSING_MANAGER", roleLabel: "Closing Manager", scopeNodeId: "n4", scopePath: TREE[4].path,
    scopeKind: "PHASE" as const, scopeName: "Tower C",
    permissions: permSet("lead:read", "lead.phone:unmask") },
];
const SUBSET = buildAuthz(SUBSET_GRANTS);
check("two grants pool on the tower both cover",
  [...heldAtPath(SUBSET_GRANTS, TREE[4].path)].sort(),
  ["lead.phone:unmask", "lead:read", "member:invite", "visit:read"]);
check("and only the region's on the project above the tower",
  SUBSET.heldAt(TREE[3].path).has("lead.phone:unmask"), false);
check("a sibling sharing a prefix holds nothing",
  SUBSET.heldAt("billbay.billbay_co.mumbaikar").size, 0);
check("nothing missing means it may be given", missingToGrant(permSet("a", "b"), ["a"]), []);
check("what is missing is named", missingToGrant(permSet("a"), ["a", "b", "b"]), ["b"]);
check("the wildcard gives everything", missingToGrant(permSet("*"), ["x", "*"]), []);
// No list of keys adds up to the wildcard, because the wildcard also means
// every key added in a later release.
check("every key listed is still not the wildcard",
  missingToGrant(permSet(...PERMISSION_KEYS), ["*"]), ["*"]);
check("the root of a path is its first label", rootOf("billbay.billbay_co.mumbai"), "billbay");
check("and a root is its own root", rootOf("billbay"), "billbay");

console.log("\nWhich roles a person may hand out, and where");
const PICK = [
  { key: "PRESALES_AGENT", label: "Pre-sales Agent", minKind: "PROJECT" as const, permissions: ["lead:read"] },
  { key: "CLOSING_MANAGER", label: "Closing Manager", minKind: "PROJECT" as const,
    permissions: ["lead:read", "lead.phone:unmask"] },
  { key: "ORG_ADMIN", label: "Org Admin", minKind: "ORG" as const, permissions: ["*"] },
];
const reach = reachFor(PICK, nodesWithin(TREE, [TREE[2].path]), SUBSET.heldAt);
check("a role with nothing extra reaches every project and tower in the region",
  reach.find((r) => r.key === "PRESALES_AGENT")?.at, ["n3", "n4", "n8"]);
check("a role carrying phone numbers reaches only the tower where they are held",
  reach.find((r) => r.key === "CLOSING_MANAGER")?.at, ["n4"]);
check("and the admin role reaches nowhere, so it is not offered",
  reach.some((r) => r.key === "ORG_ADMIN"), false);
check("the picker narrows to where the role may go",
  nodesForRole(TREE, { minKind: "PROJECT", at: ["n4"] }).map((n) => n.id), ["n4"]);
check("an admin at the root reaches every role everywhere it fits",
  reachFor(PICK, TREE, () => permSet("*")).find((r) => r.key === "ORG_ADMIN")?.at, ["n0", "n1", "n2", "n3", "n4", "n5", "n6", "n7", "n8"]);

console.log("\nChanging and removing a membership");
const CM = { key: "CLOSING_MANAGER", label: "Closing Manager", minKind: "PROJECT" as const,
  permissions: ["lead:read", "lead.phone:unmask"] };
const PA = { key: "PRESALES_AGENT", label: "Pre-sales Agent", minKind: "PROJECT" as const, permissions: ["lead:read"] };
const TOWER_C = { path: TREE[4].path, kind: "PHASE" as const, name: "Tower C" };
const PROJECT = { path: TREE[3].path, kind: "PROJECT" as const, name: "Sath Heights" };
const change = (over: Partial<Parameters<typeof checkMemberChange>[0]>) =>
  checkMemberChange({
    actorScopes: [TREE[2].path],
    actorHeld: SUBSET.heldAt(TOWER_C.path),
    isSelf: false,
    current: PA,
    node: TOWER_C,
    change: { kind: "ROLE", next: CM },
    ...over,
  });
check("a promotion inside what you hold is allowed", change({}).ok, true);
check("nobody changes their own role", (change({ isSelf: true }) as { code: string }).code, "SELF");
check("nor removes themselves",
  (change({ isSelf: true, change: { kind: "REMOVE" } }) as { message: string }).message,
  "You cannot remove yourself.");
// The half rank never had: a regional head cannot demote the person above
// them just because they sit on the same region.
check("you cannot change a role that holds more than you do there",
  (change({ current: CM, node: PROJECT, actorHeld: SUBSET.heldAt(PROJECT.path), change: { kind: "ROLE", next: PA } }) as { code: string }).code,
  "NOT_YOURS_TO_CHANGE");
check("nor remove it",
  (change({ current: CM, node: PROJECT, actorHeld: SUBSET.heldAt(PROJECT.path), change: { kind: "REMOVE" } }) as { code: string }).code,
  "NOT_YOURS_TO_CHANGE");
check("you cannot move someone to a role you could not give there",
  (change({ node: PROJECT, actorHeld: SUBSET.heldAt(PROJECT.path) }) as { code: string }).code,
  "NOT_YOURS_TO_GIVE");
check("the admin role is left to its own controls",
  (change({ change: { kind: "ROLE", next: { key: "ORG_ADMIN", label: "Org Admin", minKind: "ORG", permissions: ["*"] } } }) as { code: string }).code,
  "ADMIN_ROLE");
check("outside your part of the tree is refused",
  (change({ actorScopes: [TREE[5].path] }) as { code: string }).code, "OUTSIDE_YOUR_SCOPE");
check("moving to the role they hold is refused", (change({ change: { kind: "ROLE", next: PA } }) as { code: string }).code, "SAME_ROLE");
check("a project role on a region is refused for depth",
  (change({ node: { path: TREE[2].path, kind: "REGION", name: "Mumbai" }, actorHeld: permSet("*") }) as { code: string }).code,
  "ROLE_TOO_DEEP");
check("removing someone you outrank is allowed", change({ change: { kind: "REMOVE" } }).ok, true);

{
  console.log("\nA departing member's work moves on");
  const D = await import("../src/lib/departure-rules.ts");
  const pune = "acme.spv.pune";
  const towerC = "acme.spv.pune.trees.tower_c";
  const towerD = "acme.spv.pune.trees.tower_d";
  const kept = [{ path: pune, permissions: ["lead:read", "lead:update"] }];
  check("a lead under a role they still hold stays theirs", D.holdsAt(kept, D.KEEPS.lead, towerC), true);
  check("a role without the key does not keep it", D.holdsAt([{ path: pune, permissions: ["lead:read"] }], D.KEEPS.lead, towerC), false);
  check("a grant on another tower does not keep it", D.holdsAt([{ path: towerD, permissions: ["lead:update"] }], D.KEEPS.lead, towerC), false);
  check("the wildcard keeps everything", D.holdsAt([{ path: "acme", permissions: ["*"] }], D.KEEPS.firm, towerC), true);
  check("no grants left keeps nothing", D.holdsAt([], D.KEEPS.visit, towerC), false);
  check("either visit key keeps a visit", D.holdsAt([{ path: towerC, permissions: ["visit:outcome"] }], D.KEEPS.visit, towerC), true);
  check("only the work outside what they hold is left behind",
    D.leftBehind([{ path: towerD, permissions: ["lead:update"] }], [{ id: "c", path: towerC }, { id: "d", path: towerD }], D.KEEPS.lead).map((x) => x.id),
    ["c"]);
  check("a firm is kept by the key on one of its projects",
    D.keepsFirm([{ path: towerC, permissions: ["partner:empanel"] }], [towerD, towerC], "acme"), true);
  check("a firm with no project left is kept only at the root",
    D.keepsFirm([{ path: pune, permissions: ["partner:empanel"] }], [], "acme"), false);
  const people = [
    { id: "a", name: "Asha", admin: false, load: 3 },
    { id: "b", name: "Bina", admin: false, load: 1 },
    { id: "z", name: "Admin", admin: true, load: 0 },
  ];
  check("work spreads least loaded first, one at a time", D.spread(people, 4), ["b", "b", "a", "b"]);
  check("the admin takes work only when nobody else can", D.spread([people[2]], 2), ["z", "z"]);
  check("nobody to take it is a null each", D.spread([], 2), [null, null]);
  check("the history line names who left", D.departedLine("Asha Rao"), "Owner changed: Asha Rao left the team");
  check("a nameless person reads as a teammate", D.departedLine(" "), "Owner changed: a teammate left the team");
  check("Today counts one lead in the singular", D.orphanTitle(1, "Asha"), "1 lead has no owner since Asha left");
  check("and many in the plural", D.orphanTitle(4, "Asha"), "4 leads have no owner since Asha left");
  check("nothing moved says nothing", D.reassignedLine(D.NOTHING_MOVED), "");
  check("what moved and what was left are both said",
    D.reassignedLine({ ...D.NOTHING_MOVED, leads: 3, visits: 1, leadsUnowned: 2 }),
    "3 leads, 1 visit moved to others on the team. 2 have nobody to take it yet.");
  check("moving anything is moving", D.movedAnything({ ...D.NOTHING_MOVED, firmsUnmanaged: 1 }), true);
}

