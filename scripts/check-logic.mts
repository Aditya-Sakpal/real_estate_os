  check("bookings land late, and never un-land",
    Array.from({ length: 20 }, (_, i) => R.matured(i)).every((x, i, a) => i === 0 || x >= a[i - 1]), true);
  check("a lead from last week has barely begun", R.matured(1) < R.STILL_BOOKING, true);
  check("a total shared across people adds back up to itself",
    R.apportion(106, [0.26, 0.24, 0.2, 0.16, 0.14]).reduce((t, n) => t + n, 0), 106);
  check("and the remainder goes to the largest fractions", R.apportion(10, [1, 1, 1]), [4, 3, 3]);

  const data = S.sampleReport({ today: "2026-09-24", projects: ["Sath Heights", "Riverside Greens"] });
  check("the sample weeks start on a Monday",
    data.weeks.filter((w) => new Date(`${w}T00:00:00Z`).getUTCDay() !== 1), []);
  check("and end on the week of today", data.weeks.at(-1), "2026-09-21");
  check("no sample stage outnumbers the stage before it",
    data.rows.filter((r) => r.counts.reached > r.counts.leads || r.counts.qualified > r.counts.reached ||
      r.counts.visited > r.counts.qualified || r.counts.booked > r.counts.visited).length, 0);
  check("no partner row carries media spend, and no media row a commission",
    data.rows.filter((r) => (r.source === "cp" && r.counts.spend) || (r.source !== "cp" && r.counts.commission)).length, 0);
  const media = new Set(["meta", "google", "99acres", "magicbricks", "housing"]);
  const quarters = [13, 26, 39].map((i) =>
    R.total(data.rows.filter((r) => data.weeks.slice(i, i + 13).includes(r.week) && media.has(r.source)).map((r) => r.counts)));
  check("a quarter's cost per booking stays inside the band developers report",
