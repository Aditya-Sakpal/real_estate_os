  check("and Rs 30,000 a booking", steps[4].costPer, 30000);
  check("each step is a share of the one before",
    steps.map((s) => (s.rate === null ? null : Math.round(s.rate * 100))), [null, 78, 32, 30, 27, 85]);
  check("the biggest drop is the lowest share, the paperwork step aside", R.biggestDrop(steps), "booked");
  check("media is costed in media", R.costPerBooking(c, "media"), 30000);
  check("a partner in commission, never in spend",
