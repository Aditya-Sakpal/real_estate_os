  const hex = (k: string, m: string) => createHmac("sha256", k).update(m).digest("hex");
  check("Checkout's signature is the HMAC of order|payment under the key secret",
    [R.paymentSignatureOk("order_1", "pay_1", hex("s", "order_1|pay_1"), "s"), R.paymentSignatureOk("order_1", "pay_2", hex("s", "order_1|pay_1"), "s"), R.paymentSignatureOk("order_1", "pay_1", "nothex", "s")],
    [true, false, false]);
  check("a webhook's signature is the HMAC of its exact bytes",
    [R.webhookSignatureOk('{"a":1}', hex("w", '{"a":1}'), "w"), R.webhookSignatureOk('{"a": 1}', hex("w", '{"a":1}'), "w"), R.webhookSignatureOk("x", null, "w")],
    [true, false, false]);
  const seller = { BILLING_SELLER_NAME: "E", BILLING_SELLER_GSTIN: "27AAPFU0939F1ZV", BILLING_SELLER_ADDRESS: "Pune" };
  check("test keys buy nothing on a production host; live keys only for a live organisation with a seller",
    [R.purchasingOpen("SHADOW", { RAZORPAY_KEY_ID: "rzp_test_1", RAZORPAY_KEY_SECRET: "x" }),
     R.purchasingOpen("SHADOW", { RAZORPAY_KEY_ID: "rzp_test_1", RAZORPAY_KEY_SECRET: "x", VERCEL: "1" }),
     R.purchasingOpen("SHADOW", { RAZORPAY_KEY_ID: "rzp_live_1", RAZORPAY_KEY_SECRET: "x", ...seller }),
     R.purchasingOpen("LIVE", { RAZORPAY_KEY_ID: "rzp_live_1", RAZORPAY_KEY_SECRET: "x" }),
     R.purchasingOpen("LIVE", { RAZORPAY_KEY_ID: "rzp_live_1", RAZORPAY_KEY_SECRET: "x", ...seller }),
     R.purchasingOpen(null, { RAZORPAY_KEY_ID: "rzp_test_1", RAZORPAY_KEY_SECRET: "x" })],
    [true, false, false, false, true, false]);
  check("a payment event is read, and anything else is ignored",
    [R.readPaymentEvent({ event: "payment.captured", payload: { payment: { entity: { id: "pay_1", order_id: "order_1", amount: 100, status: "captured" } } } }),
     R.readPaymentEvent({ event: "refund.created", payload: {} })],
    [{ type: "payment.captured", paymentId: "pay_1", orderId: "order_1", amount: 100, status: "captured" }, null]);

  check("the invoice font sets what it can and marks what it cannot", [P.winAnsi("\u20b91,000 \u2013 Caf\u00e9"), P.winAnsi("\u0938\u093e\u0925")], ["Rs 1,000 - Cafe", "???"]);
  check("a line wraps at spaces and never runs off the column", P.wrap("one two three four five six seven", 9, 60).every((l) => P.textWidth(l, 9) <= 60), true);
  const pdf = P.pdfDocument([[{ t: "text", x: 48, y: 800, text: "TAX INVOICE (EST/26-27/00001)", size: 12, bold: true }, { t: "line", x1: 48, y1: 790, x2: 547, y2: 790 }]], { title: "Test" });
  const body = pdf.toString("latin1");
  const xrefAt = Number(/startxref\n(\d+)/.exec(body)![1]);
  const offsets = [...body.slice(xrefAt).matchAll(/(\d{10}) 00000 n/g)].map((m) => Number(m[1]));
  check("the PDF's index points at each object it lists",
    [body.startsWith("%PDF-1.4"), body.slice(xrefAt, xrefAt + 4), offsets.every((o, i) => body.slice(o).startsWith(`${i + 1} 0 obj`))], [true, "xref", true]);
  check("brackets in text are escaped, not taken as the end of the string", body.includes("(TAX INVOICE \\(EST/26-27/00001\\)) Tj"), true);
}

