// ---------------------------------------------------------------------------
// One-to-one WhatsApp paced to the number's daily limit
// ---------------------------------------------------------------------------
{
  console.log("\nWhatsApp pacing: the daily limit, what goes first, and Meta's throttles");
  const P = await import("../src/lib/wa-pacing-rules.ts");
  const now = Date.parse("2026-10-04T06:00:00Z");
  const h = 3_600_000;
  const base = { limit: 250, reached: 0, alreadyReached: false, inServiceWindow: false, priority: "FIRST" as const, oldest: [] as number[], now };
  check("under the limit, a send goes", P.paceSend({ ...base, reached: 249 }).ok, true);
  check("no limit, a service reply, or a buyer already reached today all go",
    [P.paceSend({ ...base, limit: null, reached: 9999 }).ok, P.paceSend({ ...base, reached: 300, inServiceWindow: true }).ok, P.paceSend({ ...base, reached: 300, alreadyReached: true }).ok],
    [true, true, true]);
  const oldest = [now - 20 * h, now - 10 * h, now - 5 * h];
  check("at the limit it waits until the oldest person ages out",
    P.paceSend({ ...base, reached: 250, oldest }), { ok: false, untilMs: now + 4 * h });
  check("two over, it waits for the second oldest",
    P.paceSend({ ...base, reached: 251, oldest }), { ok: false, untilMs: now + 14 * h });
  check("a drip keeps a tenth back for acknowledgements and reminders, and queues behind them",
    [P.paceSend({ ...base, priority: "LATER", reached: 224 }).ok, P.paceSend({ ...base, priority: "LATER", reached: 225, oldest }).ok, P.paceSend({ ...base, reached: 225 }).ok],
    [true, false, true]);
  check("a later send waits ten minutes behind a first one freed at the same moment",
    P.paceSend({ ...base, priority: "LATER", reached: 225, oldest }), { ok: false, untilMs: now + 4 * h + P.LATER_OFFSET_MS });
  check("the wait is at least a minute and at most a day",
    [P.paceSend({ ...base, reached: 250, oldest: [now - 24 * h] }), P.paceSend({ ...base, reached: 250, oldest: [] })],
    [{ ok: false, untilMs: now + P.MIN_WAIT_MS }, { ok: false, untilMs: now + 24 * h }]);
  check("acknowledgements and visit reminders go first, drips and follow-ups later",
    ["ACK", "VISIT_REMINDER_DAY", "NURTURE", "POST_VISIT_FOLLOWUP"].map(P.priorityOf), ["FIRST", "FIRST", "LATER", "LATER"]);
  check("Meta's code is read off the refusal",
    [P.metaCodeOf(new Error("WhatsApp refused: Rate limit hit (130429)")), P.metaCodeOf(new Error("WhatsApp refused: nope")), P.metaCodeOf({ platformCode: 131056 })],
    [130429, null, 131056]);
  check("throttles retry, the messaging limit waits, the rest stay failures",
    [P.classifyRefusal(130429, ""), P.classifyRefusal(131048, ""), P.classifyRefusal(80007, ""), P.classifyRefusal(131026, ""), P.classifyRefusal(131049, ""), P.classifyRefusal(null, "Messaging limit reached")],
    ["THROTTLED", "THROTTLED", "THROTTLED", "OTHER", "OTHER", "TIER"]);
  check("a throttle backs off, counts once an hour at most, and gives up after a day",
    [P.throttleRetry([], now), P.throttleRetry([now - 60_000], now), P.throttleRetry([now - 2 * h], now), P.throttleRetry([now - 25 * h, now - 60_000], now).giveUp],
    [{ giveUp: false, retryAtMs: now + 60_000, counted: true }, { giveUp: false, retryAtMs: now + 120_000, counted: false }, { giveUp: false, retryAtMs: now + 120_000, counted: true }, true]);
  check("waits never grow past half an hour", P.throttleRetry(Array.from({ length: 10 }, (_, i) => now - i * 60_000), now).retryAtMs, now + P.THROTTLE_MAX_WAIT_MS);
  check("the wait reads in plain words and is told apart on the lead",
    [P.pacedWords("+91 98765 43210"), P.isPacedNote(P.pacedWords(null)), P.isPacedNote("Waiting for calling hours")],
    ["Waiting: +91 98765 43210 reached its daily WhatsApp limit. It goes out when the limit frees up.", true, false]);
}

