// ---------------------------------------------------------------------------
// Placing a real call. The client sets the policy; an opt-out and the calling
// hours are not theirs to switch off, and the order of the checks is the rule.
// ---------------------------------------------------------------------------
console.log("\nCalling: the policy, the gate, what the agent is told");
{
  const R = await import("../src/lib/calling-rules.ts");
  const policy = { ...R.DEFAULT_POLICY };
  const noon = "2026-09-25T06:30:00Z"; // 12:00 IST
  const base = { policy, nowIso: noon, enquiredAt: "2026-09-24T06:30:00Z", consents: [], optedOut: false };

  check("a fresh enquiry may be called", R.gateCall(base), { ok: true, basis: "ENQUIRY" });
  check("a cold contact's consent the database stamped seconds after the pass read its clock still counts",
    R.gateCall({ ...base, enquiredAt: new Date(0).toISOString(), consents: [{ channels: ["call"], capturedAt: "2026-09-25T06:30:03Z", expiresAt: null }] }),
    { ok: true, basis: "CONSENT" });
  check("a consent dated well in the future does not",
    R.gateCall({ ...base, enquiredAt: new Date(0).toISOString(), consents: [{ channels: ["call"], capturedAt: "2026-09-25T07:30:00Z", expiresAt: null }] }).ok, false);
  check("an opt-out refuses whatever else is true",
    R.gateCall({ ...base, optedOut: true, policy: { ...policy, consentRequired: false } }).ok, false);
  check("no call before 10 am IST", R.gateCall({ ...base, nowIso: "2026-09-25T04:00:00Z" }).ok, false);
  check("nor at 9 pm IST", R.gateCall({ ...base, nowIso: "2026-09-25T15:30:00Z" }).ok, false);
  check("a call the hours are lifted for may be rung at 11 pm",
    R.gateCall({ ...base, nowIso: "2026-09-25T17:30:00Z", anyHour: true }).ok, true);
  check("but an opt-out still refuses it", R.gateCall({ ...base, nowIso: "2026-09-25T17:30:00Z", anyHour: true, optedOut: true }).ok, false);
  check("development lifts the hours for every call, production for none",
    [R.anyHourFor("+919000000001", true, { ENVIRONMENT: "development" }),
      R.anyHourFor("+919000000001", false, { ENVIRONMENT: "development" }),
      R.anyHourFor("+919000000001", true, { ENVIRONMENT: "production" }),
      R.anyHourFor("+919000000001", true, { NODE_ENV: "production" }),
      R.anyHourFor("+919000000001", true, { VERCEL: "1" }),
      R.anyHourFor("+919000000001", true, { VERCEL: "1", ENVIRONMENT: "development" })],
    [true, true, false, false, false, true]);
  check("an enquiry past 7 days needs consent",
    R.gateCall({ ...base, enquiredAt: "2026-09-15T06:30:00Z" }).ok, false);
  check("and consent for calls carries it",
    R.gateCall({ ...base, enquiredAt: "2026-09-15T06:30:00Z",
