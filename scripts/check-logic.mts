    week.map((v) => v.id + v.status).join());
  const later = S.sampleVisits({ today: "2026-09-24", nowIso: "2026-09-24T12:10:00Z", places });
  check("and the day moves forward, never back, as it passes",
    later.filter((v) => week.find((w) => w.id === v.id)?.status === "visited" && v.status !== "visited").map((v) => v.id), []);
}

