console.log("\nLearning: our results, the market, the blend and the next creative");
{
  const L = await import("../src/lib/learning-rules.ts");
  const K = await import("../src/lib/competitor-rules.ts");

  check("a line about the station leads with connectivity", L.pointAngle("8 min from Goregaon station"), "CONNECTIVITY");
  check("a sea view is the view", L.pointAngle("Sea facing apartments"), "VIEW");
  check("a price line is the price", L.pointAngle("2 BHK starting at ₹1.45 Cr*"), "PRICE");
  check("a scheme is an offer", L.pointAngle("No floor rise till Diwali"), "OFFER");
  check("a clubhouse is an amenity", L.pointAngle("A 40,000 sq ft clubhouse"), "AMENITY");
  check("image and video designs are told apart", L.templateValue("VIDEO", "01-launch-film"), "VIDEO:01-launch-film");
  check("a post's ingredients come from what it recorded",
    L.postIngredients({ kind: "CAROUSEL", language: "en", headline: "Sea Facing Apartments", templateKey: "05-reasons-to-buy", pictureCategory: "EXTERIOR_RENDER", priceShown: true }),
    { angle: "VIEW", format: "CAROUSEL", template: "CAROUSEL:05-reasons-to-buy", language: "en", picture: "EXTERIOR", price: "SHOWN" });

  // Two formats, the same money: carousels bring three times the qualified buyers.
  const ad = (format: string, angle: string, spend: number, qualified: number) => ({ ingredients: { format, angle }, spend, qualified });
  const own = L.ownScores([ad("CAROUSEL", "CONNECTIVITY", 10_000, 30), ad("IMAGE", "VIEW", 10_000, 10)]);
  const car = own.get("format|CAROUSEL")!;
  const img = own.get("format|IMAGE")!;
  check("more qualified buyers for the money scores above 1, fewer below", [car.score > 1, img.score < 1], [true, true]);
  check("and a small sample is pulled towards the prior", L.ownScores([ad("CAROUSEL", "X", 1_000, 1), ad("IMAGE", "Y", 10_000, 1)]).get("format|CAROUSEL")!.score < 5, true);
  check("organic posts with no spend do not score", L.ownScores([ad("IMAGE", "VIEW", 0, 50)]).size, 0);

  check("an ad running two months counts five times one seen for a week", [L.longevityWeight(70), L.longevityWeight(3)], [1, 0.2]);
  check("days running are counted from the start to the day it was seen", L.runningDays("2026-08-01", "2026-09-29"), 59);
  const m = (angle: string, days: number | null, flagged = false) => ({ ingredients: { angle }, runningDays: days, flagged });
  const market = L.marketScores([m("CONNECTIVITY", 90), m("CONNECTIVITY", 75), m("CONNECTIVITY", 60), m("CONNECTIVITY", 40), m("PRICE", 3), m("PRICE", 90, true)]);
  check("the market leans on what its long-running ads lead with", market.get("angle|CONNECTIVITY")!.score > market.get("angle|PRICE")!.score, true);
  check("an ad making a claim we may not make is left out", market.get("angle|PRICE")!.ads, 1);

