  const again = [...booked, { id: "X", kind: "CANCELLED" as const, bookingId: "B" }];
  check("booking again after a cancellation is a new booking",
    kinds(A.outcomesForMove({ from: "negotiation", to: "booked", toPath: "booked", cancelsBooking: false }, again)), ["BOOKED"]);
  check("a cancelled booking does not stand", A.liveBooking(again), null);

  check("an outcome typed for an earlier day is that day, noon in India",
