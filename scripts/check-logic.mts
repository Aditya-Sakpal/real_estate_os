// ---------------------------------------------------------------------------
// Ownership rules at capture (lead engine gaps, slice 2)
// ---------------------------------------------------------------------------
{
  console.log("\nOwnership rules: junk, already booked, an open lead, or new");
  const O = await import("../src/lib/ownership-rules.ts");
  const now = "2026-09-29T06:30:00Z";
  const base = {
    nowIso: now, lookbackDays: 90, isTest: false, honeypot: false, phone: "+919000000301", name: "Priya Sharma",
    closedAsJunk: null, booked: null, open: null,
  };
  const daysAgo = (n: number) => new Date(Date.parse(now) - n * 86_400_000).toISOString();

  check("a new number is a new lead (R4)", O.ownershipRule(base), { rule: "R4", action: "NEW", closeStale: null });
  check("a form's test flag is junk (R0)", O.ownershipRule({ ...base, isTest: true }).rule, "R0");
  check("our hidden field filled in is a bot, junk", O.ownershipRule({ ...base, honeypot: true }).rule, "R0");
  check("ten of one digit is nobody's number", [O.junkPhone("+919999999999"), O.junkPhone("+917777777777"), O.junkPhone("+919000000301")], [true, true, false]);
  check("the example numbers people type are junk", [O.junkPhone("+919876543210"), O.junkPhone("+919123456789")], [true, true]);
  check("a test name is junk, a real one is not",
    [O.junkName("Test"), O.junkName(" asdf. "), O.junkName("N/A"), O.junkName("Priya Sharma"), O.junkName("Testa Rossi")], [true, true, true, false, false]);
  check("a number closed here as a wrong number inside the lookback is junk",
    O.ownershipRule({ ...base, closedAsJunk: { reason: "Wrong number", at: daysAgo(10) } }).rule, "R0");
  check("but not once the lookback has passed",
    O.ownershipRule({ ...base, closedAsJunk: { reason: "Wrong number", at: daysAgo(120) } }).rule, "R4");
  check("and a number closed for another reason is not junk",
    O.ownershipRule({ ...base, closedAsJunk: { reason: "Not interested", at: daysAgo(10) } }).rule, "R4");
  check("junk is decided before anything else, a booking included",
    O.ownershipRule({ ...base, isTest: true, booked: { leadId: "B1" } }).rule, "R0");
  check("a buyer who booked in this project is not a new lead (R1)",
    O.ownershipRule({ ...base, booked: { leadId: "B1" } }), { rule: "R1", action: "BOOKED", leadId: "B1" });
  check("a booking outranks an open lead", O.ownershipRule({ ...base, booked: { leadId: "B1" }, open: { leadId: "L1", lastActivityAt: daysAgo(1) } }).rule, "R1");
  check("an open lead active inside the lookback takes the enquiry (R3)",
    O.ownershipRule({ ...base, open: { leadId: "L1", lastActivityAt: daysAgo(89) } }), { rule: "R3", action: "MERGE", leadId: "L1" });
  check("one quiet past it is closed, and the buyer becomes a new lead",
    O.ownershipRule({ ...base, open: { leadId: "L1", lastActivityAt: daysAgo(91) } }), { rule: "R4", action: "NEW", closeStale: "L1" });
  check("the organisation's own lookback is used",
    O.ownershipRule({ ...base, lookbackDays: 30, open: { leadId: "L1", lastActivityAt: daysAgo(45) } }).rule, "R4");
  check("a lookback is held to a week and a year", [O.clampLookback(1), O.clampLookback(500), O.clampLookback(Number.NaN), O.clampLookback(45)], [7, 365, 90, 45]);
  check("a lookback typed in Settings is read, or refused in words",
    [O.lookbackProblem("90"), O.lookbackProblem("3"), O.lookbackProblem("400"), O.lookbackProblem("ninety")],
    [null, "At least 7 days.", "At most 365 days.", "Enter the days as a whole number, like 90."]);
  check("every rule has words for a lead's history", O.OWNERSHIP_RULES.every((r) => O.RULE_WORDS[r].length > 0), true);
}

// ---------------------------------------------------------------------------
// Visit capacity (lead engine gaps, slice 5)
// ---------------------------------------------------------------------------
{
  console.log("\nVisit capacity: the hour a visit takes, three others when it is full, the host, the gate");
  const SR = await import("../src/lib/slot-rules.ts");
  const K2 = await import("../src/lib/cadence-rules.ts");
  const M2 = await import("../src/lib/message-rules.ts");
  const W2 = await import("../src/lib/wa-rules.ts");
  check("a 4:30 visit takes the four o'clock hour, in IST", SR.slotOf("2026-10-03T11:00:00Z"), { day: "2026-10-03", hour: 16, time: "16:30" });
  check("the weekend staffs up", [SR.hostsOn("2026-10-03", { weekday: 2, weekend: 3 }), SR.hostsOn("2026-10-05", { weekday: 2, weekend: 3 })], [3, 2]);
  check("visits start in the hours from ten to six", SR.SLOT_HOURS, [10, 11, 12, 13, 14, 15, 16, 17, 18]);
  const full = (busy: string[]) => (day: string, hour: number) => ({ day, hour, capacity: 1, taken: busy.includes(`${day}:${hour}`) ? 1 : 0, held: 0 });
  const now = "2026-10-01T04:30:00Z"; // 10:00 IST
  const alt = SR.alternatives({ askedIso: "2026-10-03T11:00:00Z", nowIso: now, hourAt: full(["2026-10-03:16", "2026-10-03:15"]) });
  check("three others, nearest the hour asked for on the same day, keeping its half hour",
    alt.map((a) => [a.day, a.hour]), [["2026-10-03", 17], ["2026-10-03", 14], ["2026-10-03", 18]]);
  check("an offered time keeps the minute asked for", SR.slotOf(alt[0].startsAt).time, "17:30");
  const tight = SR.alternatives({ askedIso: "2026-10-01T06:30:00Z", nowIso: now, hourAt: full(["2026-10-01:12"]) });
  check("never sooner than an hour and a half from now", tight.every((a) => Date.parse(a.startsAt) >= Date.parse(now) + 90 * 60_000), true);
  const allFull = (day: string, hour: number) => ({ day, hour, capacity: 2, taken: 1, held: 1 });
  check("a held seat counts as taken, so a full week offers nothing",
    SR.alternatives({ askedIso: "2026-10-03T10:30:00Z", nowIso: now, hourAt: allFull }).length, 0);
  check("a day that runs out moves to the next", SR.alternatives({ askedIso: "2026-10-03T12:30:00Z", nowIso: now,
    hourAt: (day, hour) => ({ day, hour, capacity: day === "2026-10-03" ? 0 : 1, taken: 0, held: 0 }) })[0].day, "2026-10-04");
  check("hosts per hour typed on the screen are read or refused",
    [SR.hostsProblem("2"), SR.hostsProblem("0"), SR.hostsProblem("two"), SR.hostsProblem("51")], [null, null, "Enter a whole number, like 2.", "At most 50."]);

  const cand = (id: string, wide: boolean, sameHour: number, sameDay: number) => ({ id, name: id, wide, sameHour, sameDay });
  check("the host is somebody free that hour, placed at the project before anybody placed across the organisation",
    SR.pickHost([cand("head", true, 0, 0), cand("asha", false, 0, 3), cand("ravi", false, 0, 1)])?.id, "ravi");
  check("somebody busy that hour is never picked", SR.pickHost([cand("asha", false, 1, 0), cand("head", true, 0, 5)])?.id, "head");
  check("with nobody free there is no host", SR.pickHost([cand("asha", false, 1, 0)]), null);

  const ok = { seated: true, advertisable: true, optedOut: false, claimDisputed: false };
  check("the admission gate lets a seated visit on an advertisable tower through", SR.admit(ok), { ok: true });
  check("and says why it stops one, an opt-out first",
    [SR.admit({ ...ok, optedOut: true, advertisable: false }), SR.admit({ ...ok, advertisable: false }), SR.admit({ ...ok, seated: false }), SR.admit({ ...ok, claimDisputed: true })]
      .map((v) => (v.ok ? "ok" : v.reason)),
    ["The buyer asked not to be contacted.", "The tower cannot be advertised right now.", "The visit holds no seat at the gallery.", "Two partners claim this buyer."]);
  check("an offered time reads the way a buyer says it", [SR.offerLabel("2026-10-03T05:30:00Z"), SR.offerLabel("2026-10-03T11:00:00Z")], ["Sat 3 Oct, 11 am", "Sat 3 Oct, 4:30 pm"]);
  check("a button carries its hold and nothing else", [SR.holdFromPayload(SR.holdPayload("0f8fad5b-d9cb-469f-a165-70867728950e")), SR.holdFromPayload("slot:../x"), SR.holdFromPayload(null)],
    ["0f8fad5b-d9cb-469f-a165-70867728950e", null, null]);

  const steps = K2.visitSteps({ leadId: "L1", visitId: "V1", atIso: "2026-10-03T06:30:00Z", nowIso: "2026-10-01T06:30:00Z" });
  check("a booked visit is asked the admission gate on booking, the day before and two hours before",
    steps.filter((s) => s.purpose === "ADMIT_CHECK").map((s) => s.key), ["V1:ADMIT_CHECK:booked", "V1:ADMIT_CHECK:day", "V1:ADMIT_CHECK:soon"]);
  const byDue = [...steps].sort((a, b) => Date.parse(a.dueAt) - Date.parse(b.dueAt)).map((s) => s.purpose);
  check("each check a moment before what goes out then", [byDue.indexOf("ADMIT_CHECK") < byDue.indexOf("VISIT_CONFIRMED"),
    byDue.lastIndexOf("ADMIT_CHECK") < byDue.indexOf("VISIT_REMINDER_SOON")], [true, true]);
  check("a full hour's offer goes at once, and a person is asked in an hour",
    K2.offerSteps({ leadId: "L1", visitId: "V1", nowIso: "2026-10-01T06:30:00Z" }).map((s) => [s.purpose, s.dueAt]),
    [["SLOT_OFFER", "2026-10-01T06:30:00Z"], ["OFFER_CHECK", "2026-10-01T07:30:00.000Z"]]);
  check("an offer runs only while the visit waits, a re-offer only before a visit is booked",
    [K2.stillRelevant("SLOT_OFFER", { stage: "visit_scheduled", visitStatus: "REQUESTED" }), K2.stillRelevant("SLOT_OFFER", { stage: "visit_scheduled", visitStatus: "CONFIRMED" }),
      K2.stillRelevant("VISIT_REOFFER", { stage: "contacted", visitStatus: null }), K2.stillRelevant("VISIT_REOFFER", { stage: "visit_scheduled", visitStatus: "CONFIRMED" })],
    [null, "A time was already fixed", null, "Already booked a visit"]);
  const offerT = M2.TEMPLATES.SLOT_OFFER;
  check("the offer's three buttons are fixed words, and its body names three times", [offerT.buttons, offerT.blanks.filter((b) => b.startsWith("slot_")).length], [["Book 1", "Book 2", "Book 3"], 3]);
  const req = W2.templateRequest(offerT, "en", offerT.body);
  check("a template with buttons is submitted with them", req.components.map((c) => c.type), ["BODY", "BUTTONS"]);
  check("and its hash moves when its buttons do, while a template without any hashes as it always did",
    [W2.templateHashInput(offerT, "en", offerT.body) !== W2.templateHashInput({ ...offerT, buttons: ["Yes"] }, "en", offerT.body),
      W2.templateHashInput(M2.TEMPLATES.ACK, "en", M2.TEMPLATES.ACK.body) === JSON.stringify([M2.TEMPLATES.ACK.name, "en", M2.TEMPLATES.ACK.category, M2.TEMPLATES.ACK.body])],
    [true, true]);
  check("the new templates' words pass Meta's own checks", ["SLOT_OFFER", "VISIT_REOFFER", "VISIT_CANCELLED"].map((p) => {
    const t = M2.TEMPLATES[p as keyof typeof M2.TEMPLATES];
    return W2.bodyProblems(t.body, t.blanks.length).length;
  }), [0, 0, 0]);
}

// ---------------------------------------------------------------------------
// The pixel gate: what the finished picture was read to carry
// ---------------------------------------------------------------------------
{
  console.log("\nThe pixel gate: reading the number, the QR, the block, the prices");
  const P = await import("../src/lib/pixel-rules.ts");
  const REG = "P52100012345";
  const E = {
    registrationNo: REG,
    authority: P.MAHARERA_RULE,
    qrPayload: `https://maharera.maharashtra.gov.in/projects/${REG}`,
    phone: "+91 98765 00000",
    website: "sathheights.example",
    render: true,
    contact: true,
    configurations: [
      { config: "2BHK", label: "2 BHK", startingPrice: 2_18_24_000 },
      { config: "1BHK", label: "1 BHK", startingPrice: 1_45_00_000 },
    ],
    money: [5_00_000],
    registrationDaysLeft: 400,
  };
  const clean = P.cleanReading(E);
  const codes = (r: ReturnType<typeof P.cleanReading>, e = E) => P.judgeFrame(r, e).map((f) => f.code);
  check("a frame carrying everything reads clean", codes(clean), []);

  // The number, character for character.
  const digits = Array.from({ length: 12 }, () => ({ w: 6.6, h: 10 }));
  const shaped = (at: number, w: number) => digits.map((g, i) => (i === at ? { w, h: 10 } : g));
  check("the number read exactly is exact", P.readRegistration(REG, "P52100012345").kind, "exact");
  check("an O for a 0, read as a letter, is a misprint", P.readRegistration(REG, "P521OO012345").kind, "misprint");
  check("but a 0 the reader called O, shaped like the other figures, is a 0",
    P.readRegistration(REG, "P521O0012345", shaped(4, 6.6)).kind, "exact");
  check("an O shaped like an O is a misprint whatever the reader said",
    P.readRegistration(REG, "P52100012345", shaped(4, 9.4)).kind, "misprint");
  check("an I shaped like a bar is a misprint, a 1 with its flag is not",
    [P.readRegistration(REG, "P52100012345", shaped(3, 1.4)).kind, P.readRegistration(REG, "P52100012345", shaped(3, 3.4)).kind], ["misprint", "exact"]);
  check("another figure is another number", P.readRegistration(REG, "P52100012346").kind, "different");
  check("any exact read of the number wins over a slip in another",
    P.bestRead(REG, ["P5210001234", "P52100012345"])?.kind, "exact");
  const lines = (...texts: string[]) => texts.map((t, i) => ({ words: t.split(" ").map((w, k) => ({ text: w, box: { x: k * 60, y: i * 30, w: 50, h: 20 } })) }));
  check("the number is found however the reader slipped on I and O, and returned as read",
    P.locateRegistration(lines("MahaRERA No. P521OO012345"), REG)[0]?.raw, "P521OO012345");
  check("the phone by its digits, whatever became of the spaces",
    P.locatePhone(lines("+9198765 00000"), "+91 98765 00000")[0]?.raw, "9876500000");
  check("artist's impression across a line the reader split",
    (P.locateImpression(lines("apply. Artist's pression. The"))[0]?.edits ?? 9) <= 3, true);

  // The block.
  const reg = clean.registration!;
  check("a number smaller than the phone fails", codes({ ...clean, registration: { ...reg, glyphPx: 10 } }), ["REG_SMALL"]);
  check("within the measuring error it is as large", codes({ ...clean, phone: { ...clean.phone!, glyphPx: reg.glyphPx! * 1.04 } }), []);
  check("a state whose rule does not measure against the contact line is not measured",
    codes({ ...clean, registration: { ...reg, glyphPx: 10 } }, { ...E, authority: { ...P.MAHARERA_RULE, sizeAgainstContact: false } }), []);
  check("a block outside the upper-right quarter fails", codes({ ...clean, registration: { ...reg, box: { x: 100, y: 700, w: 200, h: 20 } } }), ["LOCKUP_OUTSIDE"]);
  check("where the rule is a strip along the foot, the quarter is outside it",
    codes(P.cleanReading({ ...E, authority: { ...P.MAHARERA_RULE, place: "BOTTOM_STRIP" } }), { ...E, authority: { ...P.MAHARERA_RULE, place: "BOTTOM_STRIP" } }), []);
  check("the quarter allows a reader's pixel and no more",
    [P.inQuarter({ x: 538, y: 0, w: 100, h: 100 }, 1080, 1080), P.inQuarter({ x: 520, y: 0, w: 100, h: 100 }, 1080, 1080)], [true, false]);
  check("faint type fails for contrast", codes({ ...clean, website: { ...clean.website!, contrast: 2.1 } }), ["CONTRAST_LOW"]);
  check("no website fails", codes({ ...clean, website: null }), ["WEBSITE_MISSING"]);
  check("no phone where a phone belongs fails; where none belongs, it does not",
    [codes({ ...clean, phone: null }), codes({ ...clean, phone: null }, { ...E, contact: false })], [["CONTACT_UNREAD"], []]);
  check("no artist's impression on a render fails; on a photograph it is not asked",
    [codes({ ...clean, impression: null }), codes({ ...clean, impression: null }, { ...E, render: false })], [["NO_IMPRESSION"], []]);

  // The QR.
  const qr = clean.qr;
  check("a QR that does not scan fails", codes({ ...clean, qr: { ...qr, payload: null } }), ["QR_UNREADABLE"]);
  check("one too small at a size a buyer meets it fails",
    codes({ ...clean, qr: { ...qr, renditions: qr.renditions.map((r) => ({ ...r, ok: !r.name.includes("60") })) } }), ["QR_TOO_SMALL"]);
  check("one opening another phase fails", codes({ ...clean, qr: { ...qr, payload: "https://maharera.maharashtra.gov.in/projects/P52100099999" } }), ["QR_WRONG"]);
  check("the approved lockup's own payload is the one", P.qrIsThisPhase("https://x.example/a", "https://x.example/a", REG), true);
  check("one naming another registration is not, even with no lockup to compare", P.qrIsThisPhase("https://x.example/P52100099999", null, REG), false);
  check("an approved QR that opens no authority page holds",
    P.verdictOf(P.judgeFrame({ ...clean, qr: { ...qr, payload: "https://example.com/p" } }, { ...E, qrPayload: "https://example.com/p" })), "HOLD");
  check("a state that asks for no QR does not fail for none, where none was approved",
    codes({ ...clean, qr: { box: null, payload: null, renditions: [] } }, { ...E, qrPayload: null, authority: { ...P.MAHARERA_RULE, qrRequired: false } }), []);
  check("an exempt tower carries no block and passes", codes(P.cleanReading({ ...E, registrationNo: null, qrPayload: null }), { ...E, registrationNo: null, qrPayload: null }), []);

  // Prices, read by the unit rules.
  const at = (text: string, y: number) => ({ text, box: { x: 60, y, w: 500, h: 40 } });
  check("the rupee sign misread as a digit is still the price",
    P.amountsIn("2 BHK starting at 32.19 Cr*")[0].alternatives.includes(2_19_00_000), true);
  check("so is a price with its decimal point lost", P.amountsIn("219 Cr")[0].alternatives.includes(2_19_00_000), true);
  check("noise off a busy picture is no price: a lone L without a rupee sign, a figure glued to a letter",
    [P.amountsIn("2 L"), P.amountsIn("k4L"), P.amountsIn("₹45 L").map((a) => a.value), P.amountsIn("Starting 2.19 Cr").map((a) => a.value), P.amountsIn("F2.19 Cr").map((a) => a.value)],
    [[], [], [45_00_000], [2_19_00_000], [2_19_00_000]]);
  check("and one read with a space after its decimal point", P.amountsIn("2 BHK starting at 72. 19 Cr*")[0].alternatives.includes(2_19_00_000), true);
  check("a configuration's own price passes", P.priceProblems([at("2 BHK starting at ₹2.19 Cr*", 600)], E.configurations, E.money), []);
  check("the 2 BHK's price beside the 1 BHK fails",
    P.priceProblems([at("1 BHK starting at ₹2.19 Cr*", 600)], E.configurations, E.money).map((f) => f.code), ["PRICE_WRONG_CONFIG"]);
  check("even when a second read dropped the 1",
    P.priceProblems([at("1 BHK starting at ₹2.19 Cr*", 600), at("BHK starting at ¥2.19 Cr", 601)], E.configurations, E.money).map((f) => f.code), ["PRICE_WRONG_CONFIG"]);
  check("a configuration named on the line above counts",
    P.priceProblems([at("1 BHK starting at", 560), at("₹2.19 Cr*", 604)], E.configurations, E.money).map((f) => f.code), ["PRICE_WRONG_CONFIG"]);
  check("a line one read garbled is cleared by the read that saw it plainly",
    P.priceProblems([at("2 BHK starting at 32 19 Cr", 600), at("2 BHK starting at ₹2.19 Cr*", 602)], E.configurations, E.money), []);
  check("a signed booking amount beside a configuration passes",
    P.priceProblems([at("2 BHK from Rs 2,18,24,000. Booking Rs 5,00,000", 600)], E.configurations, E.money), []);
  check("a price nobody approved fails", P.priceProblems([at("Only ₹99 Lakh", 600)], E.configurations, E.money).map((f) => f.code), ["PRICE_UNKNOWN"]);
  check("signed amounts include how an ad prints them", P.signedAmounts(["Booking amount: Rs 2,50,500"]).includes(2_51_000), true);

  // What cannot be settled, and the record.
  check("a registration inside thirty days of lapsing holds", P.verdictOf(P.judgeFrame(clean, { ...E, registrationDaysLeft: 30 })), "HOLD");
  check("a reader that failed holds", P.verdictOf(P.judgeFrame({ ...clean, error: "x" }, E)), "HOLD");
  check("a changed render fails, a re-encoded one does not",
    [codes({ ...clean, region: { meanDiff: 30, closeShare: 0.4 } }), codes({ ...clean, region: { meanDiff: 1.2, closeShare: 0.99 } })], [["RENDER_CHANGED"], []]);
  check("FAIL outranks HOLD outranks PASS",
    [P.verdictOf([{ verdict: "HOLD" }, { verdict: "FAIL" }]), P.verdictOf([{ verdict: "HOLD" }]), P.verdictOf([])], ["FAIL", "HOLD", "PASS"]);
  const fail = P.finding("REG_SMALL");
  const rec = P.pixelRecord({ engine: "t", now: new Date("2026-09-29T00:00:00Z"), registrationNo: REG, files: [
    { sha256: "a".repeat(64), frames: [{ findings: [] }] },
    { sha256: "b".repeat(64), frames: [{ at: 1, findings: [fail] }, { at: 2, findings: [fail] }] },
  ] });
  check("a record is FAIL when any file failed, and names each file's own verdict",
    [rec.verdict, rec.files.map((f) => [f.verdict, f.frames])], ["FAIL", [["PASS", 1], ["FAIL", 2]]]);
  check("a code found on two frames is one line", rec.findings.map((f) => [f.code, f.file, f.at]), [["REG_SMALL", 1, 1]]);
  check("a record with no file is not a PASS", P.pixelRecord({ engine: "t", now: new Date(), registrationNo: null, files: [] }).verdict, "HOLD");
  const ok = P.pixelRecord({ engine: "t", now: new Date(), registrationNo: REG, files: [{ sha256: "a".repeat(64), frames: [{ findings: [] }] }] });
  check("publishing: a PASS on these files under this registration goes", P.pixelRefusal(ok, [{ sha256: "a".repeat(64) }], "P521 0001 2345"), null);
  check("publishing: no record, a FAIL, a HOLD, other files, another registration are refused",
    [
      P.pixelRefusal(null, [{ sha256: "a".repeat(64) }], REG)?.code,
      P.pixelRefusal(rec, [{ sha256: "a".repeat(64) }, { sha256: "b".repeat(64) }], REG)?.code,
      P.pixelRefusal({ ...ok, verdict: "HOLD" }, [{ sha256: "a".repeat(64) }], REG)?.code,
      P.pixelRefusal(ok, [{ sha256: "c".repeat(64) }], REG)?.code,
      P.pixelRefusal(ok, [{}], REG)?.code,
      P.pixelRefusal(ok, [{ sha256: "a".repeat(64) }], "P52100099999")?.code,
    ],
    ["PIXEL_UNCHECKED", "PIXEL_FAIL", "PIXEL_HOLD", "PIXEL_STALE", "PIXEL_STALE", "PIXEL_OTHER_REGISTRATION"]);

  // Inside the design loop, and on a video.
  const asProblems = P.asDesignProblems([P.finding("REG_SMALL"), P.finding("QR_WRONG"), P.finding("PRICE_UNKNOWN"), P.finding("REG_LAPSING")], { lockup: true, copy: false });
  check("what the model drew is its to fix; what we stamped, and a HOLD, are not",
    asProblems.map((p) => [p.code, p.fixable]), [["PX_REG_SMALL", true], ["PX_QR_WRONG", false], ["PX_PRICE_UNKNOWN", false]]);
  check("and no fix it is sent carries a number", Object.values(P.PIXEL_FIX).some((f) => /[0-9]/.test(f ?? "")), false);
  check("a video is read at the first, middle and last of every shot, and the end card as it settles",
    P.sampleTimes([{ start: 0, end: 2 }, { start: 2, end: 5 }], { start: 5, end: 8 }), [0.3, 1, 1.7, 2.4, 3.5, 4.6, 7.6]);
  check("every client line is a sentence with no rule's name in it",
    Object.values(P.PIXEL_TEXT).every((t) => /[.]$/.test(t) && !/[A-Z]{2,}_[A-Z]/.test(t)), true);
}

