  check("the camera is locked and only nature moves", [still.prompt.includes("locked off"), still.prompt.includes("clouds drift")], [true, true]);
  check("and every word, the logo and the QR stay still", still.prompt.includes("stay perfectly still, sharp and unchanged"), true);
  check("indoors it is the light and the curtains, not the sky", c.motionPrompt("interior").prompt.includes("curtains stir"), true);
  check("camera moves and melting letters are asked against", ["zoom", "warped letters", "extra floors"].every((w) => still.negative.includes(w)), true);
  check("a retry is stricter", c.motionPrompt("exterior", true).prompt.includes("No new objects, no new text"), true);
  check("three five-second shots is a fifteen-second reel", c.VIDEO_SHOTS * c.SHOT_SECONDS, 15);
  const drift = c.judgeMotion([
    { code: "BUILDING_CHANGED", text: "The building does not match the approved photo.", fixable: true },
    { code: "RERA_TEXT_SMALL", text: "x", fixable: true },
    { code: "DESIGN_WEAK", text: "x", fixable: true },
    { code: "TEXT_WRONG", text: "A word of the copy came out a letter different.", fixable: false, soft: true },
  ]).map((p: { code: string; text: string }) => [p.code, p.text]);
  check("a clip is judged only on what motion can break, not re-judged on the layout its frame passed",
    drift, [["BUILDING_CHANGED", "The building does not match the approved photo. (after motion)"]]);

  // A logo set with nothing behind it keeps its colours where they show.
  check("contrast runs from one to twenty one", [c.contrast([0, 0, 0], [0, 0, 0]), Math.round(c.contrast([255, 255, 255], [0, 0, 0]))], [1, 21]);
  check("a navy logo on a blue sky keeps its colours", c.markColour([27, 58, 134], [94, 160, 224]), "as-is");
  check("on a dark footer band it turns white", c.markColour([27, 58, 134], [15, 23, 44]), "white");
  check("a white logo on a white wall turns dark", c.markColour([255, 255, 255], [245, 245, 240]), "ink");
  check("a dark logo on white keeps its colours", c.markColour([17, 17, 17], [255, 255, 255]), "as-is");

  // The registration block's words sit straight on the picture, with a shade
  // behind them only as strong as the picture needs (30 September 2026).
  const sky = Array.from({ length: 100 }, () => [200, 225, 245]);
  const dusk = Array.from({ length: 100 }, () => [22, 40, 60]);
  check("on a pale sky the words are dark, with no shade", c.blockShade(sky, false), { ink: "dark", alpha: 0 });
  check("on a dark facade they are white, with no shade", c.blockShade(dusk, false), { ink: "white", alpha: 0 });
  const mid = c.blockShade(Array.from({ length: 100 }, () => [128, 128, 128]), false);
  check("on a mid grey a shade comes in, and it is enough",
    [mid.alpha > 0, c.contrast(mid.ink === "white" ? [255, 255, 255] : [17, 17, 17],
      [128, 128, 128].map((v) => v + ((mid.ink === "white" ? 0 : 255) - v) * mid.alpha)) >= c.BLOCK_CONTRAST], [true, true]);
  const film = c.blockShade(dusk, true);
  check("a film takes white over a shade that holds on white, whatever its first frame showed",
    [film.ink, c.contrast([255, 255, 255], [255, 255, 255].map((v) => v * (1 - film.alpha))) >= c.BLOCK_CONTRAST, film.alpha < 0.7], ["white", true, true]);
  const busy = [...Array.from({ length: 90 }, () => [30, 30, 30]), ...Array.from({ length: 10 }, () => [250, 250, 250])];
  check("a few bright pixels behind white words still bring the shade", c.blockShade(busy, false).alpha > 0, true);
  const L1 = c.layoutFor(1080, 1080);
  check("the QR is as small as its code allows: a 33-module code at 93 px", c.qrSideFor(33, L1), 93);
  check("and a little larger on a film, which is encoded after it", c.qrSideFor(33, L1, true), 103);
  check("a denser one is set larger", c.qrSideFor(53, L1) > c.qrSideFor(33, L1), true);
  check("and one of unknown density is given a dense code's room", c.qrSideFor(null, L1), c.qrSideFor(45, L1));
  check("never past 16 per cent of the short side", c.qrSideFor(177, L1), Math.round(1080 * 0.16));
  check("the model is asked for it as a share of the width", c.qrPercentFor(33, 1080, 1080), 9);

  const good = {
    texts: ["Sea facing homes", "Two lifts per wing", "Book a visit", "Artist's impression."],
    registration: "MahaRERA Reg. No. P52100012345", phone: "+91 98765 01234", textCutOff: false,
    buildingMatches: true, buildingIssues: "", looksLikeAd: true, designIssues: "",
    reraWebsite: "maharera.maharashtra.gov.in", reraTopRight: true, reraTextLargeEnough: true,
  };
  const fine = { qrFound: true, qrInQuadrant: true, qrBigEnough: true, logoSlot: true };
  const judge = (review: Partial<typeof good>, f: Partial<typeof fine> = {}) =>
    c.judgeDesign({
      review: { ...good, ...review }, expected: ["Sea facing homes"], allowed: [...good.texts, ...c.NEUTRAL_LABELS],
      registrationNo: "P52100012345", phone: "+919876501234",
      qr: { lockup: true, expected: "q", read: "q" }, full: { ...fine, ...f },
    });
  const codes = (ps: { code: string }[]) => ps.map((p) => p.code);
  check("a whole design with everything in place passes", codes(judge({})), []);
  check("no QR drawn is the model's to fix", judge({}, { qrFound: false }).map((p: { code: string; fixable: boolean }) => [p.code, p.fixable]), [["QR_NOT_DRAWN", true]]);
  check("a QR outside the quarter", codes(judge({}, { qrInQuadrant: false })), ["RERA_POSITION"]);
  check("a QR too small to scan", codes(judge({}, { qrBigEnough: false })), ["QR_TOO_SMALL"]);
  check("no MahaRERA website", codes(judge({ reraWebsite: "" })), ["RERA_WEBSITE"]);
  check("a number smaller than the phone", codes(judge({ reraTextLargeEnough: false })), ["RERA_TEXT_SMALL"]);
  check("a wrong number is now the model's to fix, quoting the right one",
    judge({ registration: "P52100099999" }).map((p: { fixable: boolean; fix?: string }) => [p.fixable, p.fix?.includes("P52100012345")]),
    [[true, true]]);
  check("a missing logo slot is worth another try but does not fail the post",
    judge({}, { logoSlot: false }).map((p: { code: string; soft?: boolean }) => [p.code, p.soft]), [["LOGO_SLOT", true]]);
  // Exempt: nothing in place of the registration block, so no QR drawn, no
  // Authority website and no block in the quarter is exactly right.
  check("an exempt tower's whole design passes with no registration block at all",
    codes(c.judgeDesign({
      review: { ...good, registration: "", reraWebsite: "", reraTopRight: false, reraTextLargeEnough: false },
      expected: ["Sea facing homes"], allowed: [...good.texts, ...c.NEUTRAL_LABELS],
      registrationNo: null, phone: "+919876501234",
      qr: { lockup: false, expected: null, read: null }, full: { ...fine, qrFound: false, qrInQuadrant: false, qrBigEnough: false },
    })), []);
  check("and its design instruction asks for no registration block",
    full({ registrationNo: null }).includes("REGISTRATION BLOCK"), false);
  check("the words around a phone number are not inventions",
    codes(judge({ texts: [...good.texts, "Call us", "Our Website", "MahaRERA Registration No."] })), []);
  const L = c.layoutFor(1080, 1080);
  check("our own panel is wide enough for the website at the number's size",
    L.lockup.w >= Math.ceil(L.regSize * 0.56 * c.RERA_WEBSITE.length), true);
  check("and the number is still larger than the contact line", L.regSize > L.contactSize, true);
}

