check("embedded PAN is extracted", (validateGstin("27AAPFU0939F1ZV") as { pan: string }).pan, "AAPFU0939F");
check("lowercase + spaces normalise", validateGstin(" 27aapfu0939f1zv ").ok, true);
check("wrong check digit rejected", validateGstin("27AAPFU0939F1ZX").ok, false);
