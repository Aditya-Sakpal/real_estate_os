check("an address starting with a formula character is refused",
  ["=1+1@x.co", "+ravi@billbay.com", "-ravi@billbay.com", "@ravi@billbay.com"].map(looksLikeEmail),
  [false, false, false, false]);
check("but one merely containing them passes",
  looksLikeEmail("ravi+leads@bill-bay.com"), true);
check("case and padding are normalised", normaliseEmail("  Ravi@BillBay.com "), "ravi@billbay.com");

// The whole reason there is no expiry column: the message is not a credential.
