  const passing = { problems: [{ code: "LOGO_SLOT", text: "", fixable: true, soft: true }] };
  const failingOne = { problems: [{ code: "TEXT_CUT", text: "", fixable: true }] };
  check("an attempt that passes beats one that does not, soft notes and all", c.betterDesign(failingOne, passing), passing);
}

