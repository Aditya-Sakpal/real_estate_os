  check("with 80 of ours, ours takes over", [c.marketWeight, c.score < 1], [0.2, true]);
  check("a value the market never ran counts nothing of it", L.blend(new Map([["angle|VIEW", { qualified: 2, spend: 1, ads: 1, score: 1.4 }]]), market, 20)
    .find((b) => b.value === "VIEW")!.marketWeight, 0);

  const rand = L.seeded("run-1");
  check("a seeded draw repeats", [rand(), rand()].join(), (() => { const r = L.seeded("run-1"); return [r(), r()].join(); })());
  const scoreOf = (o: string) => (o === "A" ? 3 : 0.5);
  const picks = Array.from({ length: 200 }, (_, i) => L.pickLearned(["A", "B", "C"], scoreOf, { learnt: true, explore: 0.2, rand: L.seeded(`p${i}`), recent: [] }));
  const learnt = picks.filter((p) => p.by === "LEARNT");
  check("most posts follow the scores, and a clear winner wins most of those", learnt.filter((p) => p.pick === "A").length / learnt.length > 0.9, true);
  check("about a fifth explore", Math.abs(picks.filter((p) => p.by === "EXPLORE").length / 200 - 0.2) < 0.08, true);
  check("never the same choice twice running when there is another",
