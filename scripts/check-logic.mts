console.log("\nProject Brain: the number on the advertisement is the number on the filing");
// A phase can be perfectly advertisable and still carry a Brain naming a
// registration it does not hold. The gate answers permission, this answers
// identity, and a buyer checks the project against the number that is printed.
const FILED = "P52100012345";
check("the filing and the Brain agreeing publishes",
  matchesFiling({ draft: FULL, filed: FILED, nodeKind: "PHASE" }).ok, true);
check("a number the phase is not registered under is refused",
  (matchesFiling({
    draft: { ...FULL, "rera.registration_no": "P52100099999" },
    filed: FILED,
    nodeKind: "PHASE",
  }) as { code: string }).code,
  "REGISTRATION_MISMATCH");
check("and the refusal names both numbers, so the correction is obvious",
  /P52100012345.*P52100099999/.test(
    (matchesFiling({
      draft: { ...FULL, "rera.registration_no": "P52100099999" },
      filed: FILED,
      nodeKind: "PHASE",
    }) as { message: string }).message),
  true);
// Spacing and case are how two people write the same number, and neither is
// part of it. Refusing those would train everybody to ignore the refusal.
check("spacing and case are not a mismatch",
  matchesFiling({
    draft: { ...FULL, "rera.registration_no": " p521 000 12345 " },
    filed: FILED,
    nodeKind: "PHASE",
  }).ok,
  true);
check("normalising strips the spacing and raises the case",
  normaliseRegistration(" p521 000 12345 "), "P52100012345");
// An exemption registers nothing, so there is no number to print.
check("stating a registration where none is filed is refused",
  (matchesFiling({ draft: FULL, filed: null, nodeKind: "PHASE" }) as { code: string }).code,
  "REGISTRATION_UNFILED");
// Emptiness belongs to the required-field rule. Asked twice, a blank field
// reports a mismatch, which is a refusal about a value nobody typed.
check("an empty field is the required rule's business, not this one",
  matchesFiling({
    draft: { ...FULL, "rera.registration_no": "" },
    filed: FILED,
    nodeKind: "PHASE",
  }).ok,
  true);
check("and a project is never measured against a filing it cannot hold",
  matchesFiling({ draft: FULL, filed: null, nodeKind: "PROJECT" }).ok, true);

