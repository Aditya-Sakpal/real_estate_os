  // its own, never as scenery. Construction stays out unless a template asks.
  check("plans and the lockup are never a background",
    bg.map((p: { category: string }) => p.category).includes("FLOOR_PLAN") ||
      bg.map((p: { category: string }) => p.category).includes("RERA_LOCKUP"), false);
  check("construction is not an ordinary background",
    bg.map((p: { category: string }) => p.category).includes("CONSTRUCTION"), false);
  check("a cover is an exterior when there is one",
    c.picturesFor(bg, 1, 0)[0].category, "EXTERIOR_RENDER");
  check("the next post opens on a different exterior",
    c.picturesFor(bg, 1, 1)[0].assetId === c.picturesFor(bg, 1, 0)[0].assetId, false);
  check("a carousel's slides use different pictures",
    new Set(c.picturesFor(bg, 4, 0).map((p: { assetId: string }) => p.assetId)).size, 4);
  check("fewer pictures than slides repeats them rather than failing",
