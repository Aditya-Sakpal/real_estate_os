console.log("\nFiles from CloudFront");
{
  const { generateKeyPairSync, createVerify } = await import("node:crypto");
  const { privateKey, publicKey } = generateKeyPairSync("rsa", { modulusLength: 2048 });
  const pem = privateKey.export({ type: "pkcs1", format: "pem" }).toString();
  check("CloudFront is off until all three settings are there, and refuses a base that is not https",
    [CDN.cdnConfig({}), CDN.cdnConfig({ CDN_BASE_URL: "http://x.net", CDN_KEY_PAIR_ID: "K1", CDN_PRIVATE_KEY: pem }), !!CDN.cdnConfig({ CDN_BASE_URL: "https://d1.cloudfront.net/", CDN_KEY_PAIR_ID: "K1", CDN_PRIVATE_KEY: pem.replace(/\n/g, "\n") })],
    [null, null, true]);
  const cfg = CDN.cdnConfig({ CDN_BASE_URL: "https://d1.cloudfront.net", CDN_KEY_PAIR_ID: "K1", CDN_PRIVATE_KEY: pem })!;
  const at = new Date("2026-10-07T12:00:00Z");
  const url = CDN.cdnSignedUrl(cfg, "org/o1/project/p1/post/a b.thumb.webp", at);
  const u = new URL(url);
  const policy = JSON.stringify({ Statement: [{ Resource: `${u.origin}${u.pathname}`, Condition: { DateLessThan: { "AWS:EpochTime": 1791374400 } } }] });
  const sig = Buffer.from(u.searchParams.get("Signature")!.replace(/-/g, "+").replace(/_/g, "=").replace(/~/g, "/"), "base64");
  check("a CloudFront link names the file, its expiry and key, and its signature verifies",
    [u.pathname, u.searchParams.get("Expires"), u.searchParams.get("Key-Pair-Id"), createVerify("RSA-SHA1").update(policy).verify(publicKey, sig)],
    ["/org/o1/project/p1/post/a%20b.thumb.webp", "1791374400", "K1", true]);
  check("the same file and moment give the same link", CDN.cdnSignedUrl(cfg, "org/o1/x", at) === CDN.cdnSignedUrl(cfg, "org/o1/x", at), true);
}

