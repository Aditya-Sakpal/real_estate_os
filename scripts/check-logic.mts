const twiceAWeek = { daysOfWeek: [2, 5], atMinute: 600, startsOn: null, endsOn: null };

const week = slotsBetween(twiceAWeek, {
  from: new Date("2026-03-01T00:00:00.000Z"),
  to: new Date("2026-03-08T00:00:00.000Z"),
});
check("two slots in a week", week.length, 2);
