// The three verdicts, driven through the real two-step.
const reply = (registered: string, revoked: string) => {
  let n = 0;
  return async () => {
    // GET, POST, GET, POST: the priming request then the search, twice.
    n += 1;
    if (n === 1 || n === 3) return new Response("<html></html>", { status: 200 });
    return new Response(n === 2 ? registered : revoked, { status: 200 });
  };
};
const MISS = "<html>Unable to find records</html>";
const BANNER =
  "<html>This project is revoked means the registration of this project has been cancelled.</html>";

const live = await searchRegistration("P51700000002",
  reply(card("P51700000002", "UNNATHI WOODS PHASE VII A", "UNNATHI ESTATES"), MISS));
check("a live registration reads REGISTERED",
  live.known && live.status === "REGISTERED", true);

const cancelled = await searchRegistration("P51700031957", reply(MISS, BANNER));
check("a cancelled one reads REVOKED",
  cancelled.known && cancelled.status === "REVOKED", true);

const never = await searchRegistration("P52100012345", reply(MISS, MISS));
check("one in neither register reads ABSENT",
  never.known && never.status === "ABSENT", true);

// THE safety property. A page carrying neither a result nor the portal's own
// no-match notice has changed shape, and reading it as "no such registration"
// would refuse a lawful filing on the strength of a parser bug.
const strange = await searchRegistration("P51700000002",
  reply("<html><body>Site under maintenance</body></html>", MISS));
check("an unrecognised page is an unknown, not a refusal", strange.known, false);
check("and says the shape probably changed",
  /shape/i.test((strange as { reason: string }).reason ?? ""), true);

const offline = await searchRegistration("P51700000002", async () => {
  throw new Error("ECONNREFUSED");
});
check("an unreachable portal is an unknown too", offline.known, false);
const err500 = await searchRegistration("P51700000002", async () =>
  new Response("", { status: 500 }));
check("and so is a 500", err500.known, false);


