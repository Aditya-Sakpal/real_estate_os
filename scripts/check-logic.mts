    ["8 min from the metro", "A 40,000 sq ft clubhouse"]);
  const v = L.chooseLearnedVariation({
    templates: [{ key: "PRICE_REVEAL", needsPrice: true }, { key: "LOCATION_LED", needsPrice: false }],
    pools: { talkingPoints: ["Sea facing", "8 min from the metro"], assetIds: ["a1"], hasPrice: false },
    recent: [], occasionId: null, scores: blended, pictureOf: () => "EXTERIOR_RENDER", explore: 0, rand: L.seeded("v"),
  });
  check("a scheduled post without an approved price never takes the price template", v.template, "LOCATION_LED");
  const leads = Array.from({ length: 100 }, (_, i) => L.chooseLearnedVariation({
    templates: [{ key: "LOCATION_LED", needsPrice: false }],
    pools: { talkingPoints: ["Sea facing", "8 min from the metro"], assetIds: [], hasPrice: false },
    recent: [], occasionId: null, scores: blended, pictureOf: () => null, explore: 0, rand: L.seeded(`lead${i}`),
  }).leadPoint);
  check("and leads with the point the market favours, most of the time", leads.filter((p) => p === "8 min from the metro").length > 60, true);

  const lines = L.playbookLines([...L.blend(own, new Map(), 20), ...blended]);
  check("the playbook says what works, with its own numbers", lines.some((l) => l.tone === "do" && /Carousels: \d+% more qualified buyers/.test(l.text)), true);
  check("and what the market leans on", lines.some((l) => l.tone === "market" && /Competitors lean on location and connectivity: 4 of 5 ads/.test(l.text)), true);

  // Reading a competitor's ad.
  const keys = ["07-location-and-connectivity"];
  const good = { text_seen: "8 min from Thane station", angle: "CONNECTIVITY", hook: "BENEFIT", picture: "EXTERIOR", language: "en",
    price_shown: true, price_from_rupees: 7500000, festive: false, design: "07-location-and-connectivity", locality: "Thane West", risky_claims: [] };
  const r = K.readingOf(good, "IMAGE", keys)!;
  check("a reading becomes our ingredients", [r.tags.angle, r.tags.template, r.tags.price, r.tags.priceFrom], ["CONNECTIVITY", "IMAGE:07-location-and-connectivity", "SHOWN", 7500000]);
  check("a value outside the vocabulary is refused, never guessed", K.readingOf({ ...good, angle: "VIBES" }, "IMAGE", keys), null);
  check("assured returns in its words flags it", K.readingOf({ ...good, text_seen: "Assured returns of 12%" }, "IMAGE", keys)!.flags.length, 1);
  check("the reader's schema is strict and names every field", (K.readerSchema(keys) as { required: string[] }).required.length, 11);
  check("pictures and videos are capped apart", [K.capProblem("picture", 59), K.capProblem("video", 20) !== null], [null, true]);
  check("an SVG is not an ad we read", K.fileProblem({ type: "image/svg+xml", size: 10 }) !== null, true);
  check("a video over 25 MB is refused", K.fileProblem({ type: "video/mp4", size: 26 * 1024 * 1024 }), "A video can be up to 25 MB.");
  check("a name starting like a formula is refused", K.readForm({ competitor: "=HYPERLINK()", projectName: "", locality: "", platform: "META", runningSince: "", today: "2026-09-29" }).ok, false);
  check("a start date in the future is refused", K.readForm({ competitor: "Lodha", projectName: "", locality: "", platform: "META", runningSince: "2026-10-01", today: "2026-09-29" }).ok, false);
}

