// ---------------------------------------------------------------------------
// RBAC. The permission catalog, scope arithmetic, and the rules that decide
// what a tenant is allowed to do to its own roles.
// ---------------------------------------------------------------------------

const permSet = (...keys: string[]) => new Set(keys);

const grant = (role: string, path: string, perms: string[]) => ({
  role,
  roleLabel: role,
  scopeNodeId: path,
  scopePath: path,
  scopeKind: "PROJECT" as const,
  scopeName: path,
  permissions: new Set(perms),
});

console.log("\nPermission catalog");
check(
  "no duplicate permission keys",
  PERMISSIONS.length,
  new Set(PERMISSIONS.map((p) => p.key)).size,
);
check(
  "every permission belongs to a declared group",
  PERMISSIONS.every((p) => PERMISSION_GROUPS.some((g) => g.key === p.group)),
  true,
);
// A typo in a role template would silently grant nothing at all, and the role
// would look correct in the editor while doing less than its owner believes.
const unknownInTemplates = DEVELOPER_ROLES.flatMap((r) =>
  r.permissions.filter((p) => p !== "*" && !PERMISSION_KEYS.has(p)),
);
check("no role template names a permission that does not exist", unknownInTemplates, []);
// Same failure mode in reverse: a rail item keyed to a permission nobody can
// hold is a section no role could ever open.
const unknownInNav = NAV.flatMap((n) => n.anyOf.filter((p) => !PERMISSION_KEYS.has(p)));
check("no nav item names a permission that does not exist", unknownInNav, []);
check("only the founding role holds the wildcard",
  DEVELOPER_ROLES.filter((r) => r.permissions.includes("*")).map((r) => r.key),
  ["ORG_ADMIN"]);
check("unknown keys are dropped on the way in",
  sanitisePermissions(["lead:read", "lead:teleport", "member:read"]),
  ["lead:read", "member:read"]);

console.log("\nScope arithmetic");
check("a grant covers its own node", scopeCovers("billbay.pune", "billbay.pune"), true);
check("a grant covers everything beneath it",
  scopeCovers("billbay.pune", "billbay.pune.trees.t_c"), true);
check("a grant does not cover its parent",
  scopeCovers("billbay.pune", "billbay"), false);
// The trap the dot exists to catch: a string prefix is not an ancestor.
check("a sibling sharing a prefix is not covered",
  scopeCovers("billbay.pune", "billbay.punekar"), false);
check("a deeper path is dropped when an ancestor is already held",
  minimalScopes(["billbay.pune", "billbay.pune.trees", "billbay.mumbai"]),
  ["billbay.mumbai", "billbay.pune"]);

console.log("\nAuthorization");
const psm = buildAuthz([
  grant("PROJECT_SALES_MANAGER", "billbay.pune.trees", ["lead:read", "lead:assign"]),
  grant("SITE_TEAM", "billbay.mumbai.vista.t_a", ["visit:confirm"]),
]);
check("holding a permission anywhere answers can()", psm.can("lead:assign"), true);
check("a permission held nowhere is refused", psm.can("payout:approve"), false);
check("holding it here is allowed",
  psm.canAt("lead:assign", "billbay.pune.trees.t_c"), true);
// Two grants, two different subtrees. Holding assign on Trees must not leak
// onto Vista just because the same person is on both projects.
check("holding it elsewhere is not holding it here",
  psm.canAt("lead:assign", "billbay.mumbai.vista"), false);
check("a query filter comes back as the subtrees that carry the permission",
  psm.scopesFor("lead:read"), ["billbay.pune.trees"]);
check("a permission held by neither grant filters to nothing",
  psm.scopesFor("payout:approve"), []);

const admin = buildAuthz([grant("ORG_ADMIN", "billbay", ["*"])]);
check("the wildcard answers for a permission it never lists",
  admin.can("campaign.budget:manage"), true);
check("the wildcard is still bounded by scope",
  admin.canAt("campaign.budget:manage", "someoneelse.pune"), false);
check("an auditor cannot reach buyer identities",
  buildAuthz([grant("AUDITOR", "billbay", roleByKey("AUDITOR")!.permissions)])
    .can("report.pii:read"),
  false);

console.log("\nRole resolution (templates merged with what a tenant changed)");
const asShipped = mergeRoles([]);
check("a tenant that changed nothing still has every shipped role",
  asShipped.length, DEVELOPER_ROLES.length);
check("an untouched role reports itself as shipped",
  asShipped.find((r) => r.key === "SALES_HEAD")?.source, "TEMPLATE");

const edited = mergeRoles([
  {
    key: "SALES_HEAD",
    label: "Regional Sales Head",
    description: "Ours.",
    min_kind: "REGION",
    can_delegate: false,
    source: "OVERRIDE",
    permissions: ["lead:read", "member:read"],
  },
  {
    key: "C_WAR_ROOM",
    label: "War Room",
    description: "Launch week only.",
    min_kind: "PROJECT",
    can_delegate: false,
    source: "CUSTOM",
    permissions: ["lead:read", "visit:read"],
  },
], new Map([["SALES_HEAD", 3]]));
check("an override replaces the template rather than adding to it",
  edited.filter((r) => r.key === "SALES_HEAD").length, 1);
check("the tenant's own name wins",
  edited.find((r) => r.key === "SALES_HEAD")?.label, "Regional Sales Head");
check("an edited role says so", edited.find((r) => r.key === "SALES_HEAD")?.customised, true);
check("an invented role joins the list",
  edited.find((r) => r.key === "C_WAR_ROOM")?.source, "CUSTOM");
check("usage counts attach to the merged role",
  edited.find((r) => r.key === "SALES_HEAD")?.memberCount, 3);
// The database refuses an ORG_ADMIN row outright. This is the second lock:
// even a row smuggled in some other way cannot narrow the founding role.
check("a row claiming to be the founding role is ignored",
  mergeRoles([{
    key: "ORG_ADMIN", label: "Nerfed", description: "", min_kind: "ORG",
    can_delegate: false, source: "OVERRIDE", permissions: ["lead:read"],
  }]).find((r) => r.key === "ORG_ADMIN")?.permissions,
  ["*"]);
check("the founding role is not editable",
  asShipped.find((r) => r.key === "ORG_ADMIN")?.editable, false);

console.log("\nRole editing");
const ADMIN_HOLDS = permSet("*");
const HEAD_HOLDS = permSet("lead:read", "lead:assign", "member:read", "member:invite");

check("a role needs a name",
  (validateRoleInput({ label: " ", permissions: [] }, ADMIN_HOLDS) as { error: string }).error,
  "Give the role a name.");
check("an admin may grant anything",
  (validateRoleInput(
    { label: "War Room", minKind: "PROJECT", permissions: ["payout:approve"] },
    ADMIN_HOLDS,
  ) as { value: { permissions: string[] } }).value.permissions,
  ["payout:approve"]);
// The rule that makes delegation safe the day it opens up: a Sales Head
// writing a role for their region cannot mint a permission they lack.
check("you cannot grant what you do not hold",
  (validateRoleInput(
    { label: "Shadow", minKind: "ORG", permissions: ["lead:read", "payout:approve"] },
    HEAD_HOLDS,
  ) as { error: string }).error,
  "You cannot give access you do not have yourself: Approve payouts.");
check("granting only what you hold is fine",
  validateRoleInput(
    { label: "Bench Lead", minKind: "REGION", permissions: ["lead:read", "lead:assign"] },
    HEAD_HOLDS,
  ).ok,
  true);
// Delegation is not a flag beside the role that can drift out of step with
// it. Holding member:invite IS the power to pass access on.
check("a role without the ability to add people does not delegate",
  (validateRoleInput(
    { label: "Deputy", minKind: "ORG", permissions: ["lead:read"] },
    ADMIN_HOLDS,
  ) as { value: { canDelegate: boolean } }).value.canDelegate,
  false);
check("a role that can add people delegates by definition",
  (validateRoleInput(
    { label: "Deputy", minKind: "ORG", permissions: ["member:invite"] },
    ADMIN_HOLDS,
  ) as { value: { canDelegate: boolean } }).value.canDelegate,
  true);
check("only the founding role ships able to add people",
  DEVELOPER_ROLES.filter((r) => r.permissions.includes("member:invite")).map((r) => r.key),
  []);
check("and it does so through the wildcard",
  mergeRoles([]).find((r) => r.key === "ORG_ADMIN")?.canDelegate, true);
// The other half: you cannot rewrite a role that already carries something
// you do not hold, even to narrow it.
check("you cannot edit a role above your own",
  (validateRoleInput(
    { label: "Sales Head", minKind: "ORG", permissions: ["lead:read"] },
    HEAD_HOLDS,
    ["lead:read", "lead.phone:unmask"],
  ) as { error: string }).error,
  "This role includes access you do not have: See real phone numbers.");
check("an admin may edit any of them",
  validateRoleInput(
    { label: "Sales Head", minKind: "ORG", permissions: ["lead:read"] },
    ADMIN_HOLDS,
    ["lead:read", "lead.phone:unmask"],
  ).ok,
  true);
check("an unknown level is refused",
  (validateRoleInput({ label: "Odd", minKind: "GALAXY", permissions: [] }, ADMIN_HOLDS) as { error: string }).error,
  "Pick a level for the role.");

check("an invented role is prefixed, so it can never shadow one we ship",
  customRoleKey("War Room", new Set()), "C_WAR_ROOM");
check("a clash takes a readable suffix",
  customRoleKey("War Room", new Set(["C_WAR_ROOM"])), "C_WAR_ROOM_2");
check("punctuation collapses rather than breaking the key",
  customRoleKey("Head, Sales & Marketing!", new Set()), "C_HEAD_SALES_MARKETING");
// A person who names their role "C_QA2" was not asking for C_C_QA2.
check("a name already carrying the prefix is not given it twice",
  customRoleKey("C_QA2", new Set()), "C_QA2");
check("in any case, and with a space for the underscore",
  [customRoleKey("c_qa2", new Set()), customRoleKey("c qa2", new Set())], ["C_QA2", "C_QA2"]);
check("and a clash still takes a suffix",
  customRoleKey("C_QA2", new Set(["C_QA2"])), "C_QA2_2");
check("a name that is only the letter C keeps it",
  customRoleKey("C_", new Set()), "C_C");

check("an org-level role can be granted at the org root",
  roleFitsScope({ minKind: "ORG" }, "ORG"), true);
// The ordering constraint, which is why the invite picker is short on day one.
check("a project-level role cannot be granted at the org root",
  roleFitsScope({ minKind: "PROJECT" }, "ORG"), false);
check("an org-level role can also be granted deeper down",
  roleFitsScope({ minKind: "ORG" }, "PHASE"), true);


