# ---------------------------------------------------------------------------
# Database. A local Postgres on 5432 by default; docker compose publishes 5434.
# ---------------------------------------------------------------------------
# Owner role. Runs migrations and the control-plane signup path (BYPASSRLS).
DATABASE_URL="postgres://salesdesk:salesdesk@localhost:5432/salesdesk"
# Tenant-scoped role. RLS is enforced on every query. Used for all app traffic.
DATABASE_APP_URL="postgres://salesdesk_app:salesdesk_app@localhost:5432/salesdesk"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
AUTH_SECRET=""          # openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Google Cloud console -> OAuth client (Web application)
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Entra ID app registration. IMPORTANT: set "Supported account types" to
# "Accounts in any organizational directory" -- NOT "...and personal Microsoft
# accounts". That is the first line of defence; the tid check is the second.
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/organizations/v2.0"

# ---------------------------------------------------------------------------
# Signup policy
# ---------------------------------------------------------------------------
# false = work accounts only (Google Workspace `hd` / Entra org `tid` required).
# Flip to true ONLY to unblock a design partner with no corporate IdP.
AUTH_ALLOW_PERSONAL_ACCOUNTS="false"

# Extra domains to refuse even if they somehow present as work accounts.
AUTH_EXTRA_BLOCKED_DOMAINS=""

# ---------------------------------------------------------------------------
# Connected accounts (Meta and Google). Nothing connects without these.
# ---------------------------------------------------------------------------
# Seals every connected account's token, per tenant. 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored token unreadable, so every tenant reconnects.
CONNECTOR_KEY=""

# Per-tenant data keys under AWS KMS (doc/claude-sections/kms.md). Set, every
# new seal is format 2 under the tenant's own data key; unset, sealing stays
# on CONNECTOR_KEY exactly as before. Keep CONNECTOR_KEY until
# `npm run vault:reseal` has moved every row. The key ARN, not an alias.
KMS_KEY_ARN=""
# Optional. The AWS profile for KMS; else the default credential chain.
AWS_KMS_PROFILE=""
# Development only, ignored on Vercel and in production: 32 bytes that stand
# in for KMS, with KMS_KEY_ARN="dev:local".
KMS_DEV_KEY=""

# Meta developer app (Facebook Login for Business). Redirect URI:
#   <AUTH_URL>/api/connect/meta/callback
# Deauthorize callback:  <AUTH_URL>/api/connect/meta/deauthorize
# Data deletion callback: <AUTH_URL>/api/connect/meta/data-deletion
META_APP_ID=""
META_APP_SECRET=""
# Optional. A Login for Business configuration that issues system-user tokens,
# which do not expire when the person who connected leaves.
META_CONFIG_ID=""

# Google Cloud OAuth client for the Ads and Business Profile scopes. A separate
# client from sign-in. Redirect URI: <AUTH_URL>/api/connect/google/callback
# Google Ads access is granted to THIS client's Cloud project (developer tokens
# were retired on 9 September 2026), so there is no developer token to set.
GOOGLE_CONNECT_CLIENT_ID=""
GOOGLE_CONNECT_CLIENT_SECRET=""
# "on" once Google has approved the Business Profile API for that project.
# Off, Connect Google asks for Google Ads alone.
GOOGLE_BUSINESS_PROFILE=""
# "on" once the Data Manager API is enabled for that project and its scope
# is verified on the consent screen. Outcomes (qualified, visits, bookings)
# go back to Google Ads through it; a Google connection made before needs
# reconnecting to grant the scope.
GOOGLE_DATA_MANAGER=""

# Optional overrides when a platform retires a version before a release does.
# META_GRAPH_VERSION="v26.0"
# GOOGLE_ADS_API_VERSION="v25"
# Optional. Where the platforms send people back, when AUTH_URL is not it.
# CONNECT_BASE_URL=""

# ---------------------------------------------------------------------------
# AI calling (Sarvam's hosted agent over a Vobiz line). doc/sarvam-qualifier-agent.md
# ---------------------------------------------------------------------------
# Two different Sarvam keys. The speech key (dashboard.sarvam.ai) voices the
# story reels; the Voice Agents key (indus.sarvam.ai/samvaad, Settings, API
# Key, starts sk_samvaad_) places calls. Each refuses the other's work.
SARVAM_API_KEY=""
SARVAM_AGENTS_KEY=""
# Vobiz, for putting a ready buyer through to the sales team.
VOBIZ_AUTH_ID=""
VOBIZ_AUTH_TOKEN=""
# The Vobiz voice app a rented number is linked to (else the one app answering at Sarvam).
VOBIZ_APP_ID=""
# Where a new calling number's "onboard it in Sarvam" email goes (else MAIL_FROM).
ALERT_EMAIL=""
SARVAM_ORG_ID=""
SARVAM_WORKSPACE_ID=""
SARVAM_APP_ID=""
SARVAM_APP_VERSION=""
SARVAM_CONNECTION_ID=""
SARVAM_FROM_NUMBER=""
# "on" once every agent's prompt reads call_project and project_facts
# (doc/sarvam-qualifier-agent.md section 13): each call is then handed the
# tower's signed facts. Until then neither is sent.
SARVAM_PROJECT_FACTS=""
# "on" once every agent's prompt reads say_words (section 15): each call is
# then handed how to say the tower's words, the region's places and its own.
SARVAM_SAY_WORDS=""
# "on" once every agent lists Kannada, Tamil, Telugu, Bengali and Gujarati and
# its prompt has a line for them: a call to a project in Karnataka, Tamil
# Nadu, Telangana, Andhra Pradesh, West Bengal or Gujarat then opens in that
# state's language unless the buyer's name says Hindi or Marathi.
SARVAM_REGIONAL_LANGUAGES=""
# The goal agent: a copy of the qualifier that reads call_goal, for a call a
# person sends to do one thing. Both, or calls with a goal stay switched off.
SARVAM_GOAL_APP_ID=""
SARVAM_GOAL_APP_VERSION=""
# Each job's own agent, a copy of the qualifier with that job's role
# (doc/sarvam-qualifier-agent.md section 10). Both of a pair, or the job
# falls back as that section says.
SARVAM_CONFIRMER_APP_ID=""
SARVAM_CONFIRMER_APP_VERSION=""
SARVAM_REENGAGER_APP_ID=""
SARVAM_REENGAGER_APP_VERSION=""
SARVAM_POSTVISIT_APP_ID=""
SARVAM_POSTVISIT_APP_VERSION=""
# The job agents in the other voices a client may pick on the AI agents screen:
# {"<job agent id>":{"priya":"<copy id>@<version>",...},...}. A voice with no copy is not offered.
SARVAM_VOICE_APPS=""
# The inbound receptionist: answers a buyer ringing a developer's own number
# (doc/sarvam-qualifier-agent.md section 19). Bound to the numbers by a
# Sarvam deployment; asks /api/calls/inbound/start at the start of each call.
SARVAM_RECEPTIONIST_APP_ID=""
SARVAM_RECEPTIONIST_APP_VERSION=""
# development or production: the one switch for every limit (src/lib/app-env.ts).
# development lifts plans, allowances, calling hours, Jimmy's limits and the
# story and schedule caps; production holds them. Unset, it is production on
# Vercel and in a production build, development otherwise.
ENVIRONMENT=""
# Development only: a folder of files named by number without the plus
# (919876543210), each holding DND or CLEAR, answering the DND lookup.
# Ignored when NODE_ENV is production and on Vercel.
DND_FIXTURE_DIR=""
# A host's voice note: Sarvam Saaras v3 on SARVAM_API_KEY, then one read.
# STT_MODEL="saaras:v3"
# NOTE_MODEL="gpt-5-mini"
# Development only: a folder of <sha256 of a 16 kHz WAV piece>.txt transcripts.
# A piece with no file goes to Sarvam. Ignored in production and on Vercel.
STT_FIXTURE_DIR=""
# Reads a competitor's ad for the learning (Library, Competitor ads).
# COMPETITOR_READER_MODEL="gpt-5-mini"
# Ask Jimmy's working memory: each chat's last six exchanges and its running
# summary. Without it the memory is Postgres alone and there is no summary.
REDIS_URL=""
# The public address Sarvam posts each call's result to.
CALLS_WEBHOOK_BASE=""
# A new organisation's hand-off number until it saves its own.
HANDOFF_DEFAULT_NUMBER=""

# ---------------------------------------------------------------------------
# WhatsApp: each developer connects their own number through Meta's
# Embedded Signup, with us as a Tech Provider. There is no shared number.
# The "WhatsApp Embedded Signup" configuration under Facebook Login for
# Business, on the same app as META_APP_ID:
# ---------------------------------------------------------------------------
META_WA_CONFIG_ID=""
# Optional: a BSP's multi-partner solution, when a BSP pays Meta for clients.
META_WA_SOLUTION_ID=""
# Only when WhatsApp sits on a different Meta app from META_APP_SECRET's.
WHATSAPP_APP_SECRET=""
# Development only: a system user token reaching the test account, which
# `npm run seed:whatsapp` puts on the dev tenant. Never set in production.
WHATSAPP_TOKEN=""

# ---------------------------------------------------------------------------
# Service SMS, the fallback when WhatsApp cannot carry a service message,
# through AWS End User Messaging, on each developer's own DLT registration.
# Unset: no SMS is sent. The profile's credentials need
# sms-voice:SendTextMessage; without a profile the default chain is used.
# ---------------------------------------------------------------------------
SMS_AWS_REGION=""
AWS_SMS_PROFILE=""
# Optional: a configuration set, for AWS's own event records.
SMS_CONFIGURATION_SET=""

# ---------------------------------------------------------------------------
# Leads arriving. Meta's webhook for lead forms and WhatsApp:
#   <AUTH_URL>/api/meta/webhook   (verify token below; fields: leadgen, messages,
#   message_template_status_update, message_template_quality_update,
#   template_category_update, account_update, phone_number_quality_update,
#   business_capability_update, smb_message_echoes, smb_app_state_sync, history)
# Website forms and Google Ads lead forms post to the address shown in
# Settings, Calling, under Lead capture.
# ---------------------------------------------------------------------------
META_WEBHOOK_VERIFY_TOKEN=""
# Optional. The public address for capture links and the enquiry page, when
# it is not AUTH_URL.
# CAPTURE_BASE_URL=""

# Optional. Property portal lead emails (99acres, MagicBricks, Housing.com,
# NoBroker). The domain an SES receipt rule receives them on, so each
# organisation gets leads-<org>-<key>@<domain>; and the SNS topic that rule
# publishes to, whose subscription /api/leads/portal confirms; a message is
# taken only from this topic and only with SNS's own signature. Without the
# domain, only the forwarding-service endpoint is offered. Production's is
# leads.salesdesk.app, received in account 111111111111 (ap-south-1); see
# doc/hosting.md, "Portal lead email".
# PORTAL_MAIL_DOMAIN="leads.salesdesk.app"
# PORTAL_SNS_TOPIC_ARN="arn:aws:sns:ap-south-1:111111111111:salesdesk-portal-mail"

# ---------------------------------------------------------------------------
# The developer's CRM (LeadSquared, Sell.Do or LeadRat). The keys are pasted
# in Settings, Connected accounts, CRM, and sealed with CONNECTOR_KEY. Run
# `npm run crm:run` every two to five minutes.
# ---------------------------------------------------------------------------
# Optional. The public https address CRM webhooks reach, when it is not the
# capture base. Without one, changes are polled every five minutes.
# CRM_WEBHOOK_BASE=""
# Dev only, never in production: answer every CRM request from an in-memory
# fake, so the CRM screen can be walked through without an account.
# CRM_FAKE="1"

# ---------------------------------------------------------------------------
# Billing. Top-ups through Razorpay; plans are invoiced for bank transfer.
# Test keys (rzp_test_) are the dev version: they work before KYC, move no
# money, and are refused on a production host. Live keys open buying only
# for an organisation the operator has switched to LIVE
# (npm run billing -- mode --org <id> --mode LIVE).
# Webhook: <AUTH_URL>/api/billing/razorpay  (events: payment.captured, payment.failed)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# The company on every invoice: Sales Desk Private Limited, never the parent company.
# Without its GSTIN no live purchase is offered and no tax invoice is issued.
BILLING_SELLER_NAME="Sales Desk Private Limited"
BILLING_SELLER_GSTIN=""
BILLING_SELLER_ADDRESS=""
# Two digits; defaults to the GSTIN's first two.
# BILLING_SELLER_STATE="27"
# Printed on a plan invoice for bank transfer.
# BILLING_BANK_DETAILS="Sales Desk Private Limited, A/c 0000000000, IFSC XXXX0000000"
# Checks only, never in production: point the Razorpay driver at a fake.
# RAZORPAY_BASE_URL=""

# ---------------------------------------------------------------------------
# Token links: each developer's OWN Razorpay account, connected through
# Razorpay's partner sign-in (Settings, Token payments). Not our keys above:
# the token settles to the developer and never to Sales Desk.
# Redirect: <CONNECT_BASE_URL or origin>/api/payments/razorpay/callback
# Webhook:  <AUTH_URL>/api/payments/razorpay/webhook
#           (payment_link.paid, payment_link.expired, payment_link.cancelled)
# ---------------------------------------------------------------------------
RAZORPAY_PARTNER_CLIENT_ID=""
RAZORPAY_PARTNER_CLIENT_SECRET=""
RAZORPAY_PARTNER_WEBHOOK_SECRET=""
# "live" only on a production host; anything else connects in test mode.
# RAZORPAY_PARTNER_MODE="test"
# Checks only, never in production.
# RAZORPAY_API_BASE=""
# RAZORPAY_AUTH_BASE=""

# Single sign-on (SAML) and SCIM. Optional: the base our entity ID, ACS and
# SCIM addresses are built on. Defaults to AUTH_URL.
# SSO_BASE_URL=https://app.salesdesk.app

# ---------------------------------------------------------------------------
# Agent on camera: a film's wrong words said again in the presenter's own
# voice (src/lib/respeak.ts). ElevenLabs hears the film word by word, clones
# her voice from it and says the line again; scripts/voicefix.py splits her
# voice from the music and sets the word in. VOICEFIX_PYTHON is a python with
# scripts/voicefix-requirements.txt installed. Without either, films are made
# as before and say the word fix did not run. RESPEAK=off switches it off.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=""
VOICEFIX_PYTHON=""
# RESPEAK=off

# A film's mistakes put right scene by scene (src/lib/scene-fix.ts): Google
# Veo 3.1 makes a scene Seedance refuses (a face it reads as a real person's).
# Without the key a refused scene is left as it was. VEO_MODEL overrides it.
GEMINI_API_KEY=""
# VEO_MODEL="veo-3.1-generate-preview"

# Dev login: a button on /signin per account listed (comma separated) that
# signs in as it, on DEV_LOGIN_ORG when it belongs there, else on the org it
# founded. Ignored on Vercel and in a production build.
DEV_LOGIN_EMAIL=""
DEV_LOGIN_ORG=""
